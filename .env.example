# Web server configuration. This URL is read only by the Next.js server.
LEARNING_API_URL=http://127.0.0.1:8000

# Set to true to render the foundation health screen without a running API.
NEXT_PUBLIC_USE_API_FIXTURES=false

# Hosted web authentication. Public browser configuration only.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Core learning API configuration.
ASEAN_ACADEMY_ENV=development
ASEAN_ACADEMY_API_HOST=127.0.0.1
ASEAN_ACADEMY_API_PORT=8000
ASEAN_ACADEMY_CORS_ORIGINS=http://localhost:3000
ASEAN_ACADEMY_LOG_LEVEL=INFO
ASEAN_ACADEMY_REPOSITORY_ROOT=/absolute/path/to/asean_academy
ASEAN_ACADEMY_ALLOW_DRAFT_CONTENT=true
ASEAN_ACADEMY_PRACTICE_DATABASE=/absolute/path/to/asean_academy/.local/practice.sqlite3
ASEAN_ACADEMY_DEVELOPMENT_LEARNER_ID=development-learner

# Learning API identity verification. Keep all database and service-role secrets server-side.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
