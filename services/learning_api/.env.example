ASEAN_ACADEMY_ENV=development
ASEAN_ACADEMY_API_HOST=127.0.0.1
ASEAN_ACADEMY_API_PORT=8000
ASEAN_ACADEMY_CORS_ORIGINS=http://localhost:3000
ASEAN_ACADEMY_LOG_LEVEL=INFO
# Use json in Railway preview/production so logs are searchable by request_id and status.
ASEAN_ACADEMY_LOG_FORMAT=text
ASEAN_ACADEMY_SLOW_REQUEST_MS=1000
# The production workflow sets this to the Git commit being deployed.
ASEAN_ACADEMY_RELEASE_SHA=local
ASEAN_ACADEMY_REPOSITORY_ROOT=/absolute/path/to/asean_academy
ASEAN_ACADEMY_ALLOW_DRAFT_CONTENT=true

# Shared abuse controls. Use an independent random 32+ character secret per hosted environment.
ASEAN_ACADEMY_RATE_LIMITS_ENABLED=true
ASEAN_ACADEMY_ABUSE_HASH_SECRET=development-only-abuse-hash-secret
ASEAN_ACADEMY_TRUST_PROXY_HEADERS=false
ASEAN_ACADEMY_MAX_REQUEST_BODY_BYTES=65536

# SQLite-only local development. Omit when PostgreSQL is configured.
ASEAN_ACADEMY_PRACTICE_DATABASE=/absolute/path/to/asean_academy/.local/practice.sqlite3
ASEAN_ACADEMY_DEVELOPMENT_LEARNER_ID=development-learner

# Server-only PostgreSQL connection. Required in preview and production.
# When this is set, DEVELOPMENT_LEARNER_ID must be omitted or be an auth.users UUID.
ASEAN_ACADEMY_DATABASE_URL=

# Supabase Auth verification. URL is required in preview and production.
SUPABASE_URL=
SUPABASE_JWT_AUDIENCE=authenticated

# Needed only when the Supabase project still issues legacy HS256 JWTs. Never expose
# this server variable through a NEXT_PUBLIC_ prefix.
SUPABASE_ANON_KEY=
