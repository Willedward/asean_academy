ASEAN_ACADEMY_ENV=development
ASEAN_ACADEMY_API_HOST=127.0.0.1
ASEAN_ACADEMY_API_PORT=8000
ASEAN_ACADEMY_CORS_ORIGINS=http://localhost:3000
ASEAN_ACADEMY_LOG_LEVEL=INFO
# Use json in Railway preview/production so logs are searchable by request_id and status.
ASEAN_ACADEMY_LOG_FORMAT=text
ASEAN_ACADEMY_SLOW_REQUEST_MS=1000
# The production workflow sets this to the Git commit being deployed.
ASEAN_ACADEMY_RELEASE_SHA=local
ASEAN_ACADEMY_REPOSITORY_ROOT=/absolute/path/to/asean_academy
ASEAN_ACADEMY_ALLOW_DRAFT_CONTENT=true

# Shared abuse controls. Use an independent random 32+ character secret per hosted environment.
ASEAN_ACADEMY_RATE_LIMITS_ENABLED=true
ASEAN_ACADEMY_ABUSE_HASH_SECRET=development-only-abuse-hash-secret
ASEAN_ACADEMY_TRUST_PROXY_HEADERS=false
ASEAN_ACADEMY_MAX_REQUEST_BODY_BYTES=65536

# SQLite-only local development. Omit when PostgreSQL is configured.
ASEAN_ACADEMY_PRACTICE_DATABASE=/absolute/path/to/asean_academy/.local/practice.sqlite3
ASEAN_ACADEMY_DEVELOPMENT_LEARNER_ID=development-learner

# Server-only PostgreSQL connection. Required in preview and production.
# When this is set, DEVELOPMENT_LEARNER_ID must be omitted or be an auth.users UUID.
ASEAN_ACADEMY_DATABASE_URL=

# Supabase Auth verification. URL is required in preview and production.
SUPABASE_URL=
SUPABASE_JWT_AUDIENCE=authenticated

# Needed only when the Supabase project still issues legacy HS256 JWTs. Never expose
# this server variable through a NEXT_PUBLIC_ prefix.
SUPABASE_ANON_KEY=

# AI tutor. It remains off unless explicitly enabled. GEMINI_API_KEY is server-only.
# Shadow prices use micro-SGD per 1,000,000 tokens and keep the learner S$7 cap
# meaningful even while a provider grant or free tier makes the cash charge zero.
ASEAN_ACADEMY_TUTOR_ENABLED=false
ASEAN_ACADEMY_TUTOR_PROVIDER=disabled
GEMINI_API_KEY=
ASEAN_ACADEMY_TUTOR_GEMINI_MODEL=gemini-3.8-flash
# Shadow mode records premium recommendations while always executing the economy
# provider. Keep live routing false until the shadow evidence has been reviewed.
ASEAN_ACADEMY_TUTOR_HYBRID_ROUTING_SHADOW_ENABLED=false
ASEAN_ACADEMY_TUTOR_HYBRID_ROUTING_ENABLED=false
ASEAN_ACADEMY_TUTOR_ECONOMY_MAX_OUTPUT_TOKENS=500
ASEAN_ACADEMY_TUTOR_PREMIUM_PROVIDER=openai
ASEAN_ACADEMY_TUTOR_ROUTING_POLICY_VERSION=math-tutor-routing-v1
OPENAI_API_KEY=
ASEAN_ACADEMY_TUTOR_OPENAI_MODEL=gpt-4o-2024-11-20
ASEAN_ACADEMY_TUTOR_PREMIUM_THRESHOLD=5
ASEAN_ACADEMY_TUTOR_MAX_PREMIUM_TURNS_PER_SESSION=3
ASEAN_ACADEMY_TUTOR_PREMIUM_MAX_OUTPUT_TOKENS=700
ASEAN_ACADEMY_TUTOR_PROVIDER_TIMEOUT_SECONDS=20
ASEAN_ACADEMY_TUTOR_PROVIDER_MAX_ATTEMPTS=2
ASEAN_ACADEMY_TUTOR_GEMINI_INPUT_COST_PER_MILLION_MICROS_SGD=0
ASEAN_ACADEMY_TUTOR_GEMINI_OUTPUT_COST_PER_MILLION_MICROS_SGD=0
ASEAN_ACADEMY_TUTOR_OPENAI_INPUT_COST_PER_MILLION_MICROS_SGD=0
ASEAN_ACADEMY_TUTOR_OPENAI_OUTPUT_COST_PER_MILLION_MICROS_SGD=0
ASEAN_ACADEMY_TUTOR_DAILY_MESSAGE_LIMIT=10
ASEAN_ACADEMY_TUTOR_DAILY_TOKEN_LIMIT=20000
ASEAN_ACADEMY_TUTOR_MONTHLY_COST_LIMIT_MICROS_SGD=7000000
ASEAN_ACADEMY_TUTOR_ACADEMY_MONTHLY_COST_LIMIT_MICROS_SGD=7000000000
ASEAN_ACADEMY_TUTOR_MAX_INPUT_TOKENS=5000
ASEAN_ACADEMY_TUTOR_MAX_OUTPUT_TOKENS=1000
ASEAN_ACADEMY_TUTOR_MAX_TURN_COST_MICROS_SGD=250000
