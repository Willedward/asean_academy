{
  "components": {
    "schemas": {
      "CourseLessonMap": {
        "additionalProperties": false,
        "properties": {
          "availability": {
            "enum": [
              "content_pending",
              "available"
            ],
            "title": "Availability",
            "type": "string"
          },
          "content_status": {
            "enum": [
              "draft",
              "reviewed",
              "published",
              "retired"
            ],
            "title": "Content Status",
            "type": "string"
          },
          "estimated_minutes": {
            "title": "Estimated Minutes",
            "type": "integer"
          },
          "href": {
            "title": "Href",
            "type": "string"
          },
          "learning_material_state": {
            "enum": [
              "pending",
              "ready"
            ],
            "title": "Learning Material State",
            "type": "string"
          },
          "objectives": {
            "items": {
              "type": "string"
            },
            "title": "Objectives",
            "type": "array"
          },
          "outcomes": {
            "items": {
              "type": "string"
            },
            "title": "Outcomes",
            "type": "array"
          },
          "position": {
            "title": "Position",
            "type": "integer"
          },
          "progress_state": {
            "default": "not_started",
            "enum": [
              "not_started",
              "in_progress",
              "proficient",
              "mastered"
            ],
            "title": "Progress State",
            "type": "string"
          },
          "required_practice_count": {
            "title": "Required Practice Count",
            "type": "integer"
          },
          "stable_key": {
            "title": "Stable Key",
            "type": "string"
          },
          "summary": {
            "title": "Summary",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "stable_key",
          "position",
          "title",
          "summary",
          "outcomes",
          "estimated_minutes",
          "objectives",
          "required_practice_count",
          "content_status",
          "learning_material_state",
          "availability",
          "href"
        ],
        "title": "CourseLessonMap",
        "type": "object"
      },
      "CourseMapResponse": {
