      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "pattern": "^[a-z0-9_]+$",
            "title": "Code",
            "type": "string"
          },
          "details": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorEnvelope": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorEnvelope",
        "type": "object"
      },
      "HealthDependencies": {
        "additionalProperties": false,
        "properties": {
          "authentication": {
            "const": "planned_stage_4",
            "default": "planned_stage_4",
            "title": "Authentication",
            "type": "string"
          },
          "course_content": {
            "const": "draft_placeholders",
            "default": "draft_placeholders",
            "title": "Course Content",
            "type": "string"
          },
          "tutor": {
            "const": "disabled",
            "default": "disabled",
            "title": "Tutor",
            "type": "string"
          }
        },
        "title": "HealthDependencies",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "properties": {
          "dependencies": {
            "$ref": "#/components/schemas/HealthDependencies"
          },
          "environment": {
            "title": "Environment",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "service": {
            "const": "learning-api",
            "default": "learning-api",
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "default": "ok",
