            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Sections",
            "type": "array"
          },
          "stable_key": {
            "title": "Stable Key",
            "type": "string"
          },
          "summary": {
            "title": "Summary",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
