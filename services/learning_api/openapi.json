          "stable_key",
          "revision",
          "course_key",
          "unit_key",
          "position",
          "title",
          "summary",
          "outcomes",
          "estimated_minutes",
          "objectives",
          "content_status",
          "development_preview",
          "learning_material_state",
          "sections",
          "assets",
          "practice"
        ],
        "title": "LessonResponse",
        "type": "object"
      },
      "PracticeEntry": {
        "additionalProperties": false,
        "properties": {
          "available": {
            "title": "Available",
            "type": "boolean"
          },
          "lesson_key": {
            "title": "Lesson Key",
            "type": "string"
          },
          "mode": {
            "const": "guided_practice",
            "default": "guided_practice",
            "title": "Mode",
            "type": "string"
          },
          "question_count": {
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Question Count",
            "type": "integer"
          },
          "unavailable_reason": {
            "anyOf": [
              {
                "enum": [
                  "content_not_reviewed",
                  "questions_not_published"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unavailable Reason"
          }
        },
        "required": [
          "lesson_key",
          "question_count",
          "available"
        ],
        "title": "PracticeEntry",
        "type": "object"
      }
    }
