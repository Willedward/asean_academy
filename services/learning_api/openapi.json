            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "version",
          "environment",
          "request_id"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "LessonResponse": {
        "additionalProperties": false,
        "properties": {
          "assets": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Assets",
            "type": "array"
