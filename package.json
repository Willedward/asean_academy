{
  "name": "asean-academy",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "corepack pnpm --filter @asean-academy/web build",
    "dev:web": "corepack pnpm --filter @asean-academy/web dev",
    "dev:api": "uv run --project services/learning_api python services/learning_api/scripts/run_dev.py",
    "setup:api": "uv run --project services/learning_api python services/learning_api/scripts/configure_local_env.py",
    "lint": "corepack pnpm --filter @asean-academy/web lint",
    "typecheck": "corepack pnpm --filter @asean-academy/web typecheck",
    "test:web": "corepack pnpm --filter @asean-academy/web test",
    "test:e2e": "corepack pnpm --filter @asean-academy/web test:e2e",
    "test:python": "uv run --project services/learning_api --locked pytest services/learning_api/tests && uv run --project question_bank --locked pytest question_bank/tests",
    "openapi:export": "uv run --project services/learning_api --locked python services/learning_api/scripts/export_openapi.py",
    "fixtures:export": "uv run --project services/learning_api --locked python services/learning_api/scripts/export_frontend_fixtures.py",
    "release:check": "python3 scripts/check_migration_safety.py",
    "release:content": "uv run --project services/learning_api --locked python services/learning_api/scripts/verify_content_release.py",
    "smoke:deployment": "python3 scripts/smoke_deployment.py",
    "smoke:load": "python3 scripts/load_test_api.py",
    "openapi:generate": "corepack pnpm openapi:export && corepack pnpm fixtures:export && corepack pnpm --filter @asean-academy/web openapi:generate",
    "ci:web": "corepack pnpm openapi:generate && corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test:web && corepack pnpm build",
    "bootstrap:api": "uv run --project services/learning_api --locked python services/learning_api/scripts/bootstrap_local.py"
  }
}
