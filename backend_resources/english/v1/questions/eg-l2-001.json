  "feedback_timing": "after_group",
  "status": "draft",
  "passage_ref": null,
  "instructions": "Choose the sentence with correct agreement or clear reference.",
  "parts": [
    {
      "position": 1,
      "prompt": "Which sentence has correct agreement?",
      "response": {
        "type": "single_choice",
        "options": [
          {
            "key": "A",
            "text": "The collection of maps are locked."
          },
          {
            "key": "B",
            "text": "The collection of maps is locked."
          },
          {
            "key": "C",
            "text": "The collection were locked."
          },
          {
            "key": "D",
            "text": "The collection keep locked."
          }
        ],
        "correct_key": "B",
        "choice_rationales": {
          "A": "Maps is not the head.",
          "B": "Collection is singular.",
          "C": "The verb is plural.",
          "D": "The verb form is wrong."
        }
      },
      "hint": "Remove the of-phrase.",
      "correct_explanation": "The singular head collection controls the verb."
    },
    {
      "position": 2,
      "prompt": "Complete: ‘Each of the volunteers ___ a badge.’",
      "response": {
        "type": "single_choice",
        "options": [
          {
            "key": "A",
            "text": "receive"
          },
          {
            "key": "B",
            "text": "receives"
          },
          {
            "key": "C",
            "text": "have receive"
          },
          {
            "key": "D",
            "text": "were receiving always"
          }
        ],
        "correct_key": "B",
        "choice_rationales": {
          "A": "Each is singular.",
          "B": "This agrees with each.",
          "C": "The phrase is ungrammatical.",
          "D": "The tense and order fail."
        }
      },
      "hint": "Agreement follows each.",
      "correct_explanation": "Distributive each takes a singular verb."
    },
    {
      "position": 3,
      "prompt": "Which compound-subject sentence is correct?",
      "response": {
        "type": "single_choice",
        "options": [
          {
            "key": "A",
            "text": "The coach and captain is reviewing."
          },
          {
            "key": "B",
            "text": "The coach and captain are reviewing."
          },
          {
            "key": "C",
            "text": "The coach and captain reviews."
          },
          {
            "key": "D",
            "text": "The coach and captain has review."
          }
        ],
        "correct_key": "B",
        "choice_rationales": {
          "A": "Two people require plural agreement.",
          "B": "Are matches the compound subject.",
          "C": "Reviews is singular.",
          "D": "The phrase is incorrect."
        }
      },
      "hint": "Count the people.",
      "correct_explanation": "Distinct subjects joined by and are plural."
    },
    {
      "position": 4,
      "prompt": "Which sentence has the clearest reference?",
      "response": {
        "type": "single_choice",
        "options": [
          {
            "key": "A",
            "text": "When Sara returned the laptop to Mei, she saw the crack."
          },
          {
            "key": "B",
            "text": "When Sara returned the laptop, Mei noticed its cracked screen."
          },
          {
            "key": "C",
            "text": "Sara returned it to Mei and she saw it."
          },
          {
            "key": "D",
            "text": "She returned her item to her."
          }
        ],
        "correct_key": "B",
        "choice_rationales": {
          "A": "She could be either person.",
          "B": "Both referents are clear.",
          "C": "Both pronouns compete.",
          "D": "Referents are missing."
        }
      },
      "hint": "Name the observer and object.",
      "correct_explanation": "Repeating nouns prevents ambiguity."
    },
    {
      "position": 5,
      "prompt": "The tray, not the bowl, was heated. Which revision is clear?",
      "response": {
        "type": "single_choice",
        "options": [
          {
            "key": "A",
            "text": "Before the metal tray was heated, the glass bowl was placed beside it."
          },
          {
            "key": "B",
            "text": "It was heated after it was beside it."
          },
          {
            "key": "C",
            "text": "The bowl was beside the tray before it happened."
          },
          {
            "key": "D",
            "text": "Before heating, it was beside that."
          }
        ],
        "correct_key": "A",
        "choice_rationales": {
          "A": "Tray is explicitly assigned the action.",
          "B": "Pronouns are ambiguous.",
          "C": "It lacks a clear action.",
          "D": "Neither referent is secure."
        }
      },
      "hint": "Place the noun next to was heated.",
      "correct_explanation": "The revision names the heated object."
    }
  ],
