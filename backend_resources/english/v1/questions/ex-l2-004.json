  "title": "Protect a valid baseline attempt",
  "difficulty": 2,
  "question_type": "exam_strategy",
  "exposure_pool": "exit_ticket",
  "feedback_timing": "after_group",
  "status": "draft",
  "passage_ref": null,
  "instructions": "Choose the action that preserves useful baseline evidence. This is not the protected baseline form.",
  "parts": [
    {
      "position": 1,
      "prompt": "Which condition gives the most useful first-attempt baseline?",
      "response": {
        "type": "single_choice",
        "options": [
          {
            "key": "A",
            "text": "Use translation tools."
          },
          {
            "key": "B",
            "text": "Ask a friend for hints."
          },
          {
            "key": "C",
            "text": "Work without hints, AI, translation or references."
          },
          {
            "key": "D",
            "text": "Preview answers first."
          }
        ],
        "correct_key": "C",
        "choice_rationales": {
          "A": "That inflates independent performance.",
          "B": "Hints change the reasoning.",
          "C": "This standardises independent evidence.",
          "D": "That contaminates the attempt."
        }
      },
      "hint": "Measure unaided performance.",
      "correct_explanation": "Independent conditions make the result interpretable."
    },
    {
      "position": 2,
      "prompt": "The browser disconnects during a saved baseline. What should happen?",
      "response": {
        "type": "single_choice",
        "options": [
          {
            "key": "A",
            "text": "Search while waiting."
          },
          {
            "key": "B",
            "text": "Resume the same saved session and record the interruption."
          },
          {
            "key": "C",
            "text": "Start repeatedly and keep the best."
          },
          {
            "key": "D",
            "text": "Ask someone to finish."
          }
        ],
        "correct_key": "B",
        "choice_rationales": {
          "A": "That adds assistance.",
          "B": "This preserves one traceable attempt.",
          "C": "That destroys first-attempt meaning.",
          "D": "That is not the learner's work."
        }
      },
      "hint": "Preserve one attempt.",
      "correct_explanation": "Documented recovery is safer than replacement."
    },
    {
      "position": 3,
      "prompt": "What may the baseline legitimately support?",
      "response": {
        "type": "single_choice",
        "options": [
          {
            "key": "A",
            "text": "Guaranteed admission prediction."
          },
          {
            "key": "B",
            "text": "A starting profile of sampled strengths and needs."
          },
          {
            "key": "C",
            "text": "A permanent ability label."
          },
          {
            "key": "D",
            "text": "A regional ranking."
          }
        ],
        "correct_key": "B",
        "choice_rationales": {
          "A": "It is not validated for that.",
          "B": "This is its instructional purpose.",
          "C": "Performance changes.",
          "D": "No representative norm exists."
        }
      },
      "hint": "Use it for instruction.",
      "correct_explanation": "The baseline guides what to study next."
    },
    {
      "position": 4,
      "prompt": "Which limitation belongs beside an objective result?",
      "response": {
        "type": "single_choice",
        "options": [
          {
            "key": "A",
            "text": "It does not directly measure a complete composition."
          },
          {
            "key": "B",
            "text": "It measures every English skill."
          },
          {
            "key": "C",
            "text": "It replaces later practice."
          },
          {
            "key": "D",
            "text": "It predicts the essay prompt."
          }
        ],
        "correct_key": "A",
        "choice_rationales": {
          "A": "Extended writing needs direct evidence.",
          "B": "No finite form does.",
          "C": "It informs practice.",
          "D": "It cannot."
        }
      },
      "hint": "Name only what was sampled.",
      "correct_explanation": "Objective items cannot substitute for full writing."
    },
    {
      "position": 5,
      "prompt": "How should later progress be checked?",
      "response": {
        "type": "single_choice",
        "options": [
          {
            "key": "A",
            "text": "Repeat identical items until memorised."
          },
          {
            "key": "B",
            "text": "Use a matched fresh form covering the same outcomes."
          },
          {
            "key": "C",
            "text": "Use an unrelated game."
          },
          {
            "key": "D",
            "text": "Choose only easy items."
          }
        ],
        "correct_key": "B",
        "choice_rationales": {
          "A": "Recall confounds growth.",
          "B": "This tests transfer.",
          "C": "Constructs differ.",
          "D": "Difficulty becomes incomparable."
        }
      },
      "hint": "Preserve blueprint, change items.",
      "correct_explanation": "Parallel evidence supports a fairer comparison."
    }
  ],
