  "title": "Parallel simulation-protocol decisions",
  "difficulty": 3,
  "question_type": "exam_strategy",
  "exposure_pool": "retry_review",
  "feedback_timing": "after_group",
  "status": "draft",
  "parallel_form_of": "ex-l5-004",
  "passage_ref": null,
  "instructions": "Apply the protocol to five new cases.",
  "parts": [
    {
      "position": 1,
      "prompt": "Nadia wants to borrow Section 1 time for her essay. Which rehearsal is safer?",
      "response": {
        "type": "single_choice",
        "options": [
          {
            "key": "A",
            "text": "Stop at 90 minutes and start a fresh 30-minute clock."
          },
          {
            "key": "B",
            "text": "Pool all time."
          },
          {
            "key": "C",
            "text": "Double essay time after hard reading."
          },
          {
            "key": "D",
            "text": "Remove clocks."
          }
        ],
        "correct_key": "A",
        "choice_rationales": {
          "A": "This mirrors separate timing.",
          "B": "Transfer is unsupported.",
          "C": "Difficulty does not change rules.",
          "D": "Pacing is no longer rehearsed."
        }
      },
      "hint": "Use two boundaries.",
      "correct_explanation": "Separate clocks give faithful practice."
    },
    {
      "position": 2,
      "prompt": "Thirty-five minutes remain and both reading passages are unseen. What now?",
      "response": {
        "type": "single_choice",
        "options": [
          {
            "key": "A",
            "text": "Polish early answers indefinitely."
          },
          {
            "key": "B",
            "text": "Move to reading, budget both passages and protect a short check."
          },
          {
            "key": "C",
            "text": "Skip passages."
          },
          {
            "key": "D",
            "text": "Ask for answers."
          }
        ],
        "correct_key": "B",
        "choice_rationales": {
          "A": "Major tasks remain unsampled.",
          "B": "This restores coverage.",
          "C": "The run is incomplete.",
          "D": "That invalidates conditions."
        }
      },
      "hint": "Prioritise unsampled tasks.",
      "correct_explanation": "A full run needs evidence from both passages."
    },
    {
      "position": 3,
      "prompt": "Iqbal spends three minutes on one open-cloze gap. Which stop-rule move is best?",
      "response": {
        "type": "single_choice",
        "options": [
          {
            "key": "A",
            "text": "Enter the best plausible word, flag and continue."
          },
          {
            "key": "B",
            "text": "Wait indefinitely."
          },
          {
            "key": "C",
            "text": "Message a teacher."
          },
          {
            "key": "D",
            "text": "End the simulation."
          }
        ],
        "correct_key": "A",
        "choice_rationales": {
          "A": "This preserves time and a return path.",
          "B": "The rest of the form suffers.",
          "C": "That adds help.",
          "D": "One gap should not end all evidence."
        }
      },
      "hint": "Commit provisionally.",
      "correct_explanation": "A bounded decision protects remaining tasks."
    },
    {
      "position": 4,
      "prompt": "Which session note supports valid interpretation?",
      "response": {
        "type": "single_choice",
        "options": [
          {
            "key": "A",
            "text": "Used AI on three items but called it independent."
          },
          {
            "key": "B",
            "text": "Device restarted at 10:14; saved attempt resumed at 10:19 without materials or discussion."
          },
          {
            "key": "C",
            "text": "Parent corrected the draft."
          },
          {
            "key": "D",
            "text": "Looked up every unknown word."
          }
        ],
        "correct_key": "B",
        "choice_rationales": {
          "A": "The label is false.",
          "B": "This documents disruption and non-assistance.",
          "C": "That changes writing evidence.",
          "D": "That adds support."
        }
      },
      "hint": "Record timing and contamination status.",
      "correct_explanation": "Specific metadata preserves an audit trail."
    },
    {
      "position": 5,
      "prompt": "After weak banked cloze, which follow-up is defensible?",
      "response": {
        "type": "single_choice",
        "options": [
          {
            "key": "A",
            "text": "Memorise the same bank and retake."
          },
          {
            "key": "B",
            "text": "Review error causes, practise fresh passages, then use a matched form."
          },
          {
            "key": "C",
            "text": "Ignore the strand."
          },
          {
            "key": "D",
            "text": "Replace it with group work."
          }
        ],
        "correct_key": "B",
        "choice_rationales": {
          "A": "That measures recall.",
          "B": "This checks transferable improvement.",
          "C": "Actionable evidence is lost.",
          "D": "Conditions differ."
        }
      },
      "hint": "Cause, practice, fresh measure.",
      "correct_explanation": "Targeted remediation should end with unseen comparable evidence."
    }
  ],
