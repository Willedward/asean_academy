  "passage_ref": null,
  "instructions": "Apply the reported profile to five new preparation decisions.",
  "parts": [
    {
      "position": 1,
      "prompt": "Rafi finishes Section 1 early. What is the safest timing assumption?",
      "response": {
        "type": "single_choice",
        "options": [
          {
            "key": "A",
            "text": "Keep separate limits unless official instructions permit transfer."
          },
          {
            "key": "B",
            "text": "Always transfer unused time."
          },
          {
            "key": "C",
            "text": "Ignore all timing."
          },
          {
            "key": "D",
            "text": "Use all time for composition."
          }
        ],
        "correct_key": "A",
        "choice_rationales": {
          "A": "This avoids unsupported flexibility.",
          "B": "Transfer is unconfirmed.",
          "C": "Reported limits remain useful.",
          "D": "That abandons Section 1."
        }
      },
      "hint": "Do not invent transfer.",
      "correct_explanation": "Practise separate section boundaries."
    },
    {
      "position": 2,
      "prompt": "A story has 15 gaps and 20 bank words. What should the learner do?",
      "response": {
        "type": "single_choice",
        "options": [
          {
            "key": "A",
            "text": "Force in all 20."
          },
          {
            "key": "B",
            "text": "Choose 15 by grammar and coherence, leaving five unused."
          },
          {
            "key": "C",
            "text": "Write outside synonyms."
          },
          {
            "key": "D",
            "text": "Treat gaps independently."
          }
        ],
        "correct_key": "B",
        "choice_rationales": {
          "A": "Five are surplus.",
          "B": "This matches the format.",
          "C": "Answers come from the bank.",
          "D": "Whole-story meaning matters."
        }
      },
      "hint": "Use the surplus as an elimination feature.",
      "correct_explanation": "A coherent subset, not every option, completes the passage."
    },
    {
      "position": 3,
      "prompt": "Which activity best prepares open cloze?",
      "response": {
        "type": "single_choice",
        "options": [
          {
            "key": "A",
            "text": "Choose a title."
          },
          {
            "key": "B",
            "text": "Recite a speech."
          },
          {
            "key": "C",
            "text": "Supply one word per gap, then check grammar, collocation and meaning."
          },
          {
            "key": "D",
            "text": "Match pictures."
          }
        ],
        "correct_key": "C",
        "choice_rationales": {
          "A": "That is recognition.",
          "B": "That is a different skill.",
          "C": "This reproduces the demand.",
          "D": "That is unrelated."
        }
      },
      "hint": "Reproduce its response mode.",
      "correct_explanation": "Exact-word generation needs local and global checking."
    },
    {
      "position": 4,
      "prompt": "Which revision set aligns with reported comprehension?",
      "response": {
        "type": "single_choice",
        "options": [
          {
            "key": "A",
            "text": "Two passages with reference, contextual synonyms and evidence-based MCQ."
          },
          {
            "key": "B",
            "text": "Only spelling lists."
          },
          {
            "key": "C",
            "text": "Standalone error correction."
          },
          {
            "key": "D",
            "text": "A debate."
          }
        ],
        "correct_key": "A",
        "choice_rationales": {
          "A": "This matches material and operations.",
          "B": "No passage comprehension.",
          "C": "That is excluded.",
          "D": "The component is written reading."
        }
      },
      "hint": "Match task and thinking.",
      "correct_explanation": "Aligned practice uses passages and evidence."
    },
    {
      "position": 5,
      "prompt": "An unsourced site claims exactly 300 words are compulsory. What should the course do?",
      "response": {
        "type": "single_choice",
        "options": [
          {
            "key": "A",
            "text": "Publish it as official."
          },
          {
            "key": "B",
            "text": "Use about 300 as a target and mark strictness unconfirmed."
          },
          {
            "key": "C",
            "text": "Remove composition."
          },
          {
            "key": "D",
            "text": "Double the number."
          }
        ],
        "correct_key": "B",
        "choice_rationales": {
          "A": "The source is insufficient.",
          "B": "This preserves utility and honesty.",
          "C": "The task itself is supported.",
          "D": "That is baseless."
        }
      },
      "hint": "Keep guidance and its label.",
      "correct_explanation": "Do not promote an unsourced claim to an official rule."
    }
  ],
