  "title": "Parallel agreement and reference transfer",
  "difficulty": 3,
  "question_type": "grammar_usage",
  "exposure_pool": "retry_review",
  "feedback_timing": "after_group",
  "status": "draft",
  "parallel_form_of": "eg-l2-001",
  "passage_ref": null,
  "instructions": "Apply the same checks to five new sentences.",
  "parts": [
    {
      "position": 1,
      "prompt": "A newsletter is checking an announcement. Which version agrees?",
      "response": {
        "type": "single_choice",
        "options": [
          {
            "key": "A",
            "text": "A series of workshops begins next week."
          },
          {
            "key": "B",
            "text": "A series of workshops begin next week."
          },
          {
            "key": "C",
            "text": "A series are beginning yesterday."
          },
          {
            "key": "D",
            "text": "A series have begins."
          }
        ],
        "correct_key": "A",
        "choice_rationales": {
          "A": "Series is singular.",
          "B": "Workshops is not the head.",
          "C": "Agreement and time fail.",
          "D": "The phrase is ungrammatical."
        }
      },
      "hint": "Find the head.",
      "correct_explanation": "Series controls agreement."
    },
    {
      "position": 2,
      "prompt": "Complete: ‘Everyone in the teams ___ responsible.’",
      "response": {
        "type": "single_choice",
        "options": [
          {
            "key": "A",
            "text": "are"
          },
          {
            "key": "B",
            "text": "is"
          },
          {
            "key": "C",
            "text": "were be"
          },
          {
            "key": "D",
            "text": "have being"
          }
        ],
        "correct_key": "B",
        "choice_rationales": {
          "A": "Teams does not control.",
          "B": "Everyone is singular.",
          "C": "This is ungrammatical.",
          "D": "This is ungrammatical."
        }
      },
      "hint": "Replace everyone with each person.",
      "correct_explanation": "Everyone takes singular agreement."
    },
    {
      "position": 3,
      "prompt": "Which sentence correctly names two causes?",
      "response": {
        "type": "single_choice",
        "options": [
          {
            "key": "A",
            "text": "Humidity and poor ventilation causes mould."
          },
          {
            "key": "B",
            "text": "Humidity and poor ventilation cause mould."
          },
          {
            "key": "C",
            "text": "Humidity and poor ventilation is causing."
          },
          {
            "key": "D",
            "text": "Humidity and poor ventilation has cause."
          }
        ],
        "correct_key": "B",
        "choice_rationales": {
          "A": "Causes is singular.",
          "B": "Cause agrees with two factors.",
          "C": "Is is singular.",
          "D": "The phrase is incorrect."
        }
      },
      "hint": "Count the factors.",
      "correct_explanation": "The compound subject is plural."
    },
    {
      "position": 4,
      "prompt": "Daniel sent the message, then called Yusuf. Which revision is clear?",
      "response": {
        "type": "single_choice",
        "options": [
          {
            "key": "A",
            "text": "After Daniel sent the message, he called Yusuf."
          },
          {
            "key": "B",
            "text": "Daniel called Yusuf after he sent it."
          },
          {
            "key": "C",
            "text": "After he sent it, he called him."
          },
          {
            "key": "D",
            "text": "Daniel called him after this."
          }
        ],
        "correct_key": "A",
        "choice_rationales": {
          "A": "Daniel is fixed as sender.",
          "B": "He is ambiguous.",
          "C": "No person is secure.",
          "D": "References are vague."
        }
      },
      "hint": "Name the sender in the sent clause.",
      "correct_explanation": "Explicit naming removes the competing antecedent."
    },
    {
      "position": 5,
      "prompt": "Which rain-damaged notice sentence is clearest?",
      "response": {
        "type": "single_choice",
        "options": [
          {
            "key": "A",
            "text": "The notice was on the gate, but it was hard to read."
          },
          {
            "key": "B",
            "text": "Rain blurred the notice's ink, making the notice hard to read."
          },
          {
            "key": "C",
            "text": "It was on it, so this was hard."
          },
          {
            "key": "D",
            "text": "The notice and gate were there when it blurred."
          }
        ],
        "correct_key": "B",
        "choice_rationales": {
          "A": "It could name notice or gate.",
          "B": "Object and cause are explicit.",
          "C": "References fail.",
          "D": "It is ambiguous."
        }
      },
      "hint": "Repeat a noun when needed.",
      "correct_explanation": "Clarity is more important than avoiding repetition."
    }
  ],
