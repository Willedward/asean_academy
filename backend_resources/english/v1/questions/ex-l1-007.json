  "instructions": "Prompt: Write for your school newsletter about one change you made after learning something in class. Explain the lesson, the action and the result, using a specific example. Answer all six questions.",
  "parts": [
    {
      "position": 1,
      "prompt": "What is the precise topic?",
      "response": {
        "type": "single_choice",
        "options": [
          {
            "key": "A",
            "text": "Every subject studied at school"
          },
          {
            "key": "B",
            "text": "One class lesson that led the writer to change an action"
          },
          {
            "key": "C",
            "text": "A list of community problems"
          },
          {
            "key": "D",
            "text": "Why newsletters are useful"
          }
        ],
        "correct_key": "B",
        "choice_rationales": {
          "A": "This is too broad.",
          "B": "This captures the required link.",
          "C": "No list is requested.",
          "D": "The newsletter is the publication context."
        }
      },
      "hint": "Find the learning–action link.",
      "correct_explanation": "The response centres on one transferred lesson."
    },
    {
      "position": 2,
      "prompt": "What is the main thinking job?",
      "response": {
        "type": "single_choice",
        "options": [
          {
            "key": "A",
            "text": "Invent a dramatic story"
          },
          {
            "key": "B",
            "text": "Argue that all students should agree"
          },
          {
            "key": "C",
            "text": "Explain how learning led to an action and result"
          },
          {
            "key": "D",
            "text": "Describe a classroom without reflection"
          }
        ],
        "correct_key": "C",
        "choice_rationales": {
          "A": "Truthful reflection is required.",
          "B": "No debate is requested.",
          "C": "This states the causal job.",
          "D": "That omits transfer."
        }
      },
      "hint": "Follow the command verb.",
      "correct_explanation": "Explain requires a connected account."
    },
    {
      "position": 3,
      "prompt": "Who is the stated audience?",
      "response": {
        "type": "single_choice",
        "options": [
          {
            "key": "A",
            "text": "Readers of the school newsletter"
          },
          {
            "key": "B",
            "text": "Scholarship judges only"
          },
          {
            "key": "C",
            "text": "Primary-school teachers"
          },
          {
            "key": "D",
            "text": "The writer's family"
          }
        ],
        "correct_key": "A",
        "choice_rationales": {
          "A": "This is explicit.",
          "B": "They are not named.",
          "C": "They are not named.",
          "D": "They are not the publication audience."
        }
      },
      "hint": "Use the publication clue.",
      "correct_explanation": "The newsletter defines the audience."
    },
    {
      "position": 4,
      "prompt": "Which detail is essential?",
      "response": {
        "type": "single_choice",
        "options": [
          {
            "key": "A",
            "text": "The colour of the classroom"
          },
          {
            "key": "B",
            "text": "Every lesson from the term"
          },
          {
            "key": "C",
            "text": "A quotation from a famous person"
          },
          {
            "key": "D",
            "text": "A specific example showing the action and its result"
          }
        ],
        "correct_key": "D",
        "choice_rationales": {
          "A": "This is usually irrelevant.",
          "B": "Only one is required.",
          "C": "No quotation is required.",
          "D": "This supports the explanation."
        }
      },
      "hint": "Find the explicit support requirement.",
      "correct_explanation": "The example must make transfer concrete."
    },
    {
      "position": 5,
      "prompt": "Which plan stays within scope?",
      "response": {
        "type": "single_choice",
        "options": [
          {
            "key": "A",
            "text": "List five subjects and praise the school"
          },
          {
            "key": "B",
            "text": "Describe learning to compare evidence, applying it to a recycling trial, and explaining what changed"
          },
          {
            "key": "C",
            "text": "Explain why newsletters need photographs"
          },
          {
            "key": "D",
            "text": "Invent a national award"
          }
        ],
        "correct_key": "B",
        "choice_rationales": {
          "A": "This avoids the change.",
          "B": "This follows all parts.",
          "C": "This changes topic.",
          "D": "Unsupported evidence is unsafe."
        }
      },
      "hint": "Test topic, command and evidence.",
      "correct_explanation": "The second plan forms a complete task contract."
    },
    {
      "position": 6,
      "prompt": "Which task contract is complete?",
      "response": {
        "type": "single_choice",
        "options": [
          {
            "key": "A",
            "text": "Tell any school memory in 300 words"
          },
          {
            "key": "B",
            "text": "Give advice about learning"
          },
          {
            "key": "C",
            "text": "Write a newsletter piece explaining one class lesson, a resulting change, and its outcome through a specific example"
          },
          {
            "key": "D",
            "text": "Describe a community project only"
          }
        ],
        "correct_key": "C",
        "choice_rationales": {
          "A": "Action, result and audience are missing.",
          "B": "The personal transfer is missing.",
          "C": "Every requirement is retained.",
          "D": "The classroom-learning link is missing."
        }
      },
      "hint": "Retain audience, focus, command and support.",
      "correct_explanation": "The complete contract prevents task drift."
    }
  ],
