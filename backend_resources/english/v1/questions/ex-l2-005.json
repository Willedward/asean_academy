  "title": "Parallel baseline-integrity decisions",
  "difficulty": 2,
  "question_type": "exam_strategy",
  "exposure_pool": "retry_review",
  "feedback_timing": "after_group",
  "status": "draft",
  "parallel_form_of": "ex-l2-004",
  "passage_ref": null,
  "instructions": "Apply baseline-integrity principles to new cases.",
  "parts": [
    {
      "position": 1,
      "prompt": "Maya wants to translate every difficult sentence so her first score looks high. What is better?",
      "response": {
        "type": "single_choice",
        "options": [
          {
            "key": "A",
            "text": "Hide the translation use."
          },
          {
            "key": "B",
            "text": "Complete the attempt unaided so the plan targets real needs."
          },
          {
            "key": "C",
            "text": "Ask an adult to answer."
          },
          {
            "key": "D",
            "text": "Estimate a score."
          }
        ],
        "correct_key": "B",
        "choice_rationales": {
          "A": "Hidden help still invalidates evidence.",
          "B": "Usefulness matters more than appearance.",
          "C": "That measures the adult.",
          "D": "No strand evidence is produced."
        }
      },
      "hint": "Optimise honesty.",
      "correct_explanation": "A genuine starting point enables targeted learning."
    },
    {
      "position": 2,
      "prompt": "A power cut closes a saved attempt. Which action protects the record?",
      "response": {
        "type": "single_choice",
        "options": [
          {
            "key": "A",
            "text": "Resume it, note the outage and avoid item discussion."
          },
          {
            "key": "B",
            "text": "Read explanations first."
          },
          {
            "key": "C",
            "text": "Restart until earlier answers improve."
          },
          {
            "key": "D",
            "text": "Use a friend's score."
          }
        ],
        "correct_key": "A",
        "choice_rationales": {
          "A": "This keeps one uncontaminated trace.",
          "B": "Feedback contaminates later answers.",
          "C": "That becomes practice.",
          "D": "That is irrelevant."
        }
      },
      "hint": "Continue one traceable attempt.",
      "correct_explanation": "Saved-state recovery preserves continuity."
    },
    {
      "position": 3,
      "prompt": "Vocabulary is strong but open cloze is weak. Which conclusion is justified?",
      "response": {
        "type": "single_choice",
        "options": [
          {
            "key": "A",
            "text": "Admission is certain."
          },
          {
            "key": "B",
            "text": "Target exact-word and grammar practice while maintaining vocabulary."
          },
          {
            "key": "C",
            "text": "Cloze can never improve."
          },
          {
            "key": "D",
            "text": "Ignore vocabulary."
          }
        ],
        "correct_key": "B",
        "choice_rationales": {
          "A": "The form cannot establish this.",
          "B": "This is proportionate instruction.",
          "C": "A baseline is not permanent.",
          "D": "Strengths still matter."
        }
      },
      "hint": "Recommend learning, not destiny.",
      "correct_explanation": "Strand evidence should guide the next practice."
    },
    {
      "position": 4,
      "prompt": "Why must an objective baseline not be labelled an essay score?",
      "response": {
        "type": "single_choice",
        "options": [
          {
            "key": "A",
            "text": "Essay performance requires extended-writing evidence."
          },
          {
            "key": "B",
            "text": "Essays contain no language skills."
          },
          {
            "key": "C",
            "text": "Objective tasks are always harder."
          },
          {
            "key": "D",
            "text": "Composition is absent from the paper."
          }
        ],
        "correct_key": "A",
        "choice_rationales": {
          "A": "This construct was not directly sampled.",
          "B": "They contain many.",
          "C": "Difficulty is not the issue.",
          "D": "It is reported."
        }
      },
      "hint": "Score only what tasks sample.",
      "correct_explanation": "Writing needs direct evidence."
    },
    {
      "position": 5,
      "prompt": "Which comparison is least affected by answer memory?",
      "response": {
        "type": "single_choice",
        "options": [
          {
            "key": "A",
            "text": "The identical highlighted form."
          },
          {
            "key": "B",
            "text": "Only previously correct items."
          },
          {
            "key": "C",
            "text": "A secure matched form with fresh prompts."
          },
          {
            "key": "D",
            "text": "A self-rating."
          }
        ],
        "correct_key": "C",
        "choice_rationales": {
          "A": "Recall dominates.",
          "B": "Blueprint changes.",
          "C": "This preserves comparability and tests transfer.",
          "D": "That is different evidence."
        }
      },
      "hint": "Same outcomes, new items.",
      "correct_explanation": "A parallel form reduces recall effects."
    }
  ],
