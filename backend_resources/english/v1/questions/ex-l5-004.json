  "audience_band": "secondary_school",
  "outcome_code": "EW9.5",
  "title": "Protect a full-simulation protocol",
  "difficulty": 3,
  "question_type": "exam_strategy",
  "exposure_pool": "exit_ticket",
  "feedback_timing": "after_group",
  "status": "draft",
  "passage_ref": null,
  "instructions": "Choose decisions that make a future simulation valid. This is not the protected mock.",
  "parts": [
    {
      "position": 1,
      "prompt": "Which schedule best mirrors reported timing?",
      "response": {
        "type": "single_choice",
        "options": [
          {
            "key": "A",
            "text": "One flexible 120-minute session."
          },
          {
            "key": "B",
            "text": "A 90-minute Section 1 then a separate 30-minute Section 2."
          },
          {
            "key": "C",
            "text": "Thirty minutes per part."
          },
          {
            "key": "D",
            "text": "Untimed Section 1."
          }
        ],
        "correct_key": "B",
        "choice_rationales": {
          "A": "Transfer is unconfirmed.",
          "B": "This preserves both boundaries.",
          "C": "That is unsupported.",
          "D": "Section 1 is timed."
        }
      },
      "hint": "Reproduce boundaries.",
      "correct_explanation": "Use separately controlled clocks."
    },
    {
      "position": 2,
      "prompt": "Which Section 1 pacing plan is safest while exact counts are unconfirmed?",
      "response": {
        "type": "single_choice",
        "options": [
          {
            "key": "A",
            "text": "Stay on the first hard word."
          },
          {
            "key": "B",
            "text": "Reserve both readings and a checking buffer; adjust earlier budgets."
          },
          {
            "key": "C",
            "text": "Skip reading."
          },
          {
            "key": "D",
            "text": "Use a rigid invented per-item rule."
          }
        ],
        "correct_key": "B",
        "choice_rationales": {
          "A": "One item can consume the paper.",
          "B": "This protects coverage without invented counts.",
          "C": "The simulation becomes incomplete.",
          "D": "That creates false precision."
        }
      },
      "hint": "Protect whole-task coverage.",
      "correct_explanation": "Reserve high-load reading and checking."
    },
    {
      "position": 3,
      "prompt": "Two vocabulary options still seem possible after one pass. What next?",
      "response": {
        "type": "single_choice",
        "options": [
          {
            "key": "A",
            "text": "Pause for an explanation."
          },
          {
            "key": "B",
            "text": "Choose the best, flag it and move for a possible return."
          },
          {
            "key": "C",
            "text": "Open a dictionary."
          },
          {
            "key": "D",
            "text": "Restart for another item."
          }
        ],
        "correct_key": "B",
        "choice_rationales": {
          "A": "That adds help.",
          "B": "This protects time and evidence.",
          "C": "That changes conditions.",
          "D": "That breaks continuity."
        }
      },
      "hint": "Use a stop rule.",
      "correct_explanation": "Commit–flag–move preserves the whole paper."
    },
    {
      "position": 4,
      "prompt": "Which event is a genuine interruption rather than assistance?",
      "response": {
        "type": "single_choice",
        "options": [
          {
            "key": "A",
            "text": "A parent explains a passage."
          },
          {
            "key": "B",
            "text": "The learner checks synonyms."
          },
          {
            "key": "C",
            "text": "A power failure stops the device; the same saved session resumes without discussion."
          },
          {
            "key": "D",
            "text": "A friend edits the essay."
          }
        ],
        "correct_key": "C",
        "choice_rationales": {
          "A": "That is assistance.",
          "B": "That is external support.",
          "C": "This is technical and traceable.",
          "D": "That alters performance."
        }
      },
      "hint": "Separate loss of access from help.",
      "correct_explanation": "Documented technical recovery may be interpreted cautiously."
    },
    {
      "position": 5,
      "prompt": "What is strongest after submission?",
      "response": {
        "type": "single_choice",
        "options": [
          {
            "key": "A",
            "text": "Repeat identical items immediately."
          },
          {
            "key": "B",
            "text": "Use strand errors for practice, then later use a matched fresh form."
          },
          {
            "key": "C",
            "text": "Keep only the total."
          },
          {
            "key": "D",
            "text": "Predict admission."
          }
        ],
        "correct_key": "B",
        "choice_rationales": {
          "A": "Recall confounds growth.",
          "B": "This joins diagnosis and transfer evidence.",
          "C": "That hides needs.",
          "D": "The score is not validated for that."
        }
      },
      "hint": "Diagnose now, measure transfer later.",
      "correct_explanation": "Fresh matched evidence is stronger than exposed-item repetition."
    }
  ],
