  "instructions": "Use structure, context and elimination for five unfamiliar words.",
  "parts": [
    {
      "position": 1,
      "prompt": "The committee gave tentative approval but wanted more evidence before a final commitment. What does tentative mean?",
      "response": {
        "type": "single_choice",
        "options": [
          {
            "key": "A",
            "text": "cautious and not final"
          },
          {
            "key": "B",
            "text": "enthusiastic and permanent"
          },
          {
            "key": "C",
            "text": "secret and dishonest"
          },
          {
            "key": "D",
            "text": "immediate and compulsory"
          }
        ],
        "correct_key": "A",
        "choice_rationales": {
          "A": "The decision remains provisional.",
          "B": "The opposite is stated.",
          "C": "No concealment appears.",
          "D": "Further review is needed."
        }
      },
      "hint": "Contrast with final.",
      "correct_explanation": "Tentative means provisional and cautious."
    },
    {
      "position": 2,
      "prompt": "After heavy rain, the road deteriorated; holes appeared and journeys slowed. What does deteriorated mean?",
      "response": {
        "type": "single_choice",
        "options": [
          {
            "key": "A",
            "text": "became busier"
          },
          {
            "key": "B",
            "text": "became worse"
          },
          {
            "key": "C",
            "text": "became shorter"
          },
          {
            "key": "D",
            "text": "became private"
          }
        ],
        "correct_key": "B",
        "choice_rationales": {
          "A": "Traffic is not discussed.",
          "B": "Damage shows decline.",
          "C": "Length did not change.",
          "D": "Ownership is irrelevant."
        }
      },
      "hint": "Classify the change.",
      "correct_explanation": "The road's condition became worse."
    },
    {
      "position": 3,
      "prompt": "Jia was meticulous: she verified every total, label and entry. What does meticulous mean?",
      "response": {
        "type": "single_choice",
        "options": [
          {
            "key": "A",
            "text": "very careful and precise"
          },
          {
            "key": "B",
            "text": "easily distracted"
          },
          {
            "key": "C",
            "text": "unwilling to begin"
          },
          {
            "key": "D",
            "text": "surprisingly imaginative"
          }
        ],
        "correct_key": "A",
        "choice_rationales": {
          "A": "The actions show close checking.",
          "B": "She remains focused.",
          "C": "She is working.",
          "D": "Precision, not creativity, is shown."
        }
      },
      "hint": "Find the shared quality.",
      "correct_explanation": "Meticulous means attentive to small details."
    },
    {
      "position": 4,
      "prompt": "Fresh water was scarce, so every home received only two containers. What does scarce mean?",
      "response": {
        "type": "single_choice",
        "options": [
          {
            "key": "A",
            "text": "unsafe to touch"
          },
          {
            "key": "B",
            "text": "limited and insufficient"
          },
          {
            "key": "C",
            "text": "free of charge"
          },
          {
            "key": "D",
            "text": "easy to replace"
          }
        ],
        "correct_key": "B",
        "choice_rationales": {
          "A": "Safety is not stated.",
          "B": "Rationing shows shortage.",
          "C": "Price is absent.",
          "D": "Supply is difficult."
        }
      },
      "hint": "Use the consequence.",
      "correct_explanation": "Scarce means available in insufficient quantity."
    },
    {
      "position": 5,
      "prompt": "The captain denied moving the marker but conceded it after seeing the video. What does conceded mean?",
      "response": {
        "type": "single_choice",
        "options": [
          {
            "key": "A",
            "text": "admitted reluctantly"
          },
          {
            "key": "B",
            "text": "forgot completely"
          },
          {
            "key": "C",
            "text": "celebrated publicly"
          },
          {
            "key": "D",
            "text": "investigated carefully"
          }
        ],
        "correct_key": "A",
        "choice_rationales": {
          "A": "The denial changes to admission.",
          "B": "She acknowledges it.",
          "C": "No celebration occurs.",
          "D": "The video is evidence, not her action."
        }
      },
      "hint": "Track the contrast.",
      "correct_explanation": "To concede is to admit something, often unwillingly."
