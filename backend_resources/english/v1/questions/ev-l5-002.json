  "instructions": "Apply the protocol to five fresh contexts.",
  "parts": [
    {
      "position": 1,
      "prompt": "Attendance was sporadic: Amir came Monday, missed three sessions and returned Friday. What does sporadic mean?",
      "response": {
        "type": "single_choice",
        "options": [
          {
            "key": "A",
            "text": "regular"
          },
          {
            "key": "B",
            "text": "irregular and occasional"
          },
          {
            "key": "C",
            "text": "compulsory"
          },
          {
            "key": "D",
            "text": "early"
          }
        ],
        "correct_key": "B",
        "choice_rationales": {
          "A": "The pattern has gaps.",
          "B": "The visits are scattered.",
          "C": "No rule appears.",
          "D": "Time of arrival is absent."
        }
      },
      "hint": "Turn events into a pattern.",
      "correct_explanation": "Sporadic means irregular."
    },
    {
      "position": 2,
      "prompt": "The smaller design was viable because available time and materials were enough. What does viable mean?",
      "response": {
        "type": "single_choice",
        "options": [
          {
            "key": "A",
            "text": "workable"
          },
          {
            "key": "B",
            "text": "decorative"
          },
          {
            "key": "C",
            "text": "identical"
          },
          {
            "key": "D",
            "text": "temporary"
          }
        ],
        "correct_key": "A",
        "choice_rationales": {
          "A": "The constraints can be met.",
          "B": "Appearance is irrelevant.",
          "C": "It differs from the first.",
          "D": "Duration is not stated."
        }
      },
      "hint": "Use because.",
      "correct_explanation": "Viable means capable of working."
    },
    {
      "position": 3,
      "prompt": "The meeting ended abruptly when an alarm rang and the speaker stopped mid-sentence. What does abruptly mean?",
      "response": {
        "type": "single_choice",
        "options": [
          {
            "key": "A",
            "text": "suddenly"
          },
          {
            "key": "B",
            "text": "successfully"
          },
          {
            "key": "C",
            "text": "quietly"
          },
          {
            "key": "D",
            "text": "formally"
          }
        ],
        "correct_key": "A",
        "choice_rationales": {
          "A": "The ending is immediate.",
          "B": "No success judgement appears.",
          "C": "An alarm is not quiet.",
          "D": "Procedure is irrelevant."
        }
      },
      "hint": "Focus on how it ended.",
      "correct_explanation": "Abruptly means suddenly."
    },
    {
      "position": 4,
      "prompt": "Old machines became obsolete when they could not read the new system. What does obsolete mean?",
      "response": {
        "type": "single_choice",
        "options": [
          {
            "key": "A",
            "text": "rarely cleaned"
          },
          {
            "key": "B",
            "text": "no longer useful or current"
          },
          {
            "key": "C",
            "text": "recently bought"
          },
          {
            "key": "D",
            "text": "hard to carry"
          }
        ],
        "correct_key": "B",
        "choice_rationales": {
          "A": "Maintenance is absent.",
          "B": "The new system displaced them.",
          "C": "They are old.",
          "D": "Weight is irrelevant."
        }
      },
      "hint": "Connect old with new.",
      "correct_explanation": "Obsolete means outdated and unusable."
    },
    {
      "position": 5,
      "prompt": "The seedlings were resilient: after the storm bent them, most stood upright again. What does resilient mean?",
      "response": {
        "type": "single_choice",
        "options": [
          {
            "key": "A",
            "text": "able to recover"
          },
          {
            "key": "B",
            "text": "unable to grow"
          },
          {
            "key": "C",
            "text": "immune to damage"
          },
          {
            "key": "D",
            "text": "likely to spread"
          }
        ],
        "correct_key": "A",
        "choice_rationales": {
          "A": "They return after damage.",
          "B": "They recover.",
          "C": "They were bent.",
          "D": "Spread is absent."
        }
      },
      "hint": "Compare before and after.",
      "correct_explanation": "Resilient things recover from difficulty."
    }
