  "instructions": "Make all five decisions using only the current evidence-backed paper profile.",
  "parts": [
    {
      "position": 1,
      "prompt": "Which timing statement matches the current reported profile?",
      "response": {
        "type": "single_choice",
        "options": [
          {
            "key": "A",
            "text": "One flexible 120-minute clock."
          },
          {
            "key": "B",
            "text": "Section 1 is 90 minutes and Section 2 is a separate 30-minute composition period."
          },
          {
            "key": "C",
            "text": "Every part receives 30 minutes."
          },
          {
            "key": "D",
            "text": "Only composition is timed."
          }
        ],
        "correct_key": "B",
        "choice_rationales": {
          "A": "The sections are separately reported.",
          "B": "This preserves both reported limits.",
          "C": "No equal allocation is reported.",
          "D": "Both sections are timed."
        }
      },
      "hint": "Keep the clocks separate.",
      "correct_explanation": "The current evidence supports separate 90- and 30-minute periods."
    },
    {
      "position": 2,
      "prompt": "What makes the reported banked cloze distinctive?",
      "response": {
        "type": "single_choice",
        "options": [
          {
            "key": "A",
            "text": "Every bank word must be used."
          },
          {
            "key": "B",
            "text": "The learner writes without choices."
          },
          {
            "key": "C",
            "text": "A shared bank contains more words than gaps."
          },
          {
            "key": "D",
            "text": "Every gap has a separate option list."
          }
        ],
        "correct_key": "C",
        "choice_rationales": {
          "A": "Some choices are deliberately unused.",
          "B": "That describes generation.",
          "C": "This is the supported surplus-bank format.",
          "D": "The bank is shared."
        }
      },
      "hint": "Compare choices with gaps.",
      "correct_explanation": "Surplus choices require grammar and whole-text elimination."
    },
    {
      "position": 3,
      "prompt": "How does open cloze differ from banked cloze?",
      "response": {
        "type": "single_choice",
        "options": [
          {
            "key": "A",
            "text": "There is no bank, so the learner generates an exact fitting word."
          },
          {
            "key": "B",
            "text": "It tests copied spelling only."
          },
          {
            "key": "C",
            "text": "Any synonym is accepted."
          },
          {
            "key": "D",
            "text": "It is an interview."
          }
        ],
        "correct_key": "A",
        "choice_rationales": {
          "A": "This is the defining response demand.",
          "B": "Meaning and grammar matter.",
          "C": "The exact context constrains answers.",
          "D": "It is written."
        }
      },
      "hint": "Ask whether the word is recognised or generated.",
      "correct_explanation": "Open cloze requires exact-word generation."
    },
    {
      "position": 4,
      "prompt": "Which description matches the reported reading component?",
      "response": {
        "type": "single_choice",
        "options": [
          {
            "key": "A",
            "text": "One memorised poem."
          },
          {
            "key": "B",
            "text": "Two passages with contextual synonym, reference and multiple-choice tasks."
          },
          {
            "key": "C",
            "text": "A standalone editing passage."
          },
          {
            "key": "D",
            "text": "Internet research."
          }
        ],
        "correct_key": "B",
        "choice_rationales": {
          "A": "This is unsupported.",
          "B": "These are the reported demands.",
          "C": "Editing is excluded from the current profile.",
          "D": "The test is controlled."
        }
      },
      "hint": "Retain only supported tasks.",
      "correct_explanation": "The present profile supports two comprehension passages and these operations."
    },
    {
      "position": 5,
      "prompt": "How should about 300 words be treated for composition practice?",
      "response": {
        "type": "single_choice",
        "options": [
          {
            "key": "A",
            "text": "As a confirmed automatic penalty boundary."
          },
          {
            "key": "B",
            "text": "As irrelevant to planning."
          },
          {
            "key": "C",
            "text": "As provisional guidance until official confirmation."
          },
          {
            "key": "D",
            "text": "As permission to write without limit."
          }
        ],
        "correct_key": "C",
        "choice_rationales": {
          "A": "Strictness is unconfirmed.",
          "B": "It remains useful guidance.",
          "C": "This respects the evidence boundary.",
          "D": "The task is timed."
        }
      },
      "hint": "Separate guidance from regulation.",
      "correct_explanation": "Approximately 300 words is a practice target, not yet a confirmed strict rule."
    }
