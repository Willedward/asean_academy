{
  "$defs": {
    "EnglishProvenance": {
      "additionalProperties": false,
      "properties": {
        "authoring_method": {
          "const": "original_authored",
          "title": "Authoring Method",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Refs",
          "type": "array"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "authored_by": {
          "minLength": 1,
          "title": "Authored By",
          "type": "string"
        },
        "reviewed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed At"
        },
        "reviewed_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed By"
        },
        "review_notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Review Notes"
        }
      },
      "required": [
        "authoring_method",
        "source_refs",
        "created_at",
        "authored_by"
      ],
      "title": "EnglishProvenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "stable_key": {
      "pattern": "^english-passage-[a-z0-9-]+$",
      "title": "Stable Key",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "text_type": {
      "enum": [
        "narrative",
        "informational",
        "argumentative",
        "reflective"
      ],
      "title": "Text Type",
      "type": "string"
    },
    "paragraphs": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Paragraphs",
      "type": "array"
    },
    "attribution": {
      "minLength": 1,
      "title": "Attribution",
      "type": "string"
    },
    "content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "reviewed",
        "published",
        "retired"
      ],
      "title": "Status",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/EnglishProvenance"
    }
  },
  "required": [
    "revision",
    "stable_key",
    "title",
    "text_type",
    "paragraphs",
    "attribution",
    "content_sha256",
    "status",
    "provenance"
  ],
  "title": "EnglishPassage",
  "type": "object"
}
