{
  "$defs": {
    "CurriculumLesson": {
      "additionalProperties": false,
      "properties": {
        "position": {
          "minimum": 1,
          "title": "Position",
          "type": "integer"
        },
        "lesson_code": {
          "pattern": "^E[0-9]+\\.[0-9]+$",
          "title": "Lesson Code",
          "type": "string"
        },
        "stable_key": {
          "pattern": "^e[0-9]+-lesson-[0-9]{2}$",
          "title": "Stable Key",
          "type": "string"
        },
        "title": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "outcome_code": {
          "pattern": "^(EX|EV|EG|EB|EO|ER|EW)[0-9]+\\.[0-9]+$",
          "title": "Outcome Code",
          "type": "string"
        },
        "outcome": {
          "minLength": 1,
          "title": "Outcome",
          "type": "string"
        },
        "route_tags": {
          "items": {
            "enum": [
              "full",
              "core",
              "sprint"
            ],
            "type": "string"
          },
          "title": "Route Tags",
          "type": "array"
        }
      },
      "required": [
        "position",
        "lesson_code",
        "stable_key",
        "title",
        "outcome_code",
        "outcome"
      ],
      "title": "CurriculumLesson",
      "type": "object"
    },
    "CurriculumModule": {
      "additionalProperties": false,
      "properties": {
        "position": {
          "minimum": 0,
          "title": "Position",
          "type": "integer"
        },
        "module_code": {
          "pattern": "^E[0-9]+$",
          "title": "Module Code",
          "type": "string"
        },
        "stage": {
          "enum": [
            "orientation",
            "toolkit",
            "paper_application",
            "composition"
          ],
          "title": "Stage",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "purpose": {
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "lessons": {
          "items": {
            "$ref": "#/$defs/CurriculumLesson"
          },
          "minItems": 1,
          "title": "Lessons",
          "type": "array"
        }
      },
      "required": [
        "position",
        "module_code",
        "stage",
        "title",
        "purpose",
        "lessons"
      ],
      "title": "CurriculumModule",
      "type": "object"
    },
    "ExamPart": {
      "additionalProperties": false,
      "properties": {
        "part_key": {
          "pattern": "^section-[12](?:-part-[1-4])?$",
          "title": "Part Key",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "reported_minutes": {
          "maximum": 180,
          "minimum": 1,
          "title": "Reported Minutes",
          "type": "integer"
        },
        "format": {
          "minLength": 1,
          "title": "Format",
          "type": "string"
        },
        "evidence_status": {
          "enum": [
            "official",
            "candidate_reported",
            "inferred"
          ],
          "title": "Evidence Status",
          "type": "string"
        },
        "configurable_fields": {
          "items": {
            "type": "string"
          },
          "title": "Configurable Fields",
          "type": "array"
        }
      },
      "required": [
        "part_key",
        "title",
        "reported_minutes",
        "format",
        "evidence_status",
        "configurable_fields"
      ],
      "title": "ExamPart",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "version_key": {
      "const": "asean_scholarship_english_v1_draft",
      "title": "Version Key",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "audience": {
      "minLength": 1,
      "title": "Audience",
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "reviewed",
        "published",
        "retired"
      ],
      "title": "Status",
      "type": "string"
    },
    "evidence_boundary": {
      "minLength": 1,
      "title": "Evidence Boundary",
      "type": "string"
    },
    "source_refs": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Source Refs",
      "type": "array"
    },
    "exam_profile_key": {
      "pattern": "^asean-english-[a-z0-9-]+-v[0-9]+$",
      "title": "Exam Profile Key",
      "type": "string"
    },
    "exam_blueprint": {
      "items": {
        "$ref": "#/$defs/ExamPart"
      },
      "minItems": 1,
      "title": "Exam Blueprint",
      "type": "array"
    },
    "modules": {
      "items": {
        "$ref": "#/$defs/CurriculumModule"
      },
      "minItems": 1,
      "title": "Modules",
      "type": "array"
    }
  },
  "required": [
    "version_key",
    "title",
    "audience",
    "status",
    "evidence_boundary",
    "source_refs",
    "exam_profile_key",
    "exam_blueprint",
    "modules"
  ],
  "title": "EnglishCurriculumCatalogue",
  "type": "object"
}
