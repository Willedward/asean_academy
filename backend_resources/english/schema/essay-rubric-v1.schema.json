{
  "$defs": {
    "EnglishProvenance": {
      "additionalProperties": false,
      "properties": {
        "authoring_method": {
          "const": "original_authored",
          "title": "Authoring Method",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Refs",
          "type": "array"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "authored_by": {
          "minLength": 1,
          "title": "Authored By",
          "type": "string"
        },
        "reviewed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed At"
        },
        "reviewed_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed By"
        },
        "review_notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Review Notes"
        }
      },
      "required": [
        "authoring_method",
        "source_refs",
        "created_at",
        "authored_by"
      ],
      "title": "EnglishProvenance",
      "type": "object"
    },
    "EssayPerformanceBand": {
      "additionalProperties": false,
      "properties": {
        "level": {
          "maximum": 5,
          "minimum": 1,
          "title": "Level",
          "type": "integer"
        },
        "label": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "descriptor": {
          "minLength": 1,
          "title": "Descriptor",
          "type": "string"
        }
      },
      "required": [
        "level",
        "label",
        "descriptor"
      ],
      "title": "EssayPerformanceBand",
      "type": "object"
    },
    "EssayRubricCriterion": {
      "additionalProperties": false,
      "properties": {
        "criterion_key": {
          "pattern": "^[a-z][a-z0-9_]+$",
          "title": "Criterion Key",
          "type": "string"
        },
        "title": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "weight_percent": {
          "maximum": 60,
          "minimum": 5,
          "title": "Weight Percent",
          "type": "integer"
        },
        "bands": {
          "items": {
            "$ref": "#/$defs/EssayPerformanceBand"
          },
          "maxItems": 5,
          "minItems": 5,
          "title": "Bands",
          "type": "array"
        }
      },
      "required": [
        "criterion_key",
        "title",
        "description",
        "weight_percent",
        "bands"
      ],
      "title": "EssayRubricCriterion",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "stable_key": {
      "pattern": "^english-essay-rubric-[a-z0-9-]+$",
      "title": "Stable Key",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "exam_profile_key": {
      "pattern": "^asean-english-[a-z0-9-]+-v[0-9]+$",
      "title": "Exam Profile Key",
      "type": "string"
    },
    "title": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "purpose": {
      "minLength": 1,
      "title": "Purpose",
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "reviewed",
        "published",
        "retired"
      ],
      "title": "Status",
      "type": "string"
    },
    "official_score_claim": {
      "const": false,
      "default": false,
      "title": "Official Score Claim",
      "type": "boolean"
    },
    "scale_min": {
      "const": 1,
      "default": 1,
      "title": "Scale Min",
      "type": "integer"
    },
    "scale_max": {
      "const": 5,
      "default": 5,
      "title": "Scale Max",
      "type": "integer"
    },
    "criteria": {
      "items": {
        "$ref": "#/$defs/EssayRubricCriterion"
      },
      "maxItems": 6,
      "minItems": 3,
      "title": "Criteria",
      "type": "array"
    },
    "learner_disclaimer": {
      "minLength": 1,
      "title": "Learner Disclaimer",
      "type": "string"
    },
    "content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/EnglishProvenance"
    }
  },
  "required": [
    "stable_key",
    "revision",
    "exam_profile_key",
    "title",
    "purpose",
    "status",
    "criteria",
    "learner_disclaimer",
    "content_sha256",
    "provenance"
  ],
  "title": "EnglishEssayRubric",
  "type": "object"
}
