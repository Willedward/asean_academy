{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asean.academy/schemas/math-question-v1.schema.json",
  "title": "ASEAN Academy mathematics question source",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "revision", "stable_key", "bank_key", "curriculum_version", "school_level", "topic_code", "primary_outcome", "title", "difficulty", "calculator_allowed", "question_type", "status", "stem", "parts", "total_marks", "assets", "provenance"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "revision": {"type": "integer", "minimum": 1},
    "stable_key": {"type": "string", "pattern": "^n1-l[1-3]-[0-9]{2}$"},
    "bank_key": {"const": "g3-sec1-n1-v1"},
    "curriculum_version": {"const": "g3_math_v1_draft"},
    "school_level": {"const": "secondary_1"},
    "topic_code": {"const": "N1"},
    "primary_outcome": {"enum": ["1.1", "1.2", "1.3", "1.4", "1.5", "1.6", "1.7"]},
    "title": {"type": "string", "minLength": 1, "maxLength": 160},
    "difficulty": {"type": "integer", "minimum": 1, "maximum": 3},
    "calculator_allowed": {"const": true},
    "question_type": {"const": "structured"},
    "status": {"enum": ["draft", "reviewed", "published", "retired"]},
    "stem": {"$ref": "#/$defs/contentBlocks"},
    "parts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/part"}},
    "total_marks": {"type": "integer", "minimum": 1, "maximum": 30},
    "assets": {"type": "array", "items": {"$ref": "#/$defs/asset"}},
    "provenance": {"$ref": "#/$defs/provenance"}
  },
  "$defs": {
    "contentBlocks": {"type": "array", "items": {"$ref": "#/$defs/contentBlock"}},
    "nonEmptyContentBlocks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/contentBlock"}},
    "contentBlock": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["type", "text"], "properties": {"type": {"const": "text"}, "text": {"type": "string", "minLength": 1}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "latex"], "properties": {"type": {"enum": ["inline_math", "display_math"]}, "latex": {"type": "string", "minLength": 1}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "asset_key"], "properties": {"type": {"const": "asset_ref"}, "asset_key": {"type": "string", "minLength": 1}}}
      ]
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "label", "prompt", "marks", "primary_outcome", "secondary_outcomes", "response", "hints", "solution"],
      "properties": {
        "position": {"type": "integer", "minimum": 1},
        "label": {"type": ["string", "null"], "pattern": "^[a-z](?:\\([ivx]+\\))?$"},
        "prompt": {"$ref": "#/$defs/nonEmptyContentBlocks"},
        "marks": {"type": "integer", "minimum": 1, "maximum": 15},
        "primary_outcome": {"enum": ["1.1", "1.2", "1.3", "1.4", "1.5", "1.6", "1.7"]},
        "secondary_outcomes": {"type": "array", "uniqueItems": true, "items": {"enum": ["1.1", "1.2", "1.3", "1.4", "1.5", "1.6", "1.7"]}},
        "response": {"oneOf": [{"$ref": "#/$defs/numericResponse"}, {"$ref": "#/$defs/algebraicResponse"}]},
        "hints": {"type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{"$ref": "#/$defs/hintOne"}, {"$ref": "#/$defs/hintTwo"}], "items": false},
        "solution": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/solutionStep"}}
      }
    },
    "numericResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "comparison_mode", "canonical_answer", "canonical_latex", "accepted_answers"],
      "properties": {
        "type": {"const": "numeric"},
        "comparison_mode": {"enum": ["exact_numeric", "absolute_tolerance", "rounded_dp", "rounded_sf"]},
        "canonical_answer": {"type": "string", "minLength": 1},
        "canonical_latex": {"type": "string", "minLength": 1},
        "accepted_answers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "absolute_tolerance": {"type": "string", "pattern": "^(0|[0-9]+(?:\\.[0-9]+)?)$"},
        "rounding_precision": {"type": "integer", "minimum": 0, "maximum": 15},
        "unit": {"$ref": "#/$defs/unitSpec"}
      },
      "allOf": [
        {"if": {"properties": {"comparison_mode": {"const": "absolute_tolerance"}}}, "then": {"required": ["absolute_tolerance"]}},
        {"if": {"properties": {"comparison_mode": {"enum": ["rounded_dp", "rounded_sf"]}}}, "then": {"required": ["rounding_precision"]}}
      ]
    },
    "algebraicResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "comparison_mode", "canonical_expression", "canonical_latex", "variables", "domain_constraints", "accepted_equivalents", "checker_config"],
      "properties": {
        "type": {"const": "algebraic_expression"},
        "comparison_mode": {"enum": ["symbolic_equivalence", "prime_factorisation", "ordered_numeric_list", "exact_relation"]},
        "canonical_expression": {"type": "string", "minLength": 1},
        "canonical_latex": {"type": "string", "minLength": 1},
        "variables": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"}},
        "domain_constraints": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "accepted_equivalents": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "checker_config": {"type": "object"}
      }
    },
    "unitSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical", "accepted", "required"],
      "properties": {
        "canonical": {"type": "string", "minLength": 1},
        "accepted": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "required": {"type": "boolean"}
      }
    },
    "hintOne": {"type": "object", "additionalProperties": false, "required": ["stage", "content"], "properties": {"stage": {"const": 1}, "content": {"$ref": "#/$defs/nonEmptyContentBlocks"}}},
    "hintTwo": {"type": "object", "additionalProperties": false, "required": ["stage", "content"], "properties": {"stage": {"const": 2}, "content": {"$ref": "#/$defs/nonEmptyContentBlocks"}}},
    "solutionStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "content", "mark_type", "mark_value"],
      "properties": {
        "position": {"type": "integer", "minimum": 1},
        "content": {"$ref": "#/$defs/nonEmptyContentBlocks"},
        "mark_type": {"type": ["string", "null"], "enum": ["B", "M", "A", null]},
        "mark_value": {"type": "integer", "minimum": 0, "maximum": 5}
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_key", "kind", "format", "path", "alt_text", "generation_spec", "sha256"],
      "properties": {
        "asset_key": {"type": "string", "minLength": 1},
        "kind": {"enum": ["number_line", "geometry", "chart", "table", "image"]},
        "format": {"enum": ["svg", "png", "webp"]},
        "path": {"type": "string", "minLength": 1},
        "alt_text": {"type": "string", "minLength": 1},
        "generation_spec": {"type": "object"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authoring_method", "style_references", "created_at", "authored_by"],
      "properties": {
        "authoring_method": {"const": "original_generated"},
        "style_references": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "created_at": {"type": "string", "format": "date-time"},
        "authored_by": {"type": "string", "minLength": 1},
        "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
        "reviewed_by": {"type": ["string", "null"]},
        "review_notes": {"type": ["string", "null"]}
      }
    }
  }
}
