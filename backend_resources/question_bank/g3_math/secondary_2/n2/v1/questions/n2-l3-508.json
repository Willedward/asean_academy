          "type": "text",
          "text": "A task is planned for 5 equally productive workers to finish in 9 days. After all 5 work for 3 days, the remaining work is shared by 11 workers. How many more days are needed? Enter the exact numerical value only."
        }
      ],
      "marks": 3,
      "primary_outcome": "2.5",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "30/11",
        "canonical_latex": "\\frac{30}{11}",
        "accepted_answers": [],
