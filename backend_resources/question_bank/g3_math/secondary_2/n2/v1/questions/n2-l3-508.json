        "rounding_precision": null,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Subtract the worker-days already completed from the total worker-days."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "The remaining work is 5 × (9 − 3) worker-days; divide by 11."
            }
          ]
