      "prompt": [
        {
          "type": "text",
          "text": "In a garden-shed roof truss, the rafter makes angle θ with the horizontal tie beam. The right-angled truss has an opposite side of 40 cm and an adjacent side of 42 cm relative to angle θ. Find θ correct to 1 decimal place."
        }
      ],
      "marks": 3,
      "primary_outcome": "4.3",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "rounded_dp",
        "canonical_answer": "43.6",
        "canonical_latex": "43.6^\\circ",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": 1,
        "unit": {
          "canonical": "°",
          "accepted": [
            "°",
            "degrees"
          ],
          "required": false
        }
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Both named sides are relative to "
            },
            {
              "type": "inline_math",
              "latex": "\\theta"
            },
            {
              "type": "text",
              "text": ", so use the tangent ratio."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Write "
            },
            {
              "type": "inline_math",
              "latex": "\\tan\\theta"
            },
            {
              "type": "text",
              "text": " as a fraction using the two given sides, then use the inverse tangent in degree mode."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "Relative to θ, the opposite and adjacent sides are given, so use the tangent ratio."
            },
            {
              "type": "display_math",
              "latex": "\\tan\\theta=\\frac{40}{42}"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 2,
          "content": [
            {
              "type": "display_math",
              "latex": "\\theta=\\tan^{-1}\\left(\\frac{40}{42}\\right)=43.603\\ldots^\\circ"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 3,
          "content": [
            {
              "type": "display_math",
              "latex": "\\theta=43.6^\\circ"
            }
          ],
          "mark_type": "A",
          "mark_value": 1
        }
      ]
    }
