        {
          "type": "text",
          "text": "Field researchers noted high winds during seasonal storms while preparing a replacement frame. A triangular boundary around the coastal evacuation sign has perimeter 84 m. Two sides measure 21 m and 28 m. Find the third side x, then verify that the triangle is right-angled. Enter x only."
        }
      ],
      "marks": 5,
      "primary_outcome": "4.2",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "35",
        "canonical_latex": "35",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": null,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Use the perimeter to determine the missing side before testing the converse of Pythagoras' theorem."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Add the three sides and set the total equal to the perimeter to find "
            },
            {
              "type": "inline_math",
              "latex": "x"
            },
            {
              "type": "text",
              "text": ". Then check whether the squares of the two shorter sides add up to the square of the longest side."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "Select and apply the right-triangle relationship."
            },
            {
              "type": "display_math",
              "latex": "x=84-21-28=35,\\quad 21^2+28^2=35^2"
            }
          ],
          "mark_type": "M",
          "mark_value": 4
        },
