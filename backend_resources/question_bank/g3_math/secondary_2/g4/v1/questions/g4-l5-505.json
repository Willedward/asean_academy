        {
          "type": "text",
          "text": "Site coordinators noted a protected habitat boundary while preparing a replacement frame. Two observation points on level ground at the recycling-centre conveyor are 20 m apart and lie on the same line with a vertical mast. The angles of elevation to its top are 35° at the farther point and 50° at the nearer point. Find the mast height correct to 1 decimal place."
        }
      ],
      "marks": 5,
      "primary_outcome": "4.3",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "rounded_dp",
        "canonical_answer": "34.0",
        "canonical_latex": "34.0",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": 1,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Let the nearer horizontal distance be x; the farther distance is x + 20."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Write h = x tan 50° and h = (x + 20) tan 35°, then eliminate x."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "Select and apply the right-triangle relationship."
            },
            {
              "type": "display_math",
              "latex": "\\frac{h}{\\tan35^\\circ}-\\frac{h}{\\tan50^\\circ}=20\\Rightarrow h=34.0"
            }
          ],
