        {
          "type": "text",
          "text": "A wind-measuring station uses a guy wire stretched from the top of a 20 m vertical post to an anchor 48 m from its base. Another 2 m is required for fastening. Work out the total length of wire, in metres. Enter the numerical value only."
        }
      ],
      "marks": 4,
      "primary_outcome": "4.1",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "54",
        "canonical_latex": "54",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": null,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "First find the sloping part as the hypotenuse; the fastening allowance is separate."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Let "
            },
            {
              "type": "inline_math",
              "latex": "c"
            },
            {
              "type": "text",
              "text": " be the sloping length, so "
            },
            {
              "type": "inline_math",
              "latex": "c^{2}=20^{2}+48^{2}"
            },
            {
              "type": "text",
              "text": ". Find "
            },
            {
              "type": "inline_math",
              "latex": "c"
            },
            {
              "type": "text",
              "text": " first, then think about what the fastening allowance adds to it."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "The post is vertical and the ground is level, so the sloping cable c is the hypotenuse of a right-angled triangle."
            },
            {
              "type": "display_math",
              "latex": "c^2=20^2+48^2=400+2304=2704"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 2,
          "content": [
            {
              "type": "display_math",
              "latex": "c=\\sqrt{2704}=52\\text{ m}"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 3,
          "content": [
            {
              "type": "text",
              "text": "Add the fastening allowance."
            },
            {
              "type": "display_math",
              "latex": "52+2"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 4,
          "content": [
            {
              "type": "display_math",
              "latex": "\\text{total length}=54\\text{ m}"
            }
          ],
          "mark_type": "A",
          "mark_value": 1
        }
      ]
    }
