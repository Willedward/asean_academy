      "prompt": [
        {
          "type": "text",
          "text": "A straight cable runs from a bridge tower down to the level deck. In the right-angled triangle formed, the hypotenuse is 73 m and one shorter side is 48 m. Find the other shorter side b, the distance from the foot of the tower to the anchor, in metres. Enter the numerical value only."
        }
      ],
      "marks": 2,
      "primary_outcome": "4.1",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "55",
        "canonical_latex": "55",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": null,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "The unknown is a shorter side, so subtract its known partner’s square from the hypotenuse square."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Compute "
            },
            {
              "type": "inline_math",
              "latex": "\\sqrt{73^{2}-48^{2}}"
            },
            {
              "type": "text",
              "text": "."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "The 73 m side is the hypotenuse, so by Pythagoras’ theorem"
            },
            {
              "type": "display_math",
              "latex": "b^2=73^2-48^2=5329-2304=3025"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 2,
          "content": [
            {
              "type": "display_math",
              "latex": "b=\\sqrt{3025}=55"
            }
          ],
          "mark_type": "A",
          "mark_value": 1
        }
      ]
    }
