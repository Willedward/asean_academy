      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "The hypotenuse is opposite the right angle, so by Pythagoras’ theorem"
            },
            {
              "type": "display_math",
              "latex": "c^2=88^2+105^2=18769,\\quad c=\\sqrt{18769}=137"
            }
          ],
          "mark_type": "A",
          "mark_value": 1
        }
      ]
    }
