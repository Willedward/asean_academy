            {
              "type": "text",
              "text": "Identify the two perpendicular sides before using Pythagoras’ theorem."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Evaluate the square root of "
            },
            {
              "type": "inline_math",
              "latex": "88^{2}+105^{2}"
            },
