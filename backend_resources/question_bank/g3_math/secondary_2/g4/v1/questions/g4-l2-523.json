      "prompt": [
        {
          "type": "text",
          "text": "During a concert set-up, a light meter on the floor is aimed at the top of a stage scaffold. The sight line makes an angle of 20° with level ground. The horizontal distance is 22 m. Find the vertical height x of the scaffold in metres, correct to 1 decimal place."
        }
      ],
      "marks": 2,
      "primary_outcome": "4.3",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "rounded_dp",
        "canonical_answer": "8.0",
        "canonical_latex": "8.0",
        "accepted_answers": [
          "8"
        ],
        "absolute_tolerance": null,
        "rounding_precision": 1,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Relative to the given angle, identify the vertical side as opposite and the horizontal side as adjacent."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Use "
            },
            {
              "type": "inline_math",
              "latex": "\\tan 20^{\\circ}=\\frac{x}{22}"
            },
            {
              "type": "text",
              "text": " and round only the final answer."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "Relative to the 20° angle, x is opposite and the 22 m distance is adjacent, so use the tangent ratio."
            },
            {
              "type": "display_math",
              "latex": "\\tan 20^\\circ=\\frac{x}{22}"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 2,
          "content": [
            {
              "type": "display_math",
              "latex": "x=22\\tan 20^\\circ=8.007\\ldots=8.0"
            }
          ],
          "mark_type": "A",
          "mark_value": 1
        }
      ]
    }
  ],
