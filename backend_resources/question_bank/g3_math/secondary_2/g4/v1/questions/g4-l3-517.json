      "prompt": [
        {
          "type": "text",
          "text": "A long rectangular strip of farmland measures 15 m by 112 m. A cable runs straight from one corner to the opposite corner to an irrigation pump. Find the length d of the cable in metres. Enter the numerical value only."
        }
      ],
      "marks": 3,
      "primary_outcome": "4.1",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "113",
        "canonical_latex": "113",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": null,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "The rectangle’s diagonal is the hypotenuse of a right triangle."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Use "
            },
            {
              "type": "inline_math",
              "latex": "d^{2}=15^{2}+112^{2}"
            },
            {
              "type": "text",
              "text": "."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "Two adjacent sides of the rectangle meet at a right angle, so the diagonal is the hypotenuse of a right-angled triangle with shorter sides 15 m and 112 m."
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 2,
          "content": [
            {
              "type": "text",
              "text": "By Pythagoras’ theorem,"
            },
            {
              "type": "display_math",
              "latex": "d^2=15^2+112^2=225+12544=12769"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 3,
          "content": [
            {
              "type": "display_math",
              "latex": "d=\\sqrt{12769}=113"
            }
          ],
          "mark_type": "A",
          "mark_value": 1
        }
      ]
    }
  ],
