      "prompt": [
        {
          "type": "text",
          "text": "A support cable runs from the top of a zip-line platform to the ground, meeting it at an acute 45° angle. For this angle, the opposite side is 10 m. Find the adjacent side x, the distance from the foot of the platform to the cable anchor, in metres. Enter the numerical value only."
        }
      ],
      "marks": 1,
      "primary_outcome": "4.3",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "10",
        "canonical_latex": "10",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": null,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Tangent compares the opposite and adjacent sides."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Write "
            },
            {
              "type": "inline_math",
              "latex": "\\tan 45^{\\circ}"
            },
            {
              "type": "text",
              "text": " as a fraction using the opposite and adjacent sides."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "Relative to the 45° angle, the given side is opposite and x is adjacent, so"
            },
            {
              "type": "display_math",
              "latex": "\\tan45^\\circ=\\frac{10}{x}=1\\Rightarrow x=10"
            }
          ],
          "mark_type": "A",
          "mark_value": 1
        }
      ]
    }
  ],
