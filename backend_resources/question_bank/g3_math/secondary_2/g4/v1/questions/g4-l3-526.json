          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "The rectangle’s diagonal is the hypotenuse of a right triangle."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Use d² = 24² + 32²."
            }
          ]
        }
      ],
      "solution": [
