      "prompt": [
        {
          "type": "text",
          "text": "A rectangular playing field measures 33 m by 56 m. A cable runs straight from one corner to the opposite corner to carry power to a scoreboard. Find the length d of the cable in metres. Enter the numerical value only."
        }
      ],
      "marks": 3,
      "primary_outcome": "4.1",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "65",
        "canonical_latex": "65",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": null,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "The rectangle’s diagonal is the hypotenuse of a right triangle."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Use "
            },
            {
              "type": "inline_math",
              "latex": "d^{2}=33^{2}+56^{2}"
            },
            {
              "type": "text",
              "text": "."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "Two adjacent sides of the rectangle meet at a right angle, so the diagonal is the hypotenuse of a right-angled triangle with shorter sides 33 m and 56 m."
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 2,
          "content": [
            {
              "type": "text",
              "text": "By Pythagoras’ theorem,"
            },
            {
              "type": "display_math",
              "latex": "d^2=33^2+56^2=1089+3136=4225"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 3,
          "content": [
            {
              "type": "display_math",
              "latex": "d=\\sqrt{4225}=65"
            }
          ],
          "mark_type": "A",
          "mark_value": 1
        }
      ]
    }
  ],
