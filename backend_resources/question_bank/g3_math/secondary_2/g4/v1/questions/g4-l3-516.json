      "prompt": [
        {
          "type": "text",
          "text": "A flat rectangular roof measures 20 m by 21 m. A cable runs straight from one corner to the opposite corner as part of a lightning-protection system. Find the length d of the cable in metres. Enter the numerical value only."
        }
      ],
      "marks": 3,
      "primary_outcome": "4.1",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "29",
        "canonical_latex": "29",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": null,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "The rectangle’s diagonal is the hypotenuse of a right triangle."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Use "
            },
            {
              "type": "inline_math",
              "latex": "d^{2}=20^{2}+21^{2}"
            },
            {
              "type": "text",
              "text": "."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "Two adjacent sides of the rectangle meet at a right angle, so the diagonal is the hypotenuse of a right-angled triangle with shorter sides 20 m and 21 m."
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 2,
          "content": [
            {
              "type": "text",
              "text": "By Pythagoras’ theorem,"
            },
            {
              "type": "display_math",
              "latex": "d^2=20^2+21^2=400+441=841"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 3,
          "content": [
            {
              "type": "display_math",
              "latex": "d=\\sqrt{841}=29"
            }
          ],
          "mark_type": "A",
          "mark_value": 1
        }
      ]
    }
  ],
