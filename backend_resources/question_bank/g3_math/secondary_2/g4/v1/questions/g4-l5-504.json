        "rounding_precision": null,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Split the route into the rectangular diagonal and the corridor segment."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Find the diagonal of the floor first, using the two sides of the rectangle, then add the straight part of the route."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "The diagonal d is the hypotenuse of a right-angled triangle with shorter sides 24 m and 70 m."
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 2,
          "content": [
            {
              "type": "display_math",
              "latex": "d^2=24^2+70^2=576+4900=5476"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 3,
          "content": [
            {
              "type": "display_math",
              "latex": "d=\\sqrt{5476}=74\\text{ m}"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 4,
          "content": [
            {
              "type": "text",
              "text": "Add the straight part of the route."
            },
            {
              "type": "display_math",
              "latex": "74+30"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 5,
          "content": [
            {
              "type": "display_math",
              "latex": "\\text{route length}=104\\text{ m}"
            }
          ],
          "mark_type": "A",
          "mark_value": 1
        }
      ]
    }
