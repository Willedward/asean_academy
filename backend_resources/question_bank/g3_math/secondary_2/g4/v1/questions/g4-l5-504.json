          "type": "text",
          "text": "A delivery robot in a warehouse crosses a rectangular floor 24 m by 70 m diagonally, then continues 30 m along a straight corridor to the loading bay. Find the length of the complete route in metres. Enter the numerical value only."
        }
      ],
      "marks": 5,
      "primary_outcome": "4.1",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "104",
        "canonical_latex": "104",
        "accepted_answers": [],
