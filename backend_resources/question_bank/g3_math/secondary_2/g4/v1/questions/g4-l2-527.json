      "prompt": [
        {
          "type": "text",
          "text": "A triangular viewing window is planned for a wetland bird hide. It has side lengths 35 cm, 84 cm and 90 cm. Enter 1 if it is right-angled and 0 if it is not."
        }
      ],
      "marks": 2,
      "primary_outcome": "4.2",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "0",
