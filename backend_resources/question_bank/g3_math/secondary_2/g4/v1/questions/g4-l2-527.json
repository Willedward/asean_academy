        "rounding_precision": null,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Treat the longest side as the possible hypotenuse."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Compare "
            },
            {
              "type": "inline_math",
              "latex": "35^{2}+84^{2}"
            },
            {
              "type": "text",
              "text": " with "
            },
            {
              "type": "inline_math",
              "latex": "90^{2}"
            },
            {
              "type": "text",
              "text": "."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "Square the two shorter sides and the longest side."
            },
            {
              "type": "display_math",
              "latex": "35^2+84^2=8281,\\quad 90^2=8100"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 2,
          "content": [
            {
              "type": "text",
              "text": "8281 is not equal to 8100, so by the converse of Pythagoras’ theorem the triangle is not right-angled."
            },
            {
              "type": "display_math",
              "latex": "\\boxed{0}"
            }
          ],
