      "position": 1,
      "label": null,
      "prompt": [
        {
          "type": "text",
          "text": "A boy checks the height of his town's water tower. He stands 20 m from a vertical tower on flat ground; the angle of elevation from eye level to the top is 35°, and his eye is 1.6 m above the ground. Calculate the height h of the tower in metres, correct to 1 decimal place."
        }
      ],
      "marks": 4,
      "primary_outcome": "4.3",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "rounded_dp",
        "canonical_answer": "15.6",
        "canonical_latex": "15.6",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": 1,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "First calculate the height above eye level using tangent."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Use "
            },
            {
              "type": "inline_math",
              "latex": "\\tan 35^{\\circ}=\\frac{h-1.6}{20}"
            },
            {
              "type": "text",
              "text": " to find the height above eye level, then account for the eye height."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "From the eye, the height above eye level, h − 1.6, is opposite the 35° angle and the 20 m distance is adjacent."
            },
            {
              "type": "display_math",
              "latex": "\\tan 35^\\circ=\\frac{h-1.6}{20}"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 2,
          "content": [
            {
              "type": "display_math",
              "latex": "h-1.6=20\\tan 35^\\circ=14.004\\ldots"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 3,
          "content": [
            {
              "type": "text",
              "text": "Add the eye height."
            },
            {
              "type": "display_math",
              "latex": "h=14.004\\ldots+1.6=15.604\\ldots"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 4,
          "content": [
            {
              "type": "display_math",
              "latex": "h=15.6\\text{ m}"
            }
          ],
          "mark_type": "A",
          "mark_value": 1
        }
      ]
    }
  ],
