      "prompt": [
        {
          "type": "text",
          "text": "A technician stands 16 m from a vertical tower carrying radio aerials. The angle of elevation from eye level to the top is 50°, and his eye is 1.6 m above the ground. Find the height h of the radio tower in metres, correct to 1 decimal place."
        }
      ],
      "marks": 4,
      "primary_outcome": "4.3",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "rounded_dp",
        "canonical_answer": "20.7",
        "canonical_latex": "20.7",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": 1,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "First calculate the height above eye level using tangent."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Use "
            },
            {
              "type": "inline_math",
              "latex": "\\tan 50^{\\circ}=\\frac{h-1.6}{16}"
            },
            {
              "type": "text",
              "text": " to find the height above eye level, then account for the eye height."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "From the eye, the height above eye level, h − 1.6, is opposite the 50° angle and the 16 m distance is adjacent."
            },
            {
              "type": "display_math",
              "latex": "\\tan 50^\\circ=\\frac{h-1.6}{16}"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 2,
          "content": [
            {
              "type": "display_math",
              "latex": "h-1.6=16\\tan 50^\\circ=19.068\\ldots"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 3,
          "content": [
            {
              "type": "text",
              "text": "Add the eye height."
            },
            {
              "type": "display_math",
              "latex": "h=19.068\\ldots+1.6=20.668\\ldots"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 4,
          "content": [
            {
              "type": "display_math",
              "latex": "h=20.7\\text{ m}"
            }
          ],
          "mark_type": "A",
          "mark_value": 1
        }
      ]
    }
  ],
