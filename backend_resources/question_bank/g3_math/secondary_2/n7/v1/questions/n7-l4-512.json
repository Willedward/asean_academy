      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "At each end of the graph, px+1 reaches one of the limits."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Use the right-hand end: set px+1 equal to 15, using the x-value at that end."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "The graph shows -2<x≤7, so px+1=15 when x=7."
            },
            {
              "type": "display_math",
              "latex": "7p+1=15\\Rightarrow 7p=14\\Rightarrow p=2"
            }
          ],
          "mark_type": "M",
          "mark_value": 3
        },
        {
          "position": 2,
          "content": [
            {
              "type": "text",
              "text": "Check with the left end."
            },
            {
              "type": "display_math",
              "latex": "2(-2)+1=-3"
            }
          ],
          "mark_type": "A",
          "mark_value": 1
        }
      ]
