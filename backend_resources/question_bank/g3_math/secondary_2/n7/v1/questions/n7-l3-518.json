        {
          "type": "text",
          "text": "The straight line shown meets the axes at grid points. Find the x-coordinate of the point on this line where y is equal to x."
        }
      ],
      "marks": 3,
      "primary_outcome": "7.7",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
