        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Use the points where the line crosses the axes to write its equation in the form "
            },
            {
              "type": "inline_math",
              "latex": "x+y=c"
            },
            {
              "type": "text",
              "text": "."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Replace "
            },
            {
              "type": "inline_math",
              "latex": "y"
            },
            {
              "type": "text",
              "text": " with "
            },
            {
              "type": "inline_math",
              "latex": "x"
            },
            {
              "type": "text",
              "text": " in your equation, then solve for "
            },
            {
