              "latex": "x"
            },
            {
              "type": "text",
              "text": "."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "The line crosses the axes at "
            },
            {
              "type": "inline_math",
              "latex": "(9,0)"
            },
            {
              "type": "text",
              "text": " and "
            },
            {
              "type": "inline_math",
              "latex": "(0,9)"
            },
            {
              "type": "text",
              "text": ", so its equation is "
            },
            {
              "type": "inline_math",
              "latex": "x+y=9"
            },
            {
              "type": "text",
              "text": ". Put "
            },
            {
              "type": "inline_math",
              "latex": "y=x"
            },
            {
              "type": "text",
              "text": "."
            },
            {
              "type": "display_math",
              "latex": "x+x=9\\Rightarrow 2x=9"
            }
          ],
          "mark_type": "M",
          "mark_value": 2
        },
        {
          "position": 2,
          "content": [
            {
              "type": "text",
              "text": "Divide by 2."
            },
            {
              "type": "display_math",
              "latex": "x=4.5"
            }
          ],
          "mark_type": "A",
          "mark_value": 1
        }
      ]
