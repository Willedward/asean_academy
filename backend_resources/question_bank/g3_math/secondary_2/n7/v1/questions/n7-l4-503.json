              "type": "text",
              "text": "Each constant is the value of 2x+2 at the matching end of the graph."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Evaluate 2x+2 at each end of the graph, then add the two results."
            }
          ]
