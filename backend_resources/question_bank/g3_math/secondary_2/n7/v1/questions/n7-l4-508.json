      "prompt": [
        {
          "type": "text",
          "text": "The number line shows the solution of -5<2x+c≤15. Find the constant c."
        }
      ],
      "marks": 4,
      "primary_outcome": "7.6",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "3",
        "canonical_latex": "3",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": null,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "The two ends of the graph are where 2x+c reaches -5 and 15."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Use the left end of the graph: substitute its value for x in 2x+c=-5, then solve for c."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "The graph shows -4<x≤6, so 2x+c=-5 when x=-4."
            },
            {
              "type": "display_math",
              "latex": "2(-4)+c=-5\\Rightarrow c=3"
            }
          ],
          "mark_type": "M",
          "mark_value": 3
        },
        {
          "position": 2,
          "content": [
            {
              "type": "text",
              "text": "Check with the right end."
            },
            {
              "type": "display_math",
              "latex": "2(6)+3=15"
            }
          ],
          "mark_type": "A",
          "mark_value": 1
        }
      ]
    }
