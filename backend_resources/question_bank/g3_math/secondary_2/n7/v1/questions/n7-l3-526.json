      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Solve the inequality yourself before trusting the drawing."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Subtract 22 from both sides, then divide both sides by -2, taking care with the sign."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "Dividing by -2 reverses the sign, so the correct solution is "
            },
            {
              "type": "inline_math",
              "latex": "x<6"
            },
            {
              "type": "text",
              "text": ". The line in the drawing goes the wrong way."
            },
            {
              "type": "display_math",
              "latex": "22-2x>10\\Rightarrow -2x>-12\\Rightarrow x<6"
            }
          ],
          "mark_type": "M",
          "mark_value": 2
        },
        {
          "position": 2,
          "content": [
            {
              "type": "text",
              "text": "The greatest integer less than 6 is 5."
            },
            {
              "type": "display_math",
              "latex": "x_{\\max}=5"
            }
          ],
          "mark_type": "A",
          "mark_value": 1
        }
      ]
    }
