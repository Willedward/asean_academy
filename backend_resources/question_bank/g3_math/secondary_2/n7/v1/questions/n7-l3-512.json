      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Read two grid points on the line and see how much y falls as x rises."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Find the fall in y when x rises by 5, then continue the pattern until y reaches 3."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "From (0, 7) to (5, 6), y falls by 1 when x rises by 5. To fall from 7 to 3 is a fall of 4."
            },
            {
              "type": "display_math",
              "latex": "x=4\\times 5=20\\Rightarrow k=20"
            }
          ],
          "mark_type": "M",
          "mark_value": 2
        },
        {
          "position": 2,
          "content": [
            {
              "type": "text",
              "text": "Check: the line through these points has equation x+5y=35."
            },
            {
              "type": "display_math",
              "latex": "20+5(3)=35"
            }
          ],
          "mark_type": "A",
          "mark_value": 1
        }
      ]
    }
