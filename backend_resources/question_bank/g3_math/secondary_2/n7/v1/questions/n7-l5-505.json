        {
          "type": "text",
          "text": "The number line shows the solution of "
        },
        {
          "type": "inline_math",
          "latex": "-12\\le ax+b<21"
        },
        {
          "type": "text",
          "text": ", where a and b are constants and "
        },
        {
          "type": "inline_math",
          "latex": "a>0"
        },
        {
          "type": "text",
          "text": ". Find the value of ab."
        }
      ],
      "marks": 5,
      "primary_outcome": "7.6",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "-9",
