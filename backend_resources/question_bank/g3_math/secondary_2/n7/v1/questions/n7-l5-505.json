        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "The two ends of the graph give one equation each in "
            },
            {
              "type": "inline_math",
              "latex": "a"
            },
            {
              "type": "text",
              "text": " and "
            },
            {
              "type": "inline_math",
              "latex": "b"
            },
            {
              "type": "text",
              "text": "."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Substitute each end of the graph for "
            },
            {
              "type": "inline_math",
              "latex": "x"
            },
            {
              "type": "text",
              "text": " in "
            },
            {
              "type": "inline_math",
              "latex": "ax+b"
            },
            {
              "type": "text",
              "text": " to write two simultaneous equations, then solve them."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "The graph shows "
            },
            {
              "type": "inline_math",
              "latex": "-3\\le x<8"
            },
            {
              "type": "text",
              "text": ", so "
            },
            {
              "type": "inline_math",
              "latex": "ax+b"
            },
            {
              "type": "text",
              "text": " equals -12 at "
            },
            {
              "type": "inline_math",
              "latex": "x=-3"
            },
            {
              "type": "text",
              "text": " and equals 21 at "
            },
            {
              "type": "inline_math",
              "latex": "x=8"
            },
            {
              "type": "text",
              "text": "."
            },
            {
              "type": "display_math",
              "latex": "-3a+b=-12,\\quad 8a+b=21\\Rightarrow 11a=33\\Rightarrow a=3,\\ b=-3"
            }
          ],
          "mark_type": "M",
          "mark_value": 4
        },
        {
          "position": 2,
          "content": [
            {
              "type": "text",
              "text": "Multiply "
            },
            {
              "type": "inline_math",
              "latex": "a"
            },
            {
              "type": "text",
              "text": " and "
            },
            {
              "type": "inline_math",
              "latex": "b"
            },
            {
              "type": "text",
              "text": "."
            },
            {
              "type": "display_math",
              "latex": "ab=3\\times(-3)=-9"
            }
          ],
          "mark_type": "A",
          "mark_value": 1
        }
      ]
