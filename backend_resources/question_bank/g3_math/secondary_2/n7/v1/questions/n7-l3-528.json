          "type": "text",
          "text": "The straight line shown and the two coordinate axes enclose a triangle. Find the area of this triangle in square units."
        }
      ],
      "marks": 3,
      "primary_outcome": "7.7",
      "secondary_outcomes": [],
      "response": {
