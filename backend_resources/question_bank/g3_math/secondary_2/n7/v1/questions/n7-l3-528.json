          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Find where the line crosses each axis."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "The triangle has its right angle at the origin, so use half × base × height."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "The line crosses the axes at (10, 0) and (0, 10), so the base and height are both 10."
            },
            {
              "type": "display_math",
              "latex": "\\text{base}=10,\\quad\\text{height}=10"
            }
          ],
          "mark_type": "M",
          "mark_value": 2
        },
        {
          "position": 2,
          "content": [
            {
              "type": "text",
              "text": "Apply the area formula."
            },
            {
              "type": "display_math",
              "latex": "\\text{area}=\\tfrac{1}{2}\\times 10\\times 10=50"
            }
          ],
          "mark_type": "A",
          "mark_value": 1
        }
      ]
