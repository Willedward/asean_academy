  "title": "Even product on two different spinners",
  "difficulty": 4,
  "calculator_allowed": false,
  "question_type": "structured",
  "status": "draft",
  "stem": [
    {
      "type": "text",
      "text": "Two fair spinners are each spun once. The first spinner is labelled 1, 2, 3 and 4. The second spinner is labelled 1, 2, 3, 4 and 5."
    }
  ],
  "parts": [
    {
      "position": 1,
      "label": null,
      "prompt": [
        {
          "type": "text",
          "text": "List all the equally likely pairs of results and find the probability that the product of the two results is even. Give your answer as a fraction in simplest form."
        }
      ],
      "marks": 4,
      "primary_outcome": "2.2",
      "secondary_outcomes": [],
      "response": {
        "type": "algebraic_expression",
        "comparison_mode": "symbolic_equivalence",
        "canonical_expression": "7/10",
        "canonical_latex": "\\frac7{10}",
        "variables": [],
        "domain_constraints": [],
        "accepted_equivalents": [],
        "checker_config": {
          "form": "simplest_fraction"
        }
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Draw a grid with 4 rows and 5 columns, one for each result of each spinner."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "The product is odd only when both results are odd. Count the odd-product cells in the grid."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "display_math",
              "latex": "\\text{There are }4\\times5=20\\text{ equally likely pairs.}"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 2,
          "content": [
            {
              "type": "display_math",
              "latex": "\\text{Odd products: }(1,1),(1,3),(1,5),(3,1),(3,3),(3,5),\\text{ so there are }6."
            }
          ],
          "mark_type": "M",
          "mark_value": 2
        },
        {
          "position": 3,
          "content": [
            {
              "type": "display_math",
              "latex": "P(\\text{even product})=\\frac{20-6}{20}=\\frac{14}{20}=\\frac7{10}"
            }
          ],
          "mark_type": "A",
          "mark_value": 1
        }
      ]
    }
  ],
