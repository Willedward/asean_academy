        "rounding_precision": null,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Find distinct triples from {1,2,3,4} whose sum is 6."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Only 1, 2 and 3 work; count their six orders among 4 cubed outcomes."
            }
