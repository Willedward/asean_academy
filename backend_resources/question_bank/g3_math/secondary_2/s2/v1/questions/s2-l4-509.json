      "prompt": [
        {
          "type": "text",
          "text": "A spinner is recorded as landing on blue 38 times in 80 spins. Later, 5 blue records are found to be recording errors and are removed together with those 5 trials. Find the corrected experimental probability of blue as a fraction in simplest form."
        }
      ],
      "marks": 4,
      "primary_outcome": "2.1",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "11/25",
        "canonical_latex": "\\frac{11}{25}",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": null,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Remove the erroneous records from both the blue frequency and total trials."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Use (38 - 5)/(80 - 5), then simplify."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "display_math",
              "latex": "\\frac{38-5}{80-5}=\\frac{33}{75}=\\frac{11}{25}"
            }
          ],
          "mark_type": "M",
          "mark_value": 3
        },
        {
          "position": 2,
          "content": [
            {
              "type": "display_math",
              "latex": "\\boxed{\\frac{11}{25}}"
            }
          ],
