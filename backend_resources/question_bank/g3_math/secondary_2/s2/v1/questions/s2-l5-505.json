        {
          "type": "text",
          "text": "A fair spinner numbered 1, 2 and 3 is spun three times. Find the probability that at least two results are equal. Give your answer as a fraction in simplest form."
        }
      ],
      "marks": 5,
      "primary_outcome": "2.2",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "7/9",
        "canonical_latex": "\\frac{7}{9}",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": null,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Use the complement where all three results are different."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "All-different outcomes are the six permutations of 1, 2 and 3 among 27 outcomes."
            }
          ]
        }
      ],
      "solution": [
