        "rounding_precision": null,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "There are 5 times 4 possible ordered two-digit numbers."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "A number above 40 must begin with 4 or 5; count the allowed units digits."
            }
