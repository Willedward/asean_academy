            {
              "type": "text",
              "text": "Factors of 12 among the labels are 1, 2, 3 and 4."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Count every sector carrying one of those labels, including repeated labels."
