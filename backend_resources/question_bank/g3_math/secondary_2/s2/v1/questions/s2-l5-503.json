          "content": [
            {
              "type": "text",
              "text": "List the ordered pairs of cards first, then pair each one with H or T."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "There are 20 ordered card pairs and 40 outcomes once the coin is included. List the card pairs that total 6."
            }
          ]
