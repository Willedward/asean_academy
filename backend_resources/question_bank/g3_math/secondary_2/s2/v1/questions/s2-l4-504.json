      "prompt": [
        {
          "type": "text",
          "text": "A fair spinner numbered 1 to 6 is spun twice. Find the probability that at least one result is prime. Give your answer as a fraction in simplest form."
        }
      ],
      "marks": 4,
      "primary_outcome": "2.2",
      "secondary_outcomes": [],
      "response": {
        "type": "algebraic_expression",
        "comparison_mode": "symbolic_equivalence",
        "canonical_expression": "3/4",
        "canonical_latex": "\\frac{3}{4}",
        "variables": [],
        "domain_constraints": [],
        "accepted_equivalents": [],
        "checker_config": {
          "form": "simplest_fraction"
        }
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Draw a 6 by 6 possibility table, or count the outcomes where neither result is prime."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "The non-primes are 1, 4 and 6. Count the cells of the table where both results are non-prime."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "In the 36-cell possibility table, both results are non-prime in "
            },
            {
              "type": "inline_math",
              "latex": "3\\times3=9"
            },
            {
              "type": "text",
              "text": " cells (each from 1, 4, 6). So "
            },
            {
              "type": "inline_math",
              "latex": "36-9=27"
            },
            {
              "type": "text",
              "text": " cells have at least one prime. "
            },
            {
              "type": "display_math",
              "latex": "P=\\frac{27}{36}"
            }
          ],
          "mark_type": "M",
          "mark_value": 3
        },
        {
          "position": 2,
          "content": [
            {
              "type": "display_math",
              "latex": "\\boxed{\\frac{3}{4}}"
            }
          ],
