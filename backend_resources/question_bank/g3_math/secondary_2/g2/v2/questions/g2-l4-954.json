          "type": "text",
          "text": "Find the area of the original panel in cm². Enter the numerical value only."
        }
      ],
      "marks": 4,
      "primary_outcome": "2.4",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
