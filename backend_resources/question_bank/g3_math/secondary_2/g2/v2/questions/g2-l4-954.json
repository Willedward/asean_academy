      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Area changes by the square of the linear scale factor."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "The area scale factor is (3/4)² = 9/16, so the reduced area is 9/16 of the original area."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "display_math",
              "latex": "\\text{Area scale factor}=\\left(\\frac34\\right)^2=\\frac9{16}"
            }
          ],
          "mark_type": "M",
          "mark_value": 2
        },
        {
          "position": 2,
          "content": [
            {
              "type": "display_math",
              "latex": "\\frac9{16}A=27"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 3,
          "content": [
            {
              "type": "display_math",
              "latex": "A=27\\times\\frac{16}9=48\\text{ cm}^2"
            }
          ],
          "mark_type": "A",
          "mark_value": 1
        }
      ]
    }
