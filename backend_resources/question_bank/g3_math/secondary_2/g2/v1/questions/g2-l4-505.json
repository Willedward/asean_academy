      "prompt": [
        {
          "type": "text",
          "text": "Triangle ABC is congruent to triangle ADC, with A, B and C corresponding to A, D and C. AB = (3x − 2) cm, AD = (x + 8) cm and DC = (2x − 1) cm. Find the perimeter of quadrilateral ABCD in cm. Enter the numerical value only."
        }
      ],
      "marks": 3,
      "primary_outcome": "2.1",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "44",
        "canonical_latex": "44",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": null,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Corresponding sides of congruent triangles are equal. Which side of triangle ADC matches AB, and which side of triangle ABC matches DC?"
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "AB corresponds to AD, so solve "
            },
            {
              "type": "inline_math",
              "latex": "3x-2=x+8"
            },
            {
              "type": "text",
              "text": ". BC corresponds to DC."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "AB corresponds to AD, so they are equal."
            },
            {
              "type": "display_math",
              "latex": "3x-2=x+8\\ \\Rightarrow\\ x=5"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 2,
          "content": [
            {
              "type": "text",
              "text": "So AB = AD = 13 cm, and BC = DC = 2(5) − 1 = 9 cm."
            },
            {
              "type": "display_math",
              "latex": "AB=AD=13,\\quad BC=DC=9"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 3,
          "content": [
            {
              "type": "display_math",
              "latex": "P=13+13+9+9=44"
            }
          ],
          "mark_type": "A",
          "mark_value": 1
        }
      ]
    }
