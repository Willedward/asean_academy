          "type": "text",
          "text": "An enlargement maps A = (2, 3) to A′ = (8, 9) with scale factor 3. The centre is C = (h, k). Find h + k. Enter the numerical value only."
        }
      ],
      "marks": 3,
      "primary_outcome": "2.4",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "-1",
        "canonical_latex": "-1",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": null,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Use A′ = C + 3(A − C)."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Solve each coordinate: 8 = h + 3(2 − h), 9 = k + 3(3 − k)."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "display_math",
              "latex": "8=h+3(2-h)\\Rightarrow h=-1"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 2,
          "content": [
            {
              "type": "display_math",
              "latex": "9=k+3(3-k)\\Rightarrow k=0"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 3,
          "content": [
            {
              "type": "display_math",
              "latex": "h+k=-1"
            }
          ],
