          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Match each side of triangle ABC with the side of triangle XYZ that joins the corresponding vertices."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "AB corresponds to XY, so solve "
            },
            {
              "type": "inline_math",
              "latex": "2k+1=13"
            },
            {
              "type": "text",
              "text": ". Then BC corresponds to YZ."
            }
