          "type": "text",
          "text": "An enlargement has centre C = (3, −2), scale factor 2/3 and maps A = (−3, 7) to A′. Find the sum of the coordinates of A′. Enter the numerical value only."
        }
      ],
      "marks": 3,
      "primary_outcome": "2.4",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "3",
        "canonical_latex": "3",
        "accepted_answers": [],
