          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 2,
          "content": [
            {
              "type": "display_math",
              "latex": "A'=C+\\frac23(A-C)=(-1,4)"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
