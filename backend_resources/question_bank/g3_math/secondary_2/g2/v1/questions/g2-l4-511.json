        "rounding_precision": null,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Work from the centre using "
            },
            {
              "type": "inline_math",
              "latex": "A'=C+k(A-C)"
            },
            {
              "type": "text",
              "text": "."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Find "
            },
            {
              "type": "inline_math",
              "latex": "A-C"
            },
            {
              "type": "text",
              "text": " first, multiply each component by "
            },
            {
              "type": "inline_math",
              "latex": "\\frac{2}{3}"
            },
            {
              "type": "text",
              "text": ", then add C to the result."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "display_math",
              "latex": "A-C=(-6,9)"
