        {
          "type": "text",
          "text": "A logo has an original side of 10 cm. It is enlarged by scale factor 3, and the enlarged copy is then scaled so that the final side is 15 cm. Find the scale factor of the second step. Give your answer in centimetres. Enter the numerical value only."
        }
      ],
      "marks": 3,
      "primary_outcome": "2.2",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "0.5",
