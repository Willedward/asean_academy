          "type": "text",
          "text": "Two vertical poles stand on level ground. At the same time of day, a 1.8 m pole casts a 2.4 m shadow and a taller pole casts a shadow 9.6 m longer than the first. Find the taller pole's height in metres. Enter the numerical value only."
        }
      ],
      "marks": 3,
      "primary_outcome": "2.5",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "9",
        "canonical_latex": "9",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": null,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "First add 9.6 m to the shorter shadow length."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "The longer shadow is 12 m; use equal height-to-shadow ratios."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "display_math",
              "latex": "s=2.4+9.6=12"
