      "prompt": [
        {
          "type": "text",
          "text": "Triangles ABC and PQR are congruent, with A, B and C corresponding to P, Q and R. Angle A = (2x + 10)°, angle P = (3x − 15)° and angle Q = 2x°. Find angle C in degrees. Enter the numerical value only."
        }
      ],
      "marks": 2,
      "primary_outcome": "2.1",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "70",
        "canonical_latex": "70",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": null,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Corresponding angles of congruent triangles are equal. Which two of the given angles correspond?"
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Angle A corresponds to angle P, so solve "
            },
            {
              "type": "inline_math",
              "latex": "2x+10=3x-15"
            },
            {
              "type": "text",
              "text": ". Angle B equals angle Q."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "Angle A corresponds to angle P."
            },
            {
              "type": "display_math",
              "latex": "2x+10=3x-15\\ \\Rightarrow\\ x=25"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 2,
          "content": [
            {
              "type": "text",
              "text": "So angle A = 60° and angle B = angle Q = 50°."
            },
            {
              "type": "display_math",
              "latex": "\\angle C=180^\\circ-60^\\circ-50^\\circ=70^\\circ"
            }
          ],
          "mark_type": "A",
          "mark_value": 1
        }
      ]
    }
  ],
