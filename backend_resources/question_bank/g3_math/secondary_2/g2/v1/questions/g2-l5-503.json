          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Use "
            },
            {
              "type": "inline_math",
              "latex": "\\frac{2x-1}{x+2}=\\frac{21}{12}"
            },
            {
              "type": "text",
              "text": " and cross-multiply."
            }
          ]
        }
      ],
