      "prompt": [
        {
          "type": "text",
          "text": "A vertical axis starts at 85. Two bars show the values 95 and 110. Relative to the displayed height of the first bar, what percentage increase does the second bar appear to show?"
        }
      ],
      "marks": 2,
      "primary_outcome": "1.7",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "150",
        "canonical_latex": "150",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": null,
        "unit": {
          "canonical": "%",
          "accepted": [
            "%",
            "percent",
            "per cent"
          ],
          "required": false
        }
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Displayed height is measured from the truncated baseline, not from zero."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "The visible heights are "
            },
            {
              "type": "inline_math",
              "latex": "95-85"
            },
            {
              "type": "text",
              "text": " and "
            },
            {
              "type": "inline_math",
              "latex": "110-85"
            },
            {
              "type": "text",
              "text": "."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "Measure heights from the shortened baseline. "
            },
            {
              "type": "display_math",
              "latex": "\\frac{(110-85)-(95-85)}{95-85}\\times100=\\frac{15}{10}\\times100"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 2,
          "content": [
            {
              "type": "text",
              "text": "So the apparent increase is "
            },
            {
              "type": "display_math",
              "latex": "150\\%"
            }
          ],
          "mark_type": "A",
          "mark_value": 1
        }
      ]
    }
  ],
