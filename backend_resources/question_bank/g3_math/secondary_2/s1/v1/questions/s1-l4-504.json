      "prompt": [
        {
          "type": "text",
          "text": "A misleading histogram uses frequency as bar height. The first class has width 5 and frequency 10; the second class has width 15 and frequency 30. The second bar is 3 times as tall as the first. How many times the frequency density of the first class is the frequency density of the second class?"
        }
      ],
      "marks": 4,
      "primary_outcome": "1.7",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "1",
        "canonical_latex": "1",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": null,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Frequency density is frequency divided by class width."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Find the density of each class, then divide the second density by the first."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "Find each frequency density. "
            },
            {
              "type": "display_math",
              "latex": "\\frac{10}{5}=2,\\quad\\frac{30}{15}=2"
            }
          ],
          "mark_type": "M",
          "mark_value": 3
        },
        {
          "position": 2,
          "content": [
            {
              "type": "text",
              "text": "So the true ratio of densities is "
            },
            {
              "type": "display_math",
              "latex": "1"
            },
            {
              "type": "text",
              "text": " even though the second bar is 3 times as tall."
            }
          ],
          "mark_type": "A",
          "mark_value": 1
        }
      ]
    }
  ],
