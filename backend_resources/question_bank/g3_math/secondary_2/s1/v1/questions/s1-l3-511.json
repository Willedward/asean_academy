      "position": 1,
      "label": null,
      "prompt": [
        {
          "type": "text",
          "text": "A chart of weekly hall attendance has a vertical axis that is cut off at 110. Its two bars reach 140 and 155. Judging only by the heights actually drawn, by what percentage does the second bar look taller than the first?"
        }
      ],
      "marks": 3,
      "primary_outcome": "1.7",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "50",
        "canonical_latex": "50",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": null,
        "unit": {
          "canonical": "%",
          "accepted": [
            "%",
            "percent",
            "per cent"
          ],
          "required": false
        }
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Displayed bar height is measured from the truncated baseline, not from zero."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "The visible heights are "
            },
            {
              "type": "inline_math",
              "latex": "140-110"
            },
            {
              "type": "text",
              "text": " and "
            },
            {
              "type": "inline_math",
              "latex": "155-110"
            },
            {
              "type": "text",
              "text": ". Compare the increase with the first visible height."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "Measure heights from the truncated baseline. "
            },
            {
              "type": "display_math",
              "latex": "\\frac{(155-110)-(140-110)}{140-110}\\times100=\\frac{15}{30}\\times100"
            }
          ],
          "mark_type": "M",
          "mark_value": 2
        },
        {
          "position": 2,
          "content": [
            {
              "type": "text",
              "text": "So the apparent increase is "
            },
            {
              "type": "display_math",
              "latex": "50\\%"
            }
          ],
          "mark_type": "A",
          "mark_value": 1
        }
      ]
    }
  ],
