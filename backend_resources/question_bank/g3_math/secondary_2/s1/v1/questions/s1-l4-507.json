      "prompt": [
        {
          "type": "text",
          "text": "Two grouped datasets use midpoints 5, 15, 25. Frequencies for A are [6, 8, 4]; frequencies for B are [4, 6, 8]. By how much is B's estimated mean greater than A's? Give your answer as an exact fraction, or as a decimal correct to 3 significant figures."
        }
      ],
      "marks": 4,
      "primary_outcome": "1.10",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "10/3",
        "canonical_latex": "\\frac{10}{3}",
        "accepted_answers": [
          "3.33"
        ],
        "absolute_tolerance": null,
        "rounding_precision": null,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Calculate each weighted mean with its own frequency row."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Subtract A's estimated mean from B's estimated mean."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "Find each estimated mean. "
            },
            {
              "type": "display_math",
              "latex": "\\bar x_A=\\frac{5(6)+15(8)+25(4)}{18}=\\frac{250}{18},\\quad\\bar x_B=\\frac{5(4)+15(6)+25(8)}{18}=\\frac{310}{18}"
            }
          ],
          "mark_type": "M",
          "mark_value": 3
        },
        {
          "position": 2,
          "content": [
            {
              "type": "text",
              "text": "Subtract: "
            },
            {
              "type": "display_math",
              "latex": "\\frac{310-250}{18}=\\frac{60}{18}=\\frac{10}{3}"
            }
          ],
          "mark_type": "A",
          "mark_value": 1
        }
      ]
    }
