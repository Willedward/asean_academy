      "prompt": [
        {
          "type": "text",
          "text": "The vertical axis of a rainfall bar chart starts at 100. One month reads 110 and the next reads 118. Relative to the displayed height of the first bar, what percentage increase does the second bar appear to show?"
        }
      ],
      "marks": 2,
      "primary_outcome": "1.7",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "80",
        "canonical_latex": "80",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": null,
        "unit": {
          "canonical": "%",
          "accepted": [
            "%",
            "percent",
            "per cent"
          ],
          "required": false
        }
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Displayed height is measured from the truncated baseline, not from zero."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "The visible heights are "
            },
            {
              "type": "inline_math",
              "latex": "110-100"
            },
            {
              "type": "text",
              "text": " and "
            },
            {
              "type": "inline_math",
              "latex": "118-100"
            },
            {
              "type": "text",
              "text": ". Compare the increase with the first visible height."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "Measure heights from the truncated baseline. "
            },
            {
              "type": "display_math",
              "latex": "\\frac{(118-100)-(110-100)}{110-100}\\times100=\\frac{8}{10}\\times100"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 2,
          "content": [
            {
              "type": "text",
              "text": "So the apparent increase is "
            },
            {
              "type": "display_math",
              "latex": "80\\%"
            }
          ],
          "mark_type": "A",
          "mark_value": 1
        }
      ]
    }
  ],
