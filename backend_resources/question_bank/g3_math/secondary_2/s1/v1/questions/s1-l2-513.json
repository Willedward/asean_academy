      "prompt": [
        {
          "type": "text",
          "text": "A chart of daily museum visitors starts its vertical axis at 95. The two bars reach 105 and 115. Relative to the displayed height of the first bar, what percentage increase does the second bar appear to show?"
        }
      ],
      "marks": 2,
      "primary_outcome": "1.7",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "100",
