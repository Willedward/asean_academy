      "prompt": [
        {
          "type": "text",
          "text": "A chart of daily museum visitors starts its vertical axis at 95. The two bars reach 105 and 110. Relative to the displayed height of the first bar, what percentage increase does the second bar appear to show?"
        }
      ],
      "marks": 2,
      "primary_outcome": "1.7",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "50",
        "canonical_latex": "50",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": null,
        "unit": {
          "canonical": "%",
          "accepted": [
            "%",
            "percent",
            "per cent"
          ],
          "required": false
        }
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Displayed height is measured from the truncated baseline, not from zero."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "The visible heights are "
            },
            {
              "type": "inline_math",
              "latex": "105-95"
            },
            {
              "type": "text",
              "text": " and "
            },
            {
              "type": "inline_math",
              "latex": "110-95"
            },
            {
              "type": "text",
              "text": ". Compare the increase with the first visible height."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "Measure heights from the truncated baseline. "
            },
            {
              "type": "display_math",
              "latex": "\\frac{(110-95)-(105-95)}{105-95}\\times100=\\frac{5}{10}\\times100"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 2,
          "content": [
            {
              "type": "text",
              "text": "So the apparent increase is "
            },
            {
              "type": "display_math",
              "latex": "50\\%"
            }
          ],
          "mark_type": "A",
          "mark_value": 1
        }
      ]
    }
  ],
