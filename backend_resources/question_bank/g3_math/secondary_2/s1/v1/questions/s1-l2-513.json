          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "Extract the relevant values and apply the stated statistical method."
            },
            {
              "type": "display_math",
              "latex": "\\frac{(115-95)-(105-95)}{105-95}\\times100=100"
