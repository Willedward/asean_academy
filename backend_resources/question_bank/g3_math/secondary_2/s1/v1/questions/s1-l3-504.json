              "latex": "130-105"
            },
            {
              "type": "text",
              "text": " and "
            },
            {
              "type": "inline_math",
              "latex": "145-105"
            },
            {
              "type": "text",
              "text": ". Compare their increase with the first displayed height."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "Extract the relevant values and apply the stated statistical method."
            },
            {
              "type": "display_math",
              "latex": "\\frac{(145-105)-(130-105)}{130-105}\\times100=60"
            }
          ],
