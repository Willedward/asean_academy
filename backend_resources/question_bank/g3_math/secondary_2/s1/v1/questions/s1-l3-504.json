          "type": "text",
          "text": "A bar chart begins its vertical axis at 105. Two values are 130 and 145. Relative to the displayed height of the first bar, what percentage increase does the second bar appear to show?"
        }
      ],
      "marks": 3,
      "primary_outcome": "1.7",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "60",
