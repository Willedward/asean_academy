      "label": null,
      "prompt": [
        {
          "type": "text",
          "text": "A bar chart begins its vertical axis at 105. Two bars show the values 130 and 150. Relative to the displayed height of the first bar, what percentage increase does the second bar appear to show?"
        }
      ],
      "marks": 3,
      "primary_outcome": "1.7",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "80",
        "canonical_latex": "80",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": null,
        "unit": {
          "canonical": "%",
          "accepted": [
            "%",
            "percent",
            "per cent"
          ],
          "required": false
        }
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Displayed bar height is measured from the truncated baseline, not from zero."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "The displayed heights are "
            },
            {
              "type": "inline_math",
              "latex": "130-105"
            },
            {
              "type": "text",
              "text": " and "
            },
            {
              "type": "inline_math",
              "latex": "150-105"
            },
            {
              "type": "text",
              "text": ". Compare the increase with the first displayed height."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "Measure heights from the truncated baseline. "
            },
            {
              "type": "display_math",
              "latex": "\\frac{(150-105)-(130-105)}{130-105}\\times100=\\frac{20}{25}\\times100"
            }
          ],
          "mark_type": "M",
          "mark_value": 2
        },
        {
          "position": 2,
          "content": [
            {
              "type": "text",
              "text": "So the apparent increase is "
            },
            {
              "type": "display_math",
              "latex": "80\\%"
            }
          ],
          "mark_type": "A",
          "mark_value": 1
        }
      ]
    }
  ],
