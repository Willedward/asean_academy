      "prompt": [
        {
          "type": "text",
          "text": "The vertical scale on a bar chart starts at 115 rather than zero. The first bar reaches 150 and the second reaches 171. By what percentage is the displayed height of the second bar greater than that of the first?"
        }
      ],
      "marks": 3,
      "primary_outcome": "1.7",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "60",
        "canonical_latex": "60\\%",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": null,
        "unit": {
          "canonical": "%",
          "accepted": [
            "%",
            "percent",
            "per cent"
          ],
          "required": false
        }
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "First measure each bar from 115, where the displayed vertical scale begins."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "The displayed heights are 35 and 56. Express their difference as a percentage of 35."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "Extract the relevant values and apply the stated statistical method."
            },
            {
              "type": "display_math",
              "latex": "\\frac{(171-115)-(150-115)}{150-115}\\times100=60"
            }
          ],
          "mark_type": "M",
          "mark_value": 2
        },
        {
          "position": 2,
          "content": [
