      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Write the expression as "
            },
            {
              "type": "inline_math",
              "latex": "(2x)^2-(x-3)^2"
            },
            {
              "type": "text",
              "text": " and use the difference of two squares."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Keep "
            },
            {
              "type": "inline_math",
              "latex": "(x-3)"
            },
            {
              "type": "text",
              "text": " in brackets when you subtract and add it, then take out any common factor at the end."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "Use "
            },
            {
              "type": "inline_math",
              "latex": "a^2-b^2=(a-b)(a+b)"
            },
            {
              "type": "text",
              "text": " with "
            },
            {
              "type": "inline_math",
              "latex": "a=2x"
            },
            {
              "type": "text",
              "text": " and "
            },
            {
              "type": "inline_math",
              "latex": "b=x-3"
            },
            {
              "type": "text",
              "text": ". "
            },
            {
              "type": "display_math",
              "latex": "\\left(2x-(x-3)\\right)\\left(2x+(x-3)\\right)=(x+3)(3x-3)"
            }
          ],
          "mark_type": "M",
          "mark_value": 3
        },
        {
          "position": 2,
          "content": [
            {
              "type": "text",
              "text": "Take out the common factor "
            },
            {
              "type": "inline_math",
              "latex": "3"
            },
            {
              "type": "text",
              "text": " from the second bracket: "
            },
            {
              "type": "display_math",
              "latex": "3(x+3)(x-1)"
            }
          ],
          "mark_type": "A",
          "mark_value": 1
        }
      ]
