      "label": null,
      "prompt": [
        {
          "type": "text",
          "text": "A museum transport display includes a solid cone. The closed cone has radius 8 cm and perpendicular height 15 cm. Find its total surface area in cm², correct to 1 decimal place."
        }
      ],
      "marks": 3,
      "primary_outcome": "5.6",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "rounded_dp",
        "canonical_answer": "628.3",
        "canonical_latex": "628.3",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": 1,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Find the slant height before calculating the curved area."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Use Pythagoras’ theorem for the slant height "
            },
            {
              "type": "inline_math",
              "latex": "l"
            },
            {
              "type": "text",
              "text": ", then add "
            },
            {
              "type": "inline_math",
              "latex": "\\pi rl"
            },
            {
              "type": "text",
              "text": " and "
            },
            {
              "type": "inline_math",
              "latex": "\\pi r^{2}"
            },
            {
              "type": "text",
              "text": "."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "The radius, perpendicular height and slant height form a right-angled triangle."
            },
            {
              "type": "display_math",
              "latex": "l=\\sqrt{8^2+15^2}=17\\text{ cm}"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 2,
          "content": [
            {
              "type": "text",
              "text": "Total surface area = curved area + base area."
            },
            {
              "type": "display_math",
              "latex": "S=\\pi(8)(17)+\\pi(8)^2=136\\pi+64\\pi=200\\pi"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 3,
          "content": [
            {
              "type": "display_math",
              "latex": "S=628.319\\ldots=628.3\\text{ cm}^2"
            }
          ],
          "mark_type": "A",
          "mark_value": 1
        }
      ]
    }
  ],
