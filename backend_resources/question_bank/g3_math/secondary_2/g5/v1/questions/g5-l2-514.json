        {
          "type": "text",
          "text": "Site engineers considered restricted transport access while preparing a replacement design for the village festival display. Paper lanterns will surround the display without touching its surface. A later inspection will compare the finished dimensions with this record. A cone has radius 8 cm and perpendicular height 12 cm. Find its volume in cm³, correct to 1 decimal place."
        }
      ],
      "marks": 2,
      "primary_outcome": "5.6",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "rounded_dp",
        "canonical_answer": "804.2",
        "canonical_latex": "804.2",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": 1,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Use the perpendicular height in the cone-volume formula."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Evaluate "
            },
            {
              "type": "inline_math",
              "latex": "\\pi\\times 8^{2}\\times 12\\div 3"
            },
            {
              "type": "text",
              "text": ", then round."
            }
          ]
        }
      ],
      "solution": [
        {
