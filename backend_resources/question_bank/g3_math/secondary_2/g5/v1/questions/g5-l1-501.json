        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": null,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "A pyramid occupies one third of the matching prism."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Use "
            },
            {
              "type": "inline_math",
              "latex": "V=\\frac{1}{3}\\times\\text{base area}\\times\\text{height}"
            },
            {
              "type": "text",
              "text": "."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "Use the pyramid volume formula."
            },
            {
              "type": "display_math",
              "latex": "V=\\frac13\\times12\\times6=24"
            }
          ],
          "mark_type": "A",
          "mark_value": 1
        }
      ]
    }
