        {
          "type": "text",
          "text": "A glass paperweight is shaped like a pyramid. The pyramid has base area 12 cm² and perpendicular height 6 cm. Find its volume in cm³."
        }
      ],
      "marks": 1,
      "primary_outcome": "5.6",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "24",
