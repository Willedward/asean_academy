      "prompt": [
        {
          "type": "text",
          "text": "A chocolate egg is modelled as a round shell of chocolate. The hollow spherical shell has outer radius 6 cm and inner radius 4 cm. Find the volume of chocolate in cm³, correct to 1 decimal place."
        }
      ],
      "marks": 4,
      "primary_outcome": "5.6",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "rounded_dp",
        "canonical_answer": "636.7",
        "canonical_latex": "636.7",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": 1,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "The material is the outer sphere with the inner space removed."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Subtract the inner sphere’s volume from the outer sphere’s volume."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "Volume of the outer sphere:"
            },
            {
              "type": "display_math",
              "latex": "\\frac43\\pi(6)^3=288\\pi"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 2,
          "content": [
            {
              "type": "text",
              "text": "Volume of the inner space:"
            },
            {
              "type": "display_math",
              "latex": "\\frac43\\pi(4)^3=\\frac{256}{3}\\pi"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 3,
          "content": [
            {
              "type": "text",
              "text": "Subtract."
            },
            {
              "type": "display_math",
              "latex": "V=288\\pi-\\frac{256}{3}\\pi=\\frac{608}{3}\\pi=636.696\\ldots"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 4,
          "content": [
            {
              "type": "display_math",
              "latex": "V=636.7\\text{ cm}^3"
            }
          ],
          "mark_type": "A",
          "mark_value": 1
        }
      ]
    }
