      "prompt": [
        {
          "type": "text",
          "text": "A sandcastle mould is filled with damp sand to make a right pyramid. The pyramid has a rectangular base 8 cm by 5 cm and perpendicular height 6 cm. How much sand fills the mould? Give the volume in cm³."
        }
      ],
      "marks": 2,
      "primary_outcome": "5.6",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "80",
        "canonical_latex": "80",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": null,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "First calculate the rectangular base area."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Use "
            },
            {
              "type": "inline_math",
              "latex": "V=\\frac{1}{3}\\times\\text{base area}\\times\\text{height}"
            },
            {
              "type": "text",
              "text": "."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "Find the base area, then use the pyramid volume formula."
            },
            {
              "type": "display_math",
              "latex": "V=\\frac13\\times(8\\times5)\\times6=\\frac13\\times40\\times6"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 2,
          "content": [
            {
              "type": "display_math",
              "latex": "V=80\\text{ cm}^3"
            }
          ],
          "mark_type": "A",
          "mark_value": 1
        }
      ]
    }
