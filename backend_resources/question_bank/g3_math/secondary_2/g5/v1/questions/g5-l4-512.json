        {
          "type": "text",
          "text": "Safety officers considered heavy seasonal rainfall while preparing a capacity check for the orchard irrigation reservoir. Irrigation pipes enter the reservoir through a low side wall. The design must also be explained clearly in the safety briefing. A hollow spherical shell has outer radius 4 cm and inner radius 2 cm. Find the volume of material in cm³, correct to 1 decimal place."
        }
      ],
      "marks": 4,
      "primary_outcome": "5.6",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "rounded_dp",
        "canonical_answer": "234.6",
        "canonical_latex": "234.6",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": 1,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "The material is the outer sphere with the inner space removed."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Subtract the inner sphere’s volume from the outer sphere’s volume."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "Select the relevant dimensions and apply the mensuration relationship."
            },
            {
              "type": "display_math",
              "latex": "V=\\frac43\\pi(4^3-2^3)=234.6"
            }
          ],
