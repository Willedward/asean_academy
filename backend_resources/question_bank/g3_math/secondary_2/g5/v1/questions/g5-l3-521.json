      "prompt": [
        {
          "type": "text",
          "text": "A jelly is set in a pointed mould. The rectangular pyramid has volume 300 cm³ and base dimensions 10 cm by 5 cm. Find its perpendicular height in cm."
        }
      ],
      "marks": 3,
      "primary_outcome": "5.6",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "18",
        "canonical_latex": "18",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": null,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Substitute the base area and volume into the pyramid formula."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Write "
            },
            {
              "type": "inline_math",
              "latex": "300=\\frac{1}{3}\\times\\text{base area}\\times h"
            },
            {
              "type": "text",
              "text": " and solve for "
            },
            {
              "type": "inline_math",
              "latex": "h"
            },
            {
              "type": "text",
              "text": "."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "Find the base area."
            },
            {
              "type": "display_math",
              "latex": "10\\times5=50\\text{ cm}^2"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 2,
          "content": [
            {
              "type": "text",
              "text": "Substitute into the volume formula."
            },
            {
              "type": "display_math",
              "latex": "300=\\frac13\\times50\\times h"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 3,
          "content": [
            {
              "type": "display_math",
              "latex": "h=\\frac{3\\times300}{50}=18\\text{ cm}"
            }
          ],
          "mark_type": "A",
          "mark_value": 1
        }
      ]
    }
  ],
