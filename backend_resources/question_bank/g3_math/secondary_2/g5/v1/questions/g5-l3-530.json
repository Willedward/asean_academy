      "label": null,
      "prompt": [
        {
          "type": "text",
          "text": "A solid cone is wrapped completely in gold foil. The closed cone has radius 10 cm and perpendicular height 24 cm. Find its total surface area in cm², correct to 1 decimal place, to give the area of foil."
        }
      ],
      "marks": 3,
      "primary_outcome": "5.6",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "rounded_dp",
        "canonical_answer": "1131.0",
        "canonical_latex": "1131.0",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": 1,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Find the slant height before calculating the curved area."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Use Pythagoras’ theorem for the slant height "
            },
            {
              "type": "inline_math",
              "latex": "l"
            },
            {
              "type": "text",
              "text": ", then add "
            },
            {
              "type": "inline_math",
              "latex": "\\pi rl"
            },
            {
              "type": "text",
              "text": " and "
            },
            {
              "type": "inline_math",
              "latex": "\\pi r^{2}"
            },
            {
              "type": "text",
              "text": "."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "The radius, perpendicular height and slant height form a right-angled triangle."
            },
            {
              "type": "display_math",
              "latex": "l=\\sqrt{10^2+24^2}=26\\text{ cm}"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 2,
          "content": [
            {
              "type": "text",
              "text": "Total surface area = curved area + base area."
            },
            {
              "type": "display_math",
              "latex": "S=\\pi(10)(26)+\\pi(10)^2=260\\pi+100\\pi=360\\pi"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 3,
          "content": [
            {
              "type": "display_math",
              "latex": "S=1130.973\\ldots=1131.0\\text{ cm}^2"
            }
          ],
          "mark_type": "A",
          "mark_value": 1
        }
      ]
    }
  ],
