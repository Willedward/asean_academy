      "label": null,
      "prompt": [
        {
          "type": "text",
          "text": "A balloon is inflated until it is larger but still round. The radius of a sphere is increased by 50%. Find the percentage increase in its volume, correct to 1 decimal place."
        }
      ],
      "marks": 4,
      "primary_outcome": "5.6",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "rounded_dp",
        "canonical_answer": "237.5",
        "canonical_latex": "237.5\\%",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": 1,
        "unit": {
          "canonical": "%",
          "accepted": [
            "%",
            "percent",
            "per cent"
          ],
          "required": false
        }
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Sphere volume is proportional to the cube of its radius."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Write the new radius as "
            },
            {
              "type": "inline_math",
              "latex": "1.5r"
            },
            {
              "type": "text",
              "text": " and compare the two volume formulas."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "A 50% increase multiplies the radius by 1.5."
            },
            {
              "type": "display_math",
              "latex": "R=1.5r"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 2,
          "content": [
            {
              "type": "text",
              "text": "Volume depends on the cube of the radius."
            },
            {
              "type": "display_math",
              "latex": "\\frac{V_{\\text{new}}}{V_{\\text{old}}}=\\frac{\\frac43\\pi(1.5r)^3}{\\frac43\\pi r^3}=1.5^3=3.375"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 3,
          "content": [
            {
              "type": "text",
              "text": "Convert the increase to a percentage."
            },
            {
              "type": "display_math",
              "latex": "(3.375-1)\\times100\\%"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 4,
          "content": [
            {
              "type": "display_math",
              "latex": "237.5\\%"
            }
          ],
          "mark_type": "A",
          "mark_value": 1
        }
      ]
    }
  ],
