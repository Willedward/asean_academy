      "prompt": [
        {
          "type": "text",
          "text": "A paper cup shaped as a cone is held with its vertex pointing down. The cone of height 21 cm is filled to eight twenty-sevenths of its full volume, and the liquid forms a cone similar to the cup. Find the depth of the liquid in cm."
        }
      ],
      "marks": 4,
      "primary_outcome": "5.6",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "14",
        "canonical_latex": "14",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": null,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "For similar solids, the volume ratio is the cube of the length ratio."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Write the volume ratio as "
            },
            {
              "type": "inline_math",
              "latex": "\\left(\\frac{h}{H}\\right)^{3}=\\frac{8}{27}"
            },
            {
              "type": "text",
              "text": ", where H is the full height, then solve for "
            },
            {
              "type": "inline_math",
              "latex": "h"
            },
            {
              "type": "text",
              "text": "."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "The liquid forms a cone similar to the container, so the volume ratio is the cube of the height ratio."
            },
            {
              "type": "display_math",
              "latex": "\\left(\\frac{h}{21}\\right)^3=\\frac{8}{27}"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 2,
          "content": [
            {
              "type": "text",
              "text": "Take the cube root of both sides."
            },
            {
              "type": "display_math",
              "latex": "\\frac{h}{21}=\\frac{2}{3}"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 3,
          "content": [
            {
              "type": "display_math",
              "latex": "h=21\\times\\frac{2}{3}"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 4,
          "content": [
            {
              "type": "display_math",
              "latex": "h=14\\text{ cm}"
            }
          ],
          "mark_type": "A",
          "mark_value": 1
        }
      ]
    }
  ],
