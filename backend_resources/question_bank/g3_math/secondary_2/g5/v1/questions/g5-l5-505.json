        {
          "type": "text",
          "text": "Quality inspectors considered restricted transport access while preparing a capacity check for the mountain weather shelter. Snow-free tropical mountain conditions still bring strong crosswinds. A scale model will be stored with the project documentation. A spherical object of radius 6 cm has a concentric spherical core of radius 3 cm removed. Find the percentage of the original volume that remains, correct to 1 decimal place."
        }
      ],
      "marks": 5,
      "primary_outcome": "5.6",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "rounded_dp",
        "canonical_answer": "87.5",
        "canonical_latex": "87.5",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": 1,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "The constant 4π/3 cancels in the volume fraction."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Compare R³ − r³ with R³, then multiply by 100%."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "Select the relevant dimensions and apply the mensuration relationship."
            },
            {
              "type": "display_math",
              "latex": "\\frac{6^3-3^3}{6^3}\\times100\\%=87.5\\%"
            }
          ],
          "mark_type": "M",
