      "position": 1,
      "label": null,
      "prompt": [
        {
          "type": "text",
          "text": "An ornament is made lighter by hollowing out its centre. The spherical object of radius 6 cm has a concentric spherical core of radius 3 cm removed. Find the percentage of the original volume that remains, correct to 1 decimal place."
        }
      ],
      "marks": 5,
      "primary_outcome": "5.6",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "rounded_dp",
        "canonical_answer": "87.5",
        "canonical_latex": "87.5\\%",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": 1,
        "unit": {
          "canonical": "%",
          "accepted": [
            "%",
            "percent",
            "per cent"
          ],
          "required": false
        }
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "The constant "
            },
            {
              "type": "inline_math",
              "latex": "\\frac{4\\pi}{3}"
            },
            {
              "type": "text",
              "text": " cancels in the volume fraction."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Compare "
            },
            {
              "type": "inline_math",
              "latex": "R^{3}-r^{3}"
            },
            {
              "type": "text",
              "text": " with "
            },
            {
              "type": "inline_math",
              "latex": "R^{3}"
            },
            {
              "type": "text",
              "text": ", then multiply by 100%."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "Original volume:"
            },
            {
              "type": "display_math",
              "latex": "\\frac43\\pi(6)^3"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 2,
          "content": [
            {
              "type": "text",
              "text": "Volume of the core:"
            },
            {
              "type": "display_math",
              "latex": "\\frac43\\pi(3)^3"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 3,
          "content": [
            {
              "type": "text",
              "text": "Fraction remaining; the factor 4π/3 cancels."
            },
            {
              "type": "display_math",
              "latex": "\\frac{6^3-3^3}{6^3}=\\frac{189}{216}"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 4,
          "content": [
            {
              "type": "display_math",
              "latex": "\\frac{189}{216}\\times100\\%"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 5,
          "content": [
            {
              "type": "display_math",
              "latex": "87.5\\%"
            }
          ],
          "mark_type": "A",
          "mark_value": 1
        }
      ]
    }
  ],
