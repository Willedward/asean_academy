        {
          "type": "text",
          "text": "A shallow dish filled with sauce is shaped as a cone. The cone has radius 8 cm and perpendicular height 6 cm. Find its volume in cm³, correct to 1 decimal place."
        }
      ],
      "marks": 2,
      "primary_outcome": "5.6",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "rounded_dp",
        "canonical_answer": "402.1",
        "canonical_latex": "402.1",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": 1,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Use the perpendicular height in the cone-volume formula."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Use "
            },
            {
              "type": "inline_math",
              "latex": "V=\\frac{1}{3}\\pi r^{2}h"
            },
            {
              "type": "text",
              "text": ", then round only the final answer."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "Volume of a cone:"
            },
            {
              "type": "display_math",
              "latex": "V=\\frac13\\pi(8)^2(6)=128\\pi"
            }
          ],
          "mark_type": "M",
