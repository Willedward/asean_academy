      "prompt": [
        {
          "type": "text",
          "text": "A spinning top is painted on its whole outside. Its cone of radius 9 cm and slant height 15 cm is joined base-to-base to a hemisphere of radius 9 cm. Find the external surface area in cm², correct to 1 decimal place."
        }
      ],
      "marks": 4,
      "primary_outcome": "5.6",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "rounded_dp",
        "canonical_answer": "933.1",
        "canonical_latex": "933.1",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": 1,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "The circular join is internal and must not be counted."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Add only the cone’s curved area and hemisphere’s curved area."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "Curved area of the cone:"
            },
            {
              "type": "display_math",
              "latex": "\\pi(9)(15)=135\\pi"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 2,
          "content": [
            {
              "type": "text",
              "text": "Curved area of the hemisphere:"
            },
            {
              "type": "display_math",
              "latex": "2\\pi(9)^2=162\\pi"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 3,
          "content": [
            {
              "type": "text",
              "text": "The joined circular faces are inside the solid, so add only the two curved areas."
            },
            {
              "type": "display_math",
              "latex": "S=135\\pi+162\\pi=297\\pi"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 4,
          "content": [
            {
              "type": "display_math",
              "latex": "S=933.053\\ldots=933.1\\text{ cm}^2"
            }
          ],
          "mark_type": "A",
          "mark_value": 1
        }
      ]
    }
