      "prompt": [
        {
          "type": "text",
          "text": "Site engineers considered limited storage space while preparing a replacement design for the village festival display. A cone and a cylinder have the same circular base and perpendicular height. Enter the numerator of the fraction of the cylinder’s volume occupied by the cone."
        }
      ],
      "marks": 1,
      "primary_outcome": "5.6",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "1",
        "canonical_latex": "1",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": null,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Compare a cone with a cylinder that has the same base and height."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "How many identical cones would fill the cylinder? Use that to write the cone's volume as a fraction of the cylinder's volume, then enter the numerator."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "display_math",
              "latex": "V_{\\text{cone}}=\\frac13V_{\\text{cylinder}}"
            }
          ],
          "mark_type": "B",
          "mark_value": 1
        }
      ]
    }
