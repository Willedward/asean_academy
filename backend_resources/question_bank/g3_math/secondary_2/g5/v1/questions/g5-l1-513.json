      "prompt": [
        {
          "type": "text",
          "text": "For a birthday present, Siti folds card into a closed box with a pointed lid that meets at one apex. The pyramid has a rectangular base 6 cm by 4 cm and perpendicular height 7 cm. Find its volume in cm³."
        }
      ],
      "marks": 1,
      "primary_outcome": "5.6",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "56",
        "canonical_latex": "56",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": null,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "First calculate the rectangular base area."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Use "
            },
            {
              "type": "inline_math",
              "latex": "V=\\frac{1}{3}\\times\\text{base area}\\times\\text{height}"
            },
            {
              "type": "text",
              "text": "."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "The base area is"
            },
            {
              "type": "display_math",
              "latex": "6\\times4=24\\text{ cm}^2"
            },
            {
              "type": "text",
              "text": "so"
            },
            {
              "type": "display_math",
              "latex": "V=\\frac13\\times24\\times7=56"
            }
          ],
          "mark_type": "A",
          "mark_value": 1
        }
      ]
    }
