        {
          "type": "text",
          "text": "Field researchers considered a narrow installation area while preparing a replacement design for the solar farm equipment cover. Cable trays run beneath the protective equipment cover. A later inspection will compare the finished dimensions with this record. Four solid spheres of radius 3 cm are melted and recast into identical cones of radius 2 cm and height 9 cm, with no material lost. How many complete cones are made?"
        }
      ],
      "marks": 5,
      "primary_outcome": "5.6",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "12",
        "canonical_latex": "12",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": null,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Total material volume is conserved during recasting."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Divide the volume of four spheres by the volume of one cone; π cancels."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "Select the relevant dimensions and apply the mensuration relationship."
            },
            {
              "type": "display_math",
              "latex": "n=\\frac{4(\\frac43\\pi(3)^3)}{\\frac13\\pi(2)^2(9)}=12"
            }
          ],
