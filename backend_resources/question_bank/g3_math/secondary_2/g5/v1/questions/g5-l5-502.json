      "prompt": [
        {
          "type": "text",
          "text": "A foundry recycles metal with no material lost. Four solid spheres of radius 3 cm are melted and recast into identical cones of radius 2 cm and height 9 cm, where 9 cm is the perpendicular height. How many complete cones are made?"
        }
      ],
      "marks": 5,
      "primary_outcome": "5.6",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "12",
        "canonical_latex": "12",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": null,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Total material volume is conserved during recasting."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Divide the volume of four spheres by the volume of one cone; π cancels."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "Volume of one sphere:"
            },
            {
              "type": "display_math",
              "latex": "\\frac43\\pi(3)^3=36\\pi"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 2,
          "content": [
            {
              "type": "text",
              "text": "Volume of the four spheres:"
            },
            {
              "type": "display_math",
              "latex": "4\\times36\\pi=144\\pi"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 3,
          "content": [
            {
              "type": "text",
              "text": "Volume of one cone:"
            },
            {
              "type": "display_math",
              "latex": "\\frac13\\pi(2)^2(9)=12\\pi"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 4,
          "content": [
            {
              "type": "text",
              "text": "Divide the total volume by the volume of one cone."
            },
            {
              "type": "display_math",
              "latex": "\\frac{144\\pi}{12\\pi}=12"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 5,
          "content": [
            {
              "type": "display_math",
              "latex": "12\\text{ cones}"
            }
          ],
          "mark_type": "A",
          "mark_value": 1
        }
      ]
    }
