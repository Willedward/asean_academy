        {
          "type": "text",
          "text": "Survey crew considered high daytime temperatures while preparing a replacement design for the sports hall roof model. Roof trusses leave a fixed clearance above the indoor court. A later inspection will compare the finished dimensions with this record. A closed cone has radius 9 cm and perpendicular height 12 cm. Find its total surface area in cm², correct to 1 decimal place."
        }
      ],
      "marks": 3,
      "primary_outcome": "5.6",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "rounded_dp",
        "canonical_answer": "678.6",
        "canonical_latex": "678.6",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": 1,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Find the slant height before calculating the curved area."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Use "
            },
            {
              "type": "inline_math",
              "latex": "l=\\sqrt{9^{2}+12^{2}}"
            },
            {
              "type": "text",
              "text": ", then add "
            },
            {
              "type": "inline_math",
              "latex": "\\pi rl"
            },
            {
              "type": "text",
              "text": " and "
            },
            {
              "type": "inline_math",
              "latex": "\\pi r^{2}"
            },
            {
              "type": "text",
              "text": "."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "Select the relevant dimensions and apply the mensuration relationship."
            },
            {
              "type": "display_math",
              "latex": "l=\\sqrt{9^2+12^2}=15,\\quad S=\\pi(9)(15)+\\pi(9)^2=678.6"
            }
          ],
          "mark_type": "M",
          "mark_value": 2
        },
        {
