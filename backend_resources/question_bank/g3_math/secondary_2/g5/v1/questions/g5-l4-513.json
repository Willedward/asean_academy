        "canonical_latex": "72.8\\%",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": 1,
        "unit": {
          "canonical": "%",
          "accepted": [
            "%",
            "percent",
            "per cent"
          ],
          "required": false
        }
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Sphere volume is proportional to the cube of its radius."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Cube the radius scale factor 1.2, subtract 1, then convert to a percentage."
            }
          ]
        }
      ],
      "solution": [
