            {
              "type": "text",
              "text": "Sphere volume is proportional to the cube of its radius."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Cube the radius scale factor 1.2, subtract 1, then convert to a percentage."
