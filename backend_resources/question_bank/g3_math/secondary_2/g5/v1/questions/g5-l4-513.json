        {
          "type": "text",
          "text": "Maintenance team considered restricted transport access while preparing a capacity check for the island rescue marker. Reflective panels must stay visible from the island landing point. A scale model will be stored with the project documentation. The radius of a sphere is increased by 20%. Find the percentage increase in its volume, correct to 1 decimal place."
        }
      ],
      "marks": 4,
      "primary_outcome": "5.6",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "rounded_dp",
