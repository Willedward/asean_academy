      "prompt": [
        {
          "type": "text",
          "text": "A gardener lines a hanging basket with moss. The basket is an open hemisphere, and the open hemisphere has radius 10 cm. Its curved surface area is kπ cm². Find k."
        }
      ],
      "marks": 1,
      "primary_outcome": "5.6",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "200",
        "canonical_latex": "200",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": null,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "An open hemisphere uses only half the sphere’s curved surface."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Halve the sphere’s surface-area formula to get "
            },
            {
              "type": "inline_math",
              "latex": "2\\pi r^{2}"
            },
            {
              "type": "text",
              "text": ", then compare with "
            },
            {
              "type": "inline_math",
              "latex": "k\\pi"
            },
            {
              "type": "text",
              "text": "."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "display_math",
              "latex": "A=\\tfrac12\\times4\\pi(10)^2=2\\pi(10)^2=200\\pi"
            },
            {
              "type": "text",
              "text": "so k = 200."
            }
          ],
          "mark_type": "A",
          "mark_value": 1
        }
      ]
    }
