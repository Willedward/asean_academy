        {
          "type": "text",
          "text": "Maintenance team considered limited storage space while preparing a capacity check for the island rescue marker. Reflective panels must stay visible from the island landing point. The design must also be explained clearly in the safety briefing. A solid is formed by joining a cone of radius 8 cm and height 15 cm to a hemisphere of the same radius. Find the total volume in cm³, correct to 1 decimal place."
        }
      ],
      "marks": 3,
      "primary_outcome": "5.6",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "rounded_dp",
        "canonical_answer": "2077.6",
        "canonical_latex": "2077.6",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": 1,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "The join does not change volume; add the two component volumes."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Add the cone volume to half of a sphere’s volume."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "Select the relevant dimensions and apply the mensuration relationship."
            },
            {
              "type": "display_math",
              "latex": "V=\\frac13\\pi(8)^2(15)+\\frac23\\pi(8)^3=2077.6"
            }
          ],
