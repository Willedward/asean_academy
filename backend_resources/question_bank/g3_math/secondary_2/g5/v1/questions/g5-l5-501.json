      "label": null,
      "prompt": [
        {
          "type": "text",
          "text": "A jeweller melts a solid metal ball and recasts all of it, with no metal lost, as a solid cone. The cone and a sphere both have radius 3 cm. The cone has the same volume as the sphere. Find the cone’s perpendicular height in cm."
        }
      ],
      "marks": 5,
      "primary_outcome": "5.6",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "12",
        "canonical_latex": "12",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": null,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Equate the two volume formulas before cancelling common factors."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Cancel the common factors π and "
            },
            {
              "type": "inline_math",
              "latex": "r^{2}"
            },
            {
              "type": "text",
              "text": " before substituting "
            },
            {
              "type": "inline_math",
              "latex": "r=3"
            },
            {
              "type": "text",
              "text": "."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "Volume of the sphere:"
            },
            {
              "type": "display_math",
              "latex": "\\frac43\\pi(3)^3=36\\pi"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 2,
          "content": [
            {
              "type": "text",
              "text": "Volume of the cone with height h:"
            },
            {
              "type": "display_math",
              "latex": "\\frac13\\pi(3)^2h=3\\pih"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 3,
          "content": [
            {
              "type": "text",
              "text": "No metal is lost, so the volumes are equal."
            },
            {
              "type": "display_math",
              "latex": "3\\pih=36\\pi"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 4,
          "content": [
            {
              "type": "display_math",
              "latex": "h=\\frac{36}{3}"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 5,
          "content": [
            {
              "type": "display_math",
              "latex": "h=12\\text{ cm}"
            }
          ],
          "mark_type": "A",
          "mark_value": 1
        }
      ]
    }
  ],
