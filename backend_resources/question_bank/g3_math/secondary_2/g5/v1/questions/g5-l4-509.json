      "prompt": [
        {
          "type": "text",
          "text": "Student designers considered heavy seasonal rainfall while preparing a capacity check for the public library sculpture. Visitors can walk around the sculpture but cannot touch it. The design must also be explained clearly in the safety briefing. The radius of a sphere is increased by 50%. Find the percentage increase in its volume, correct to 1 decimal place."
        }
      ],
      "marks": 4,
      "primary_outcome": "5.6",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "rounded_dp",
        "canonical_answer": "237.5",
        "canonical_latex": "237.5\\%",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": 1,
        "unit": {
          "canonical": "%",
          "accepted": [
            "%",
            "percent",
            "per cent"
          ],
          "required": false
        }
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Sphere volume is proportional to the cube of its radius."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Cube the radius scale factor 1.5, subtract 1, then convert to a percentage."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "Select the relevant dimensions and apply the mensuration relationship."
            },
            {
