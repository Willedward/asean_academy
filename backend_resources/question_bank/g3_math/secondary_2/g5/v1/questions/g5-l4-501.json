      "prompt": [
        {
          "type": "text",
          "text": "A metal ball is hollow inside. The hollow spherical shell has outer radius 5 cm and inner radius 3 cm. Find the volume of metal in cm³, correct to 1 decimal place."
        }
      ],
      "marks": 4,
      "primary_outcome": "5.6",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "rounded_dp",
        "canonical_answer": "410.5",
        "canonical_latex": "410.5",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": 1,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "The material is the outer sphere with the inner space removed."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Subtract the inner sphere’s volume from the outer sphere’s volume."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "Volume of the outer sphere:"
            },
            {
              "type": "display_math",
              "latex": "\\frac43\\pi(5)^3=\\frac{500}{3}\\pi"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 2,
          "content": [
            {
              "type": "text",
              "text": "Volume of the inner space:"
            },
            {
              "type": "display_math",
              "latex": "\\frac43\\pi(3)^3=36\\pi"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 3,
          "content": [
            {
              "type": "text",
              "text": "Subtract."
            },
            {
              "type": "display_math",
              "latex": "V=\\frac{500}{3}\\pi-36\\pi=\\frac{392}{3}\\pi=410.501\\ldots"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 4,
          "content": [
            {
              "type": "display_math",
              "latex": "V=410.5\\text{ cm}^3"
            }
          ],
          "mark_type": "A",
          "mark_value": 1
        }
      ]
    }
