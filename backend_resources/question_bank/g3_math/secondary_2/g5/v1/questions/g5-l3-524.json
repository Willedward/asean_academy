      "label": null,
      "prompt": [
        {
          "type": "text",
          "text": "A doorstop is a flat solid cone. The closed cone has radius 12 cm and perpendicular height 5 cm. Find its total surface area in cm², correct to 1 decimal place."
        }
      ],
      "marks": 3,
      "primary_outcome": "5.6",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "rounded_dp",
        "canonical_answer": "942.5",
        "canonical_latex": "942.5",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": 1,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Find the slant height before calculating the curved area."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Use Pythagoras’ theorem for the slant height "
            },
            {
              "type": "inline_math",
              "latex": "l"
            },
            {
              "type": "text",
              "text": ", then add "
            },
            {
              "type": "inline_math",
              "latex": "\\pi rl"
            },
            {
              "type": "text",
              "text": " and "
            },
            {
              "type": "inline_math",
              "latex": "\\pi r^{2}"
            },
            {
              "type": "text",
              "text": "."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "The radius, perpendicular height and slant height form a right-angled triangle."
            },
            {
              "type": "display_math",
              "latex": "l=\\sqrt{12^2+5^2}=13\\text{ cm}"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 2,
          "content": [
            {
              "type": "text",
              "text": "Total surface area = curved area + base area."
            },
            {
              "type": "display_math",
              "latex": "S=\\pi(12)(13)+\\pi(12)^2=156\\pi+144\\pi=300\\pi"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 3,
          "content": [
            {
              "type": "display_math",
              "latex": "S=942.478\\ldots=942.5\\text{ cm}^2"
            }
          ],
          "mark_type": "A",
          "mark_value": 1
        }
      ]
    }
  ],
