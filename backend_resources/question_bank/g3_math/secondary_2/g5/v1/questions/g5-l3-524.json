          "content": [
            {
              "type": "text",
              "text": "Find the slant height before calculating the curved area."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Use l = √(6² + 8²), then add πrl and πr²."
            }
          ]
        }
      ],
      "solution": [
