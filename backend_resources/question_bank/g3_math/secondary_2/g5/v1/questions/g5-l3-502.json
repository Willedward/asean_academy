      "label": null,
      "prompt": [
        {
          "type": "text",
          "text": "A toy spinning top is a solid made by joining a cone of radius 3 cm and height 4 cm to a hemisphere of the same radius. The height given is the perpendicular height of the cone. Find the total volume in cm³, correct to 1 decimal place."
        }
      ],
      "marks": 3,
      "primary_outcome": "5.6",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "rounded_dp",
        "canonical_answer": "94.2",
        "canonical_latex": "94.2",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": 1,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "The join does not change volume; add the two component volumes."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Add the cone volume to half of a sphere’s volume."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "Volume of the cone:"
            },
            {
              "type": "display_math",
              "latex": "\\frac13\\pi(3)^2(4)=12\\pi"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 2,
          "content": [
            {
              "type": "text",
              "text": "Volume of the hemisphere, half of a sphere of the same radius:"
            },
            {
              "type": "display_math",
              "latex": "\\frac12\\times\\frac43\\pi(3)^3=18\\pi"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 3,
          "content": [
            {
              "type": "text",
              "text": "Add the two volumes."
            },
            {
              "type": "display_math",
              "latex": "V=30\\pi=94.248\\ldots=94.2\\text{ cm}^3"
            }
          ],
          "mark_type": "A",
          "mark_value": 1
        }
      ]
    }
  ],
