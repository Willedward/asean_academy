      "prompt": [
        {
          "type": "text",
          "text": "The exterior angles of two regular polygons are in the ratio 2:3. The polygon with the smaller exterior angle has five more sides than the other polygon. Find the larger number of sides."
        }
      ],
      "marks": 3,
      "primary_outcome": "1.6",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "15",
        "canonical_latex": "15",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": null,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Let the exterior angles be 2k° and 3k°."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Their side counts are 180/k and 120/k; use their difference of 5."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "display_math",
              "latex": "\\frac{180}{k}-\\frac{120}{k}=5"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 2,
          "content": [
            {
              "type": "display_math",
              "latex": "\\frac{60}{k}=5\\Rightarrow k=12"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 3,
          "content": [
            {
              "type": "display_math",
              "latex": "\\frac{180}{12}=15"
            }
          ],
