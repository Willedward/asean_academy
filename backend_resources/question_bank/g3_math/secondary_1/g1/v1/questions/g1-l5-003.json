          "content": [
            {
              "type": "text",
              "text": "Let the exterior angles be 2k\u00b0 and 3k\u00b0."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Their side counts are 180/k and 120/k; use their difference of 5."
            }
          ]
        }
      ],
      "solution": [
