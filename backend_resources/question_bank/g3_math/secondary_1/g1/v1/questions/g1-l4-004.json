        {
          "type": "text",
          "text": "The sum of all but one of the interior angles of a convex polygon is 1900°. Find the number of sides of the polygon."
        }
      ],
      "marks": 3,
      "primary_outcome": "1.6",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
