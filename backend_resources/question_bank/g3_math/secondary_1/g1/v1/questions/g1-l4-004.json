      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "The full interior-angle sum is a multiple of 180°, and it is more than 1900° by less than 180°."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Use "
            },
            {
              "type": "inline_math",
              "latex": "(n-2)180"
            },
            {
              "type": "text",
              "text": " for the full sum and find the multiple of 180° that fits."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "inline_math",
              "latex": "(n-2)180=1900+a"
            },
            {
              "type": "text",
              "text": ", where "
            },
            {
              "type": "inline_math",
              "latex": "0<a<180"
