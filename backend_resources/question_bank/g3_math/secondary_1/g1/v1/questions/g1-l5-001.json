        {
          "type": "text",
          "text": "Two parallel horizontal lines are crossed by two transversals that meet between them. One transversal makes an acute angle of 38° with the parallels and the other makes an acute angle of 67° on the opposite side. Find, in degrees, the angle between the upward rays of the transversals."
        }
      ],
      "marks": 3,
      "primary_outcome": "1.3",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "75",
        "canonical_latex": "75",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": null,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Draw a line through the meeting point, parallel to the given lines."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Use alternate angles at the meeting point, then the fact that the three angles on the new line lie on a straight line."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "Draw a line through P parallel to the given lines. Alternate angles give 38° and 67° at P, on either side of x."
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 2,
          "content": [
            {
              "type": "inline_math",
              "latex": "38^\\circ+x+67^\\circ=180^\\circ"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
