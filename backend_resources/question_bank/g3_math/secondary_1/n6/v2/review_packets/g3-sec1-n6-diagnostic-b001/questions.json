        "marks": 3,
        "primary_outcome": "6.3",
        "secondary_outcomes": [],
        "response": {
          "type": "numeric",
          "comparison_mode": "exact_numeric",
          "canonical_answer": "24",
          "canonical_latex": "24",
          "accepted_answers": [],
          "absolute_tolerance": null,
          "rounding_precision": null,
          "unit": null
        },
        "hints": [
          {
            "stage": 1,
            "content": [
              {
                "type": "text",
                "text": "Use the change in y divided by the change in x to find a."
              }
            ]
          },
          {
            "stage": 2,
            "content": [
              {
                "type": "text",
                "text": "First find a = -15/5. Then substitute x = 2 and y = 9 to find b."
