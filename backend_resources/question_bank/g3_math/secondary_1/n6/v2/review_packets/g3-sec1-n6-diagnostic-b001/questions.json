      },
      {
        "type": "text",
        "text": "M is the midpoint of AB. Point M is translated 5 units to the right and 1 unit down to point N."
      }
    ],
    "parts": [
      {
        "position": 1,
        "label": null,
        "prompt": [
          {
            "type": "text",
            "text": "Find the sum of the x-coordinate and y-coordinate of N."
          }
        ],
        "marks": 3,
        "primary_outcome": "6.1",
        "secondary_outcomes": [],
        "response": {
          "type": "numeric",
          "comparison_mode": "exact_numeric",
          "canonical_answer": "4",
