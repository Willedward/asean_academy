        "hints": [
          {
            "stage": 1,
            "content": [
              {
                "type": "text",
                "text": "Read A and B from the grid, then average their corresponding coordinates to find M."
              }
            ]
          },
          {
            "stage": 2,
            "content": [
              {
                "type": "text",
                "text": "A is (-5, 4) and B is (3, -2), so first find their midpoint before applying the translation."
              }
            ]
