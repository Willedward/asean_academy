    "stem": [
      {
        "type": "text",
        "text": "A linear function has the form y = ax + b. When x increases by 5, y decreases by 15. The function also has y = 9 when x = 2."
      }
    ],
    "parts": [
      {
        "position": 1,
        "label": null,
        "prompt": [
          {
            "type": "text",
            "text": "Find the value of y when x = -3."
