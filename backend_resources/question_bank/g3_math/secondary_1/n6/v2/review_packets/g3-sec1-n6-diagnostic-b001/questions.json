            "mark_type": "M",
            "mark_value": 1
          },
          {
            "position": 3,
            "content": [
              {
                "type": "display_math",
                "latex": "y=-3(-3)+15=24"
              }
            ],
            "mark_type": "A",
            "mark_value": 1
