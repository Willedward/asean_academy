      "prompt": [
        {
          "type": "text",
          "text": "A 8 cm by 6 cm by 3 cm cuboid has a 4 cm by 3 cm by 2 cm cuboid attached on top. Their contact face is 4 cm by 3 cm. Find the exposed surface area in cm². Enter the numerical value only."
        }
      ],
      "marks": 3,
      "primary_outcome": "5.5",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "208",
        "canonical_latex": "208",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": null,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Add both surface areas and subtract twice the contact area."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "The surface areas are 180 cm² and 52 cm²; check their sum carefully."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "display_math",
              "latex": "S_1=2(8(6)+8(3)+6(3))=180"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 2,
          "content": [
            {
              "type": "display_math",
              "latex": "S_2=2(4(3)+4(2)+3(2))=52"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 3,
          "content": [
            {
              "type": "display_math",
              "latex": "S=180+52-2(12)=208"
            }
          ],
          "mark_type": "A",
          "mark_value": 1
        }
      ]
    }
