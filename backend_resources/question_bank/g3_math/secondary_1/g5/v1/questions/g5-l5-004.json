          "type": "text",
          "text": "A storage box measures 1.2 m by 80 cm by 50 cm. Identical cubes of side 10 cm fill 75% of its volume. How many cubes are used? Enter the numerical value only."
        }
      ],
      "marks": 5,
      "primary_outcome": "5.4",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "360",
        "canonical_latex": "360",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": null,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Express all box dimensions in centimetres and find 75% of its volume."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Divide the occupied volume by "
            },
            {
              "type": "inline_math",
              "latex": "10^{3}\\text{ cm}^{3}"
            },
            {
              "type": "text",
              "text": " per cube."
            }
          ]
        }
      ],
      "solution": [
