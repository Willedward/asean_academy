          "type": "text",
          "text": "A cube of side 14 cm has a cylindrical hole of radius 3.5 cm drilled straight through it. Using π = 22/7, find the remaining volume in cm³. Enter the numerical value only."
        }
      ],
      "marks": 5,
      "primary_outcome": "5.5",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "2205",
