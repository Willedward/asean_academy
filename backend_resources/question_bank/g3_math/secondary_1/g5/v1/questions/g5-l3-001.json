        "rounding_precision": null,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Calculate the two areas separately."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Use base × height for the parallelogram and the trapezium area formula for the trapezium, then add the two areas."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
