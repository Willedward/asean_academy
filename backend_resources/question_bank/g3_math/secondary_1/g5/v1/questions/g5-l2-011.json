      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Trace all six exposed edges around the L-shape."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "The edge lengths are 7, 4, 5, 6, 12 and 10 cm."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "The exposed edges are 12 and 10 cm, the shortened sides 12 − 5 = 7 cm and 10 − 4 = 6 cm, and the two cut edges 5 and 4 cm."
            },
            {
              "type": "display_math",
              "latex": "P=12+10+7+6+5+4"
