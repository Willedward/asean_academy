      "prompt": [
        {
          "type": "text",
          "text": "A 14 cm by 14 cm by 10 cm cuboid has a cylindrical hole of radius 3.5 cm drilled through its 10 cm height. Using "
        },
        {
          "type": "inline_math",
          "latex": "\\pi=\\frac{22}{7}"
        },
        {
          "type": "text",
          "text": ", find the remaining volume in cm³. Enter the numerical value only."
        }
      ],
      "marks": 4,
      "primary_outcome": "5.5",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "1575",
        "canonical_latex": "1575",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": null,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Subtract the cylindrical hole volume from the cuboid volume."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "The cuboid volume is 1960 cm³. Now find the volume of the hole, then subtract it."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "display_math",
              "latex": "V=14(14)(10)-\\frac{22}{7}(3.5^2)(10)=1960-385"
            }
          ],
