        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Add both surface areas, then remove both copies of the contact face."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "The cuboid has surface area 376 cm². Find the surface area of the cube, add the two, then subtract two lots of the 4 cm by 4 cm contact face."
            }
          ]
        }
      ],
      "solution": [
