          "type": "text",
          "text": "A cube of side 4 cm is attached by one face to a 10 cm by 8 cm by 6 cm cuboid. Find the total exposed surface area in cm². Enter the numerical value only."
        }
      ],
      "marks": 4,
      "primary_outcome": "5.5",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
