      "prompt": [
        {
          "type": "text",
          "text": "The two bars in the figure have the widths and heights shown. If viewers compare ink area, how many times as large as the narrow bar's area is the wide bar's area? Enter the numerical value only."
        }
      ],
      "marks": 3,
      "primary_outcome": "1.4",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "2.5",
        "canonical_latex": "2.5",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": null,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Bar area is width × height."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "The equal heights cancel, so compare the two widths."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "Area of the wide bar is "
            },
            {
              "type": "inline_math",
              "latex": "5\\times8=40"
            },
            {
              "type": "text",
              "text": " and area of the narrow bar is "
            },
            {
              "type": "inline_math",
              "latex": "2\\times8=16"
            },
            {
              "type": "text",
              "text": "."
            }
          ],
          "mark_type": "M",
          "mark_value": 2
        },
        {
          "position": 2,
          "content": [
            {
              "type": "inline_math",
              "latex": "\\frac{40}{16}=2.5"
            }
          ],
          "mark_type": "A",
          "mark_value": 1
        }
      ]
    }
