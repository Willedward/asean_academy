              "type": "inline_math",
              "latex": "\\frac{135}{360}\\times480=180"
            },
            {
              "type": "text",
              "text": ", so "
            },
            {
              "type": "inline_math",
              "latex": "x=180-54-46=80"
            },
            {
              "type": "text",
              "text": "."
            }
          ],
