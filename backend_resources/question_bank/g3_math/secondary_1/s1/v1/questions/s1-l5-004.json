        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": null,
        "unit": {
          "canonical": "%",
          "accepted": [
            "%",
            "percent",
            "per cent"
          ],
          "required": false
        }
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "First find the number of sports club members, then the value of x."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Use the bar-chart total to find x, then express the competing swimmers as a percentage of x."
            }
          ]
