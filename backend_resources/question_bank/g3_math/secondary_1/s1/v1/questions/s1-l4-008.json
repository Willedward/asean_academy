      "prompt": [
        {
          "type": "text",
          "text": "A designer uses square icons whose side lengths are proportional to data values. The values are 12 and 30. If the smaller square has area 16 cm², find the area the larger square would have under this misleading rule. Enter the numerical value only."
        }
      ],
      "marks": 4,
      "primary_outcome": "1.4",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "100",
        "canonical_latex": "100",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": null,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Find the side-length scale factor "
            },
            {
              "type": "inline_math",
              "latex": "\\frac{30}{12}"
            },
            {
              "type": "text",
              "text": "."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Area scales with the square of that factor."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "The side-length scale factor is "
            },
            {
              "type": "inline_math",
              "latex": "\\frac{30}{12}=\\frac{5}{2}"
            },
            {
              "type": "text",
              "text": ", so the area scale factor is "
            },
            {
              "type": "inline_math",
              "latex": "\\left(\\frac{5}{2}\\right)^2=\\frac{25}{4}"
            },
            {
              "type": "text",
              "text": "."
            }
          ],
          "mark_type": "M",
          "mark_value": 3
        },
        {
          "position": 2,
          "content": [
            {
              "type": "inline_math",
              "latex": "\\frac{25}{4}\\times16=100"
            }
          ],
          "mark_type": "A",
          "mark_value": 1
        }
      ]
    }
