          "content": [
            {
              "type": "text",
              "text": "Find the total number of cycling students from the sector angle."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Use the key to convert each class's icons to students, then subtract both classes from the total."
            }
          ]
        }
      ],
      "solution": [
