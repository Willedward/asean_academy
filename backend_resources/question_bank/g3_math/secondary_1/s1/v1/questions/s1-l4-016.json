      "prompt": [
        {
          "type": "text",
          "text": "On this timeline, every gap between neighbouring labelled years is drawn 2 cm long. If 2 cm is meant to represent one year, how many cm longer should the whole timeline be to be drawn to scale? Enter the numerical value only."
        }
      ],
      "marks": 4,
      "primary_outcome": "1.4",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "8",
        "canonical_latex": "8",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": null,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Work out how long each gap should be, using 2 cm for one year."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Add the correct lengths of the three gaps, then subtract the length actually drawn."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "The gaps cover 1, 4 and 2 years, so they should be 2 cm, 8 cm and 4 cm: 14 cm in total. The drawn timeline is "
            },
            {
              "type": "inline_math",
              "latex": "3\\times2=6"
            },
            {
              "type": "text",
              "text": " cm."
            }
          ],
          "mark_type": "M",
          "mark_value": 3
        },
        {
          "position": 2,
          "content": [
            {
              "type": "inline_math",
              "latex": "14-6=8"
            }
          ],
          "mark_type": "A",
          "mark_value": 1
        }
      ]
