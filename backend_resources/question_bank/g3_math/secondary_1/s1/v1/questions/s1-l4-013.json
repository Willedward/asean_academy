        {
          "type": "text",
          "text": "A school samples 30 students from each of four levels. Response rates are 90%, 80%, 70% and 60% respectively. After 6 incomplete responses are removed from those received, what percentage of the students sampled gave a complete response? Enter the percentage without the % sign."
        }
      ],
      "marks": 4,
      "primary_outcome": "1.1",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "70",
        "canonical_latex": "70",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": null,
        "unit": {
          "canonical": "%",
          "accepted": [
            "%",
