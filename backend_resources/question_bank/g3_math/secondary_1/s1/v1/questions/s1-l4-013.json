        }
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Find the number of responses from each level, then the total."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Remove the 6 incomplete responses, then compare the number that remain with the 120 students sampled."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "Responses received: "
            },
            {
              "type": "inline_math",
              "latex": "30(0.9+0.8+0.7+0.6)=90"
            },
            {
              "type": "text",
              "text": ". Complete responses: "
            },
            {
              "type": "inline_math",
              "latex": "90-6=84"
            },
            {
              "type": "text",
              "text": "."
            }
          ],
          "mark_type": "M",
          "mark_value": 3
        },
        {
          "position": 2,
          "content": [
            {
              "type": "inline_math",
              "latex": "\\frac{84}{120}\\times100=70"
            }
          ],
