      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Compute the year 2 to 4 rise and the year 1 to 5 change separately."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Subtract the full-period percentage from the selected-period percentage."
            }
          ]
        }
      ],
      "solution": [
