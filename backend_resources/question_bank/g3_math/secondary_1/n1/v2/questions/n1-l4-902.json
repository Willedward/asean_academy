  "stem": [
    {
      "type": "text",
      "text": "N is a positive perfect square greater than 180. The highest common factor of N and 180 is 36."
    }
  ],
  "parts": [
    {
      "position": 1,
      "label": null,
      "prompt": [
        {
          "type": "text",
          "text": "Find the least possible value of N."
        }
      ],
      "marks": 4,
      "primary_outcome": "1.2",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "324",
        "canonical_latex": "324",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": null,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Write 180 and 36 as products of prime factors, then use the HCF condition to constrain the prime factors of N."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "N can be written as 36m², where m is not divisible by 5. Find the least m for which 36m² is greater than 180."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "display_math",
              "latex": "180=2^2\\times3^2\\times5,\\qquad36=2^2\\times3^2"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 2,
          "content": [
            {
              "type": "text",
              "text": "Because N is a perfect square and its HCF with 180 is 36, write N=36m², where m is not divisible by 5."
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 3,
          "content": [
            {
              "type": "display_math",
              "latex": "36m^2>180\\implies m^2>5"
            },
            {
              "type": "text",
              "text": "The least possible integer value of m is 3."
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 4,
          "content": [
            {
              "type": "display_math",
              "latex": "N=36\\times3^2=324"
            },
            {
              "type": "text",
              "text": "Indeed, 324 is a perfect square and HCF(324, 180)=36."
            }
          ],
          "mark_type": "A",
          "mark_value": 1
        }
      ]
    }
  ],
