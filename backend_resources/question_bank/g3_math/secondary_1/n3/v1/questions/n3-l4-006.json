          "type": "text",
          "text": "A shop marks up an item's cost price by 25% to obtain its marked price. During a sale, it gives a 10% discount on the marked price and sells the item for S$270. Find the profit as a percentage of the cost price."
        }
      ],
      "marks": 4,
      "primary_outcome": "3.6",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "12.5",
        "canonical_latex": "12.5\\%",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": null,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Relate the selling price to the cost price using both percentage multipliers."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "If the cost price is C, then the sale price is 1.25C multiplied by 0.90."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "display_math",
              "latex": "1.25C\\times0.90=270"
