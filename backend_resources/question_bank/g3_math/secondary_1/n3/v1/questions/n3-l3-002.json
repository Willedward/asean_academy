      "prompt": [
        {
          "type": "text",
          "text": "Parcel P has a total mass of 1.8 kg, including 150 g of packaging. Parcel Q contains 1.5 kg of goods with no packaging included in its stated mass. By what percentage is the mass of goods in Parcel P greater than the mass of goods in Parcel Q?"
        }
      ],
      "marks": 3,
      "primary_outcome": "3.2",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "10",
        "canonical_latex": "10\\%",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": null,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Find the mass of goods in Parcel P and express both goods masses in the same unit."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Convert 1.8 kg to 1800 g, subtract the 150 g packaging, then compare the difference with 1500 g."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "display_math",
              "latex": "1.8\\text{ kg}=1800\\text{ g},\\quad1800-150=1650\\text{ g}"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 2,
          "content": [
            {
              "type": "display_math",
              "latex": "1650-1500=150\\text{ g}"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 3,
          "content": [
            {
              "type": "display_math",
              "latex": "\\frac{150}{1500}\\times100\\%=10\\%"
            }
          ],
          "mark_type": "A",
          "mark_value": 1
        }
      ]
    }
  ],
