    {
      "type": "text",
      "text": "A club has 600 members, of whom 40% are women. The following year, total membership increases by 25% and the number of women increases by 50%."
    }
  ],
  "parts": [
    {
      "position": 1,
      "label": "a",
      "prompt": [
        {
          "type": "text",
          "text": "Find the percentage of members who are women in the following year."
        }
