          "positive ratio terms"
        ],
        "accepted_equivalents": [],
        "checker_config": {
          "terms": 2,
          "require_simplest_integer_terms": true
        }
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Find the original numbers of red and blue counters before applying the removal."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Each ratio part represents 18 counters. After finding the original blue count, keep two thirds of it."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "display_math",
              "latex": "198\\div(4+7)=18,\\quad R=72,\\ B=126"
