          "type": "text",
          "text": "Red and blue counters are in the ratio 4:7, with 198 counters altogether. One third of the blue counters are removed. No red counters are removed. Find the ratio of red counters to blue counters remaining, in its simplest form."
        }
      ],
      "marks": 3,
      "primary_outcome": "2.3",
      "secondary_outcomes": [],
      "response": {
        "type": "algebraic_expression",
        "comparison_mode": "exact_ratio",
        "canonical_expression": "6:7",
        "canonical_latex": "6:7",
        "variables": [],
