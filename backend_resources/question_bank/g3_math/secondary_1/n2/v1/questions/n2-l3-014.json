        },
        {
          "position": 2,
          "content": [
            {
              "type": "display_math",
              "latex": "B_{\\text{remaining}}=\\frac23\\times126=84"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 3,
          "content": [
            {
              "type": "display_math",
              "latex": "72:84=6:7"
            }
          ],
