        {
          "type": "text",
          "text": "Red and blue beads are in the ratio 3:5, with 96 beads altogether. Twelve red beads are added. Some blue beads are then removed so that the new ratio of red to blue is 4:3. How many blue beads are removed?"
        }
      ],
      "marks": 3,
      "primary_outcome": "2.3",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "24",
        "canonical_latex": "24",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": null,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Find the original numbers of red and blue beads, then update the red count."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Originally there are 36 red and 60 blue beads. After adding red beads, 48 corresponds to 4 parts in the new ratio."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "display_math",
              "latex": "\\text{red}=96\\times\\frac38=36,\\quad\\text{blue}=60"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 2,
          "content": [
            {
              "type": "display_math",
              "latex": "\\text{new red}=36+12=48"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 3,
          "content": [
            {
              "type": "display_math",
              "latex": "\\text{new blue}=48\\times\\frac34=36\\Rightarrow60-36=24"
            }
          ],
          "mark_type": "A",
          "mark_value": 1
        }
      ]
    }
