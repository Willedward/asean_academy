  "stem": [
    {
      "type": "text",
      "text": "Tap A delivers 2.4 litres of water in 36 seconds. Tap B delivers 1.75 litres of water in 30 seconds. Both taps deliver water at constant rates."
    }
  ],
  "parts": [
    {
      "position": 1,
      "label": null,
      "prompt": [
        {
          "type": "text",
          "text": "Write the ratio of the delivery rate of Tap A to the delivery rate of Tap B in its simplest positive integer form."
        }
      ],
      "marks": 3,
      "primary_outcome": "2.2",
      "secondary_outcomes": [],
      "response": {
        "type": "algebraic_expression",
        "comparison_mode": "exact_ratio",
        "canonical_expression": "8:7",
        "canonical_latex": "8:7",
        "variables": [],
        "domain_constraints": [
          "positive ratio terms"
        ],
        "accepted_equivalents": [],
        "checker_config": {
          "terms": 2,
          "require_simplest_integer_terms": true
        }
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Find each tap's volume delivered per second before forming the ratio."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "The rates are 2.4/36 and 1.75/30 litres per second. Express both rates with a common denominator."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "display_math",
              "latex": "\\text{Rate of A}=\\frac{2.4}{36}=\\frac1{15}\\text{ L/s}"
