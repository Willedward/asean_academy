  "stem": [
    {
      "type": "text",
      "text": "A box contains 216 red and blue counters. The ratio of red counters to blue counters is 7:11. Twelve blue counters are repainted red. No counters are added or removed."
    }
  ],
  "parts": [
    {
      "position": 1,
      "label": null,
      "prompt": [
        {
          "type": "text",
          "text": "Find the new ratio of red counters to blue counters in its simplest form."
        }
      ],
      "marks": 3,
      "primary_outcome": "2.3",
      "secondary_outcomes": [],
      "response": {
        "type": "algebraic_expression",
        "comparison_mode": "exact_ratio",
        "canonical_expression": "4:5",
        "canonical_latex": "4:5",
        "variables": [],
        "domain_constraints": [
          "positive ratio terms"
        ],
        "accepted_equivalents": [],
        "checker_config": {
          "terms": 2,
          "require_simplest_integer_terms": true
        }
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Use the total and the 7:11 ratio to find the original numbers of red and blue counters."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "There are 18 ratio parts altogether. After finding one part, add 12 to the red count and subtract 12 from the blue count."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "display_math",
              "latex": "216\\div(7+11)=12"
            },
            {
              "type": "text",
              "text": "Each ratio part represents 12 counters."
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 2,
          "content": [
            {
              "type": "display_math",
              "latex": "\\text{New red}=7(12)+12=96,\\qquad\\text{new blue}=11(12)-12=120"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 3,
          "content": [
            {
              "type": "display_math",
              "latex": "96:120=4:5"
            }
          ],
          "mark_type": "A",
          "mark_value": 1
        }
