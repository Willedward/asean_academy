    "stem": [
      {
        "type": "text",
        "text": "Aini and Budi share S$216 in the ratio 7:11. Budi then gives Aini S$12."
      }
    ],
    "parts": [
      {
        "position": 1,
        "label": null,
        "prompt": [
          {
            "type": "text",
            "text": "Find the new ratio of Aini's money to Budi's money in its simplest form."
          }
        ],
        "marks": 3,
        "primary_outcome": "2.3",
        "secondary_outcomes": [],
        "response": {
          "type": "algebraic_expression",
          "comparison_mode": "exact_ratio",
          "canonical_expression": "4:5",
          "canonical_latex": "4:5",
          "variables": [],
          "domain_constraints": [
            "positive ratio terms"
          ],
          "accepted_equivalents": [],
          "checker_config": {
            "terms": 2,
            "require_simplest_integer_terms": true
          }
        },
        "hints": [
          {
            "stage": 1,
            "content": [
              {
                "type": "text",
                "text": "Use the total and the 7:11 ratio to find how much each person has at first."
              }
            ]
          },
          {
            "stage": 2,
            "content": [
              {
                "type": "text",
                "text": "There are 18 ratio parts altogether. After finding one part, add 12 to Aini's amount and subtract 12 from Budi's amount."
              }
            ]
          }
        ],
        "solution": [
          {
            "position": 1,
            "content": [
              {
                "type": "display_math",
                "latex": "216\\div(7+11)=12"
              },
              {
                "type": "text",
                "text": "Each ratio part represents S$12."
              }
            ],
            "mark_type": "M",
            "mark_value": 1
          },
          {
            "position": 2,
            "content": [
              {
                "type": "display_math",
                "latex": "\\text{Aini}=7(12)+12=96,\\qquad\\text{Budi}=11(12)-12=120"
              }
            ],
            "mark_type": "M",
            "mark_value": 1
          },
          {
            "position": 3,
            "content": [
              {
                "type": "display_math",
                "latex": "96:120=4:5"
              }
            ],
            "mark_type": "A",
            "mark_value": 1
          }
        ]
      }
