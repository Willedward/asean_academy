      "prompt": [
        {
          "type": "text",
          "text": "A test vehicle on a closed track is planned to average 80 km/h over a 240 km trial. The first 100 km is travelled at 50 km/h, and the vehicle then stops for 12 minutes. Find the constant speed, in kilometres per hour, needed for the remaining 140 km to achieve the planned average."
        }
      ],
      "marks": 4,
      "primary_outcome": "4.3",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "175",
        "canonical_latex": "175",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": null,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "First find the total journey time allowed by the planned average."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Subtract the time for the first 100 km and the stop, then divide the remaining distance by the remaining time."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "inline_math",
              "latex": "\\text{Planned total time}=\\frac{240}{80}=3\\text{ h}"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 2,
          "content": [
            {
              "type": "inline_math",
              "latex": "\\text{Time used}=\\frac{100}{50}+\\frac{12}{60}=2.2\\text{ h}"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 3,
          "content": [
            {
              "type": "inline_math",
              "latex": "\\text{Remaining time}=3-2.2=0.8\\text{ h}"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 4,
          "content": [
            {
              "type": "inline_math",
              "latex": "\\text{Required speed}=\\frac{140}{0.8}=175\\text{ km/h}"
            }
          ],
          "mark_type": "A",
          "mark_value": 1
        }
      ]
    }
