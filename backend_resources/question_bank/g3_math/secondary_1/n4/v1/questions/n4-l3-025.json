        {
          "type": "text",
          "text": "A coach travels 84 km at 70 km/h, stops, and then travels 66 km at 60 km/h. The whole trip takes 3 hours, including the stop. Find the length of the stop in minutes."
        }
      ],
      "marks": 3,
      "primary_outcome": "4.1",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "42",
        "canonical_latex": "42",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": null,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Find the travelling time for each part."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Subtract the travelling times from 3 hours, then convert hours to minutes."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "Travel times: "
            },
            {
              "type": "inline_math",
              "latex": "84\\div70=1.2"
            },
            {
              "type": "text",
              "text": " h and "
            },
            {
              "type": "inline_math",
              "latex": "66\\div60=1.1"
            },
            {
              "type": "text",
              "text": " h."
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 2,
          "content": [
            {
              "type": "text",
              "text": "Stop "
            },
            {
              "type": "inline_math",
              "latex": "=3-1.2-1.1=0.7"
            },
            {
              "type": "text",
              "text": " h."
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 3,
          "content": [
            {
              "type": "inline_math",
              "latex": "0.7\\times60=42"
