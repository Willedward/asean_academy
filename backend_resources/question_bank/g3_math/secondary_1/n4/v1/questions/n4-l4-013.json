      "prompt": [
        {
          "type": "text",
          "text": "A delivery vehicle travels 48 km in the first stage at 64 km/h, stops for 15 minutes, and then travels another 72 km. Its average speed for the entire journey, including the stop, is 60 km/h. Find its average speed during the second travelling stage in kilometres per hour."
        }
      ],
      "marks": 4,
      "primary_outcome": "4.1",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "72",
        "canonical_latex": "72\\text{ km/h}",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": null,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Use the overall average speed to find the total elapsed time, then remove the first-stage time and the stop."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "The whole journey takes 120/60 hours; the first stage takes 48/64 hour and the stop takes 0.25 hour."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "display_math",
              "latex": "\\text{Total elapsed time}=\\frac{48+72}{60}=2\\text{ h}"
            }
          ],
          "mark_type": "B",
          "mark_value": 1
        },
        {
          "position": 2,
          "content": [
            {
              "type": "display_math",
              "latex": "\\text{First-stage time}=\\frac{48}{64}=0.75\\text{ h}"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 3,
          "content": [
            {
              "type": "display_math",
              "latex": "\\text{Second-stage time}=2-0.75-0.25=1\\text{ h}"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 4,
          "content": [
            {
              "type": "display_math",
              "latex": "\\text{Second-stage speed}=\\frac{72}{1}=72\\text{ km/h}"
            }
          ],
          "mark_type": "A",
          "mark_value": 1
        }
      ]
    }
