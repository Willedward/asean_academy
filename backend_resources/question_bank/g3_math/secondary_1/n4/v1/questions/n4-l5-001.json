      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Both the volume unit and the time unit must be converted; remember that a cubic conversion applies in three dimensions."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Use 1 cubic metre equals 1,000,000 cubic centimetres and 1 hour equals 3600 seconds."
            }
          ]
        }
      ],
      "solution": [
