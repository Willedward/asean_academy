          "type": "text",
          "text": "A pump has a flow rate of 2.7 cubic metres per hour. Express this rate in cubic centimetres per second."
        }
      ],
      "marks": 5,
      "primary_outcome": "4.2",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
