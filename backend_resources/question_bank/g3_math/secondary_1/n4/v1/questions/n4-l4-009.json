          "type": "text",
          "text": "A vehicle travels two equal-distance sections without stopping. Its speed on the first section is 40 km/h, and its average speed over both sections is 48 km/h. Find its speed on the second section in kilometres per hour."
        }
      ],
      "marks": 4,
      "primary_outcome": "4.1",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "60",
        "canonical_latex": "60\\text{ km/h}",
        "accepted_answers": [],
