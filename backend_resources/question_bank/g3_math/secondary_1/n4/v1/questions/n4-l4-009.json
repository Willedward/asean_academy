        "rounding_precision": null,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "For equal distances, use total distance divided by the sum of the two travel times."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Let each section be d km and the second speed be v km/h; set 2d divided by d/40 + d/v equal to 48."
            }
          ]
        }
      ],
      "solution": [
