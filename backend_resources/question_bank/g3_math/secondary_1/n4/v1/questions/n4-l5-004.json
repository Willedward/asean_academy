        {
          "type": "text",
          "text": "A 300 km journey has three travelling sections and a 30-minute rest. The first and second sections have the same distance. The vehicle travels at 50 km/h, 75 km/h and 100 km/h in the first, second and third sections respectively. Its average speed for the entire journey, including the rest, is 60 km/h. Find the distance of the first section in kilometres."
        }
      ],
      "marks": 5,
      "primary_outcome": "4.1",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "112.5",
        "canonical_latex": "112.5\\text{ km}",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": null,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Use the overall average speed to find total elapsed time, remove the rest, and let each of the first two section distances be x km."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Set x/50 + x/75 + (300 - 2x)/100 equal to the travelling time after subtracting 0.5 hour from 300/60 hours."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "display_math",
              "latex": "\\text{Elapsed time}=\\frac{300}{60}=5\\text{ h},\\quad \\text{travelling time}=4.5\\text{ h}"
            }
          ],
          "mark_type": "B",
          "mark_value": 1
        },
        {
          "position": 2,
          "content": [
            {
              "type": "display_math",
              "latex": "\\frac{x}{50}+\\frac{x}{75}+\\frac{300-2x}{100}=4.5"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 3,
          "content": [
            {
              "type": "display_math",
              "latex": "\\frac{6x+4x+900-6x}{300}=4.5"
            }
          ],
