          "type": "text",
          "text": "During a storm, 18 mm of rain falls uniformly on a horizontal roof of area 250 square metres in 12 minutes. Assume all the rainwater is collected. Find the average collection rate in litres per second."
        }
      ],
      "marks": 5,
      "primary_outcome": "4.2",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
