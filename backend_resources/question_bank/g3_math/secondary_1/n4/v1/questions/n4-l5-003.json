          "content": [
            {
              "type": "text",
              "text": "Treat the rainfall depth as a length and use volume equals base area times depth."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Convert 18 mm to metres, convert the resulting cubic metres to litres, then divide by 12 times 60 seconds."
            }
          ]
        }
      ],
