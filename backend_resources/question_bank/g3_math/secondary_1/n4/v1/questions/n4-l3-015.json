      "prompt": [
        {
          "type": "text",
          "text": "A driver plans to cover 210 km at an average speed of 70 km/h. The first 90 km is travelled at 45 km/h. Find the constant speed, in kilometres per hour, needed for the remaining distance to achieve the planned average speed."
        }
      ],
      "marks": 3,
      "primary_outcome": "4.3",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "120",
        "canonical_latex": "120\\text{ km/h}",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": null,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Use the planned average speed to find the allowed total time, then subtract the time already used."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "The total time allowed is 210/70 hours and the first stage takes 90/45 hours."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "display_math",
              "latex": "\\text{Allowed time}=\\frac{210}{70}=3\\text{ h}"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 2,
          "content": [
            {
              "type": "display_math",
              "latex": "\\text{Remaining distance}=120\\text{ km},\\quad \\text{remaining time}=3-\\frac{90}{45}=1\\text{ h}"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 3,
          "content": [
            {
              "type": "display_math",
              "latex": "\\text{Required speed}=\\frac{120}{1}=120\\text{ km/h}"
            }
          ],
