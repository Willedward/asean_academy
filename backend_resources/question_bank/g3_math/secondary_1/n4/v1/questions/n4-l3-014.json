        "rounding_precision": null,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Find the van's head start distance and the rate at which the car closes the gap."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "The head start is 48 times 25/60 km and the relative speed is 68 - 48 km/h."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "display_math",
              "latex": "\\text{Head start}=48\\times\\frac{25}{60}=20\\text{ km}"
