        {
          "type": "text",
          "text": "A delivery van passes a checkpoint at 48 km/h. Twenty-five minutes later, a car passes the same checkpoint in the same direction at 68 km/h. Assuming both speeds remain constant, find the time in hours taken by the car to catch the van after the car passes the checkpoint."
        }
      ],
      "marks": 3,
      "primary_outcome": "4.3",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "1",
        "canonical_latex": "1\\text{ h}",
        "accepted_answers": [],
