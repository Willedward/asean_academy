          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Choose a convenient one-way distance that is a common multiple of both speeds."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "Let each direction be 180 km, then find the total distance and the two travel times."
            }
          ]
        }
      ],
      "solution": [
