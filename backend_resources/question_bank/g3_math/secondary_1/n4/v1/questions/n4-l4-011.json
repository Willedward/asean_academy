      "prompt": [
        {
          "type": "text",
          "text": "A train is scheduled to cover 216 km in 3 hours. It travels the first 90 km at 60 km/h and then stops for 20 minutes. Find the constant speed, in kilometres per hour, needed for the remaining distance to arrive on schedule."
        }
      ],
      "marks": 4,
      "primary_outcome": "4.3",
      "secondary_outcomes": [],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "108",
        "canonical_latex": "108\\text{ km/h}",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": null,
        "unit": null
      },
      "hints": [
        {
          "stage": 1,
          "content": [
            {
              "type": "text",
              "text": "Subtract both the first-stage travel time and the stop from the scheduled total time."
            }
          ]
        },
        {
          "stage": 2,
          "content": [
            {
              "type": "text",
              "text": "The first 90 km takes 1.5 hours and the stop takes 1/3 hour; use the remaining time for the remaining 126 km."
            }
          ]
        }
      ],
      "solution": [
        {
          "position": 1,
          "content": [
            {
              "type": "display_math",
              "latex": "\\text{First-stage time}=\\frac{90}{60}=1.5\\text{ h}"
            }
          ],
          "mark_type": "B",
          "mark_value": 1
        },
        {
          "position": 2,
          "content": [
            {
              "type": "display_math",
              "latex": "\\text{Remaining time}=3-1.5-\\frac13=\\frac76\\text{ h}"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 3,
          "content": [
            {
              "type": "display_math",
              "latex": "\\text{Remaining distance}=216-90=126\\text{ km}"
            }
          ],
          "mark_type": "M",
          "mark_value": 1
        },
        {
          "position": 4,
          "content": [
            {
              "type": "display_math",
              "latex": "\\text{Required speed}=\\frac{126}{7/6}=108\\text{ km/h}"
            }
          ],
          "mark_type": "A",
          "mark_value": 1
        }
      ]
    }
