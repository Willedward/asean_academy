{
  "$defs": {
    "QuestionPool": {
      "additionalProperties": false,
      "properties": {
        "stable_key": {
          "pattern": "^[a-z0-9-]+$",
          "title": "Stable Key",
          "type": "string"
        },
        "type": {
          "enum": [
            "lesson_practice",
            "unit_checkpoint",
            "adaptive_reserve"
          ],
          "title": "Type",
          "type": "string"
        },
        "lesson_key": {
          "anyOf": [
            {
              "pattern": "^[ngs][0-9]+-lesson-[0-9]{2,3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lesson Key"
        },
        "expected_question_count": {
          "maximum": 40,
          "minimum": 1,
          "title": "Expected Question Count",
          "type": "integer"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/QuestionPoolItem"
          },
          "minItems": 1,
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "stable_key",
        "type",
        "expected_question_count",
        "items"
      ],
      "title": "QuestionPool",
      "type": "object"
    },
    "QuestionPoolItem": {
      "additionalProperties": false,
      "properties": {
        "position": {
          "minimum": 1,
          "title": "Position",
          "type": "integer"
        },
        "question_key": {
          "pattern": "^[ngs][0-9]+-l[1-3]-[0-9]{2,4}$",
          "title": "Question Key",
          "type": "string"
        },
        "stage": {
          "enum": [
            "guided",
            "independent",
            "challenge",
            "checkpoint",
            "adaptive"
          ],
          "title": "Stage",
          "type": "string"
        },
        "weight": {
          "default": 1,
          "maximum": 100,
          "minimum": 1,
          "title": "Weight",
          "type": "integer"
        }
      },
      "required": [
        "position",
        "question_key",
        "stage"
      ],
      "title": "QuestionPoolItem",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "course_key": {
      "pattern": "^[a-z0-9-]+$",
      "title": "Course Key",
      "type": "string"
    },
    "unit_key": {
      "pattern": "^[a-z0-9-]+$",
      "title": "Unit Key",
      "type": "string"
    },
    "bank_key": {
      "pattern": "^g3-sec[12]-[ngs][0-9]+-v[0-9]+$",
      "title": "Bank Key",
      "type": "string"
    },
    "pools": {
      "items": {
        "$ref": "#/$defs/QuestionPool"
      },
      "minItems": 1,
      "title": "Pools",
      "type": "array"
    }
  },
  "required": [
    "course_key",
    "unit_key",
    "bank_key",
    "pools"
  ],
  "title": "QuestionPools",
  "type": "object"
}
