  "stable_key": "n7-lesson-09",
  "position": 5,
  "title": "Quadratic equations by factorisation",
  "summary": "Rearrange quadratic equations, factorise them and apply the zero-product rule to obtain and check both roots.",
  "outcomes": [
    "7.9"
  ],
  "prerequisite_lessons": [
    "n7-lesson-08"
  ],
  "estimated_minutes": 60,
  "objectives": [
    "Write a quadratic equation with zero on one side.",
    "Factorise monic and simple non-monic quadratic expressions.",
    "Use the zero-product rule and verify both roots."
  ],
  "sections": [
    {
      "stable_key": "n7-09-explanation-1",
      "position": 1,
      "type": "explanation",
      "title": "Prepare the equation",
      "blocks": [
        {
          "type": "text",
          "text": "Factorisation solves a quadratic equation only after every term has been moved to one side and the other side is zero. Collect like terms and order the expression by descending powers. This prevents factoring an expression that is not equivalent to the original equation."
        }
      ]
    },
    {
      "stable_key": "n7-09-explanation-2",
      "position": 2,
      "type": "explanation",
      "title": "Factorise systematically",
      "blocks": [
        {
          "type": "text",
          "text": "For x²+bx+c, find two numbers whose sum is b and product is c. For a non-monic quadratic, use a suitable splitting or grouping method. Always expand the proposed factors mentally to verify the middle and constant terms."
        }
      ]
    },
    {
      "stable_key": "n7-09-explanation-3",
      "position": 3,
      "type": "explanation",
      "title": "Apply the zero-product rule",
      "blocks": [
        {
          "type": "text",
          "text": "If AB = 0, then A = 0 or B = 0. Set each linear factor equal to zero and solve, keeping both roots unless a stated context excludes one. Substitute each root into the original equation, especially when rearrangement occurred."
        }
      ]
    },
    {
      "stable_key": "n7-09-errors",
      "position": 4,
      "type": "explanation",
      "title": "Common errors",
      "blocks": [
        {
          "type": "text",
          "text": "Do not factorise until one side is zero: x² + 2x = 15 cannot be solved as x(x + 2) = 15 by setting each factor to 15. Do not divide both sides by x, because that loses the root x = 0. Remember the signs: the factor (x + 5) gives the root x = −5, not 5."
        }
      ]
    },
    {
      "stable_key": "n7-09-example-1",
      "position": 5,
      "type": "worked_example",
      "title": "Worked example: solve a monic quadratic",
      "prompt": [
        {
          "type": "text",
          "text": "Solve x² − 8x + 15 = 0."
        }
      ],
      "steps": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "Find two numbers with sum −8 and product 15: −3 and −5."
            }
          ]
        },
        {
          "position": 2,
          "content": [
            {
              "type": "display_math",
              "latex": "(x-3)(x-5)=0"
            }
          ]
        },
        {
          "position": 3,
          "content": [
            {
              "type": "display_math",
              "latex": "x-3=0\\ \\text{ or }\\ x-5=0\\quad\\Rightarrow\\quad x=3\\ \\text{ or }\\ x=5"
            }
          ]
        }
      ],
      "verification_note": "Both roots work: 9 − 24 + 15 = 0 and 25 − 40 + 15 = 0."
    },
    {
      "stable_key": "n7-09-example-2",
      "position": 6,
      "type": "worked_example",
      "title": "Worked example: rearrange first",
      "prompt": [
        {
          "type": "text",
          "text": "Solve x² + 2x = 15."
        }
      ],
      "steps": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "Subtract 15 so that one side is zero."
            },
            {
              "type": "display_math",
              "latex": "x^2+2x-15=0"
            }
          ]
        },
        {
          "position": 2,
          "content": [
            {
              "type": "text",
              "text": "Find two numbers with sum 2 and product −15: 5 and −3."
            },
            {
              "type": "display_math",
              "latex": "(x+5)(x-3)=0"
            }
          ]
        },
        {
          "position": 3,
          "content": [
            {
              "type": "display_math",
              "latex": "x=-5\\ \\text{ or }\\ x=3"
            }
          ]
        }
      ],
      "verification_note": "Substitution gives 25 − 10 = 15 and 9 + 6 = 15."
    },
    {
      "stable_key": "n7-09-example-3",
      "position": 7,
      "type": "worked_example",
      "title": "Worked example: a non-monic quadratic",
      "prompt": [
        {
          "type": "text",
          "text": "Solve 2x² + 5x − 3 = 0."
        }
      ],
      "steps": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "Multiply a and c: 2 × (−3) = −6. Find two numbers with product −6 and sum 5: 6 and −1. Use them to split 5x."
            },
            {
              "type": "display_math",
              "latex": "2x^2+6x-x-3=0"
            }
          ]
        },
        {
          "position": 2,
          "content": [
            {
              "type": "text",
              "text": "Factorise in pairs, then take out the common bracket."
            },
            {
              "type": "display_math",
              "latex": "2x(x+3)-1(x+3)=0\\quad\\Rightarrow\\quad(2x-1)(x+3)=0"
            }
          ]
        },
        {
          "position": 3,
          "content": [
            {
              "type": "display_math",
              "latex": "2x-1=0\\ \\text{ or }\\ x+3=0\\quad\\Rightarrow\\quad x=\\tfrac12\\ \\text{ or }\\ x=-3"
            }
          ]
        }
      ],
      "verification_note": "Check: 2(½)² + 5(½) − 3 = 0.5 + 2.5 − 3 = 0 and 2(9) − 15 − 3 = 0. Expanding (2x − 1)(x + 3) gives 2x² + 5x − 3."
    },
    {
      "stable_key": "n7-09-recall",
      "position": 8,
      "type": "active_recall",
      "title": "Check your understanding",
      "prompt": [
        {
          "type": "text",
          "text": "Solve (x + 1)(x − 9) = 0 and enter the larger root."
        }
      ],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "9",
        "canonical_latex": "9",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": null,
        "unit": null
      },
      "feedback": [
        {
          "type": "text",
          "text": "x + 1 = 0 gives x = −1 and x − 9 = 0 gives x = 9, so the larger root is 9."
        }
      ]
    },
    {
      "stable_key": "n7-09-summary",
      "position": 9,
      "type": "summary",
      "title": "Lesson checklist",
      "blocks": [
        {
          "type": "text",
          "text": "Rearrange so that one side is zero, factorise, then set each factor equal to zero."
        },
        {
          "type": "text",
          "text": "For ax² + bx + c with a ≠ 1, split the middle term using two numbers whose product is ac and sum is b. Check every root in the original equation."
        }
      ]
    }
  ],
