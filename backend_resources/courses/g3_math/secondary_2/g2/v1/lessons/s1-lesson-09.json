  "course_key": "g3-sec2-math",
  "unit_key": "g3-sec2-s1",
  "position": 5,
  "status": "draft",
  "title": "Selecting an appropriate measure of centre",
  "summary": "Select mean, median or mode according to distribution shape, outliers, data type and the decision being made.",
  "outcomes": [
    "1.9"
  ],
  "prerequisite_lessons": [
    "s1-lesson-08"
  ],
  "estimated_minutes": 60,
  "objectives": [
    "Recognise when outliers or skew make the median preferable.",
    "Use the mode for most-common categories or values.",
    "Use the mean when every numerical observation should contribute."
  ],
  "mastery_policy_key": "s1-default-v1",
  "sections": [
    {
      "stable_key": "s1-09-explanation-1",
      "position": 1,
      "type": "explanation",
      "title": "Match the measure to the question",
      "blocks": [
        {
          "type": "text",
          "text": "Use the mode when the most common category or size matters. Use the median when the middle ranked observation should resist extreme values. Use the mean when totals matter and the numerical distribution is reasonably balanced. In the diagram, seven walking times lie between 3 and 6 minutes and one is 18 minutes. The median is (5 + 5) ÷ 2 = 5 minutes, but the mean is 50 ÷ 8 = 6.25 minutes, pulled up by the single long walk."
        },
        {
          "type": "asset_ref",
          "asset_key": "s1-lesson-09-diagram"
        }
      ]
    },
    {
      "stable_key": "s1-09-explanation-2",
      "position": 2,
      "type": "explanation",
      "title": "Inspect shape and outliers",
      "blocks": [
        {
          "type": "text",
          "text": "A long tail or isolated extreme can pull the mean away from where most observations lie. The median usually remains near the central cluster. Reporting both can reveal skew: a mean far above the median suggests a high-value tail."
        }
      ]
    },
    {
      "stable_key": "s1-09-explanation-3",
      "position": 3,
      "type": "explanation",
      "title": "Explain, do not merely name",
      "blocks": [
        {
          "type": "text",
          "text": "A complete choice states why the selected measure serves the purpose and why an alternative may mislead. Context matters: the mean is useful for planning an overall total, while the median may better describe a typical person's experience."
        }
      ]
    },
    {
      "stable_key": "s1-09-example-1",
      "position": 4,
      "type": "worked_example",
      "title": "Worked example: choose for household income",
      "prompt": [
        {
          "type": "text",
          "text": "Most household incomes in a village cluster together, but one household’s income is very large. Choose a measure that describes a typical household."
        }
      ],
      "steps": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "The extreme income adds a lot to the total, so it strongly raises the mean."
            }
          ]
        },
        {
          "position": 2,
          "content": [
            {
              "type": "text",
              "text": "The median depends on the middle position, so one extreme value moves it very little."
            }
          ]
        },
        {
          "position": 3,
          "content": [
            {
              "type": "text",
              "text": "Use the median for a typical household."
            }
          ]
        }
      ],
      "verification_note": "Removing the very large income would change the mean a lot but the median hardly at all, which shows that the median describes the cluster."
    },
    {
      "stable_key": "s1-09-example-2",
      "position": 5,
      "type": "worked_example",
      "title": "Worked example: choose for the most popular option",
      "prompt": [
        {
          "type": "text",
          "text": "A café wants to know which cup size, small, medium or large, is ordered most often."
        }
      ],
      "steps": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "The data are categories, so a mean or median cannot be calculated."
            }
          ]
        },
        {
          "position": 2,
          "content": [
            {
              "type": "text",
              "text": "Count how often each size is ordered."
            }
          ]
        },
        {
          "position": 3,
          "content": [
            {
              "type": "text",
              "text": "Use the mode: the size with the greatest count."
            }
          ]
        }
      ],
      "verification_note": "The mode answers the question directly, and it is the only one of the three measures that works for categories."
    },
    {
      "stable_key": "s1-09-recall",
      "position": 6,
      "type": "active_recall",
      "title": "Check your understanding",
      "prompt": [
        {
          "type": "text",
          "text": "Use code 1 for mean and 2 for median. Which is more resistant to one extreme outlier?"
        }
      ],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "2",
        "canonical_latex": "2",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": null,
        "unit": null
      },
      "feedback": [
        {
          "type": "text",
          "text": "The median is determined by position and is resistant to one extreme value."
        }
      ]
    },
    {
      "stable_key": "s1-09-summary",
      "position": 7,
      "type": "summary",
      "title": "Lesson checklist",
      "blocks": [
        {
          "type": "text",
          "text": "Mode: the most common value or category. Median: the typical middle value, resistant to outliers and skew. Mean: uses every value, best when totals matter and the data are balanced."
        },
        {
          "type": "text",
          "text": "Justify a choice by linking it to the shape of the data and the purpose, and say why another measure could mislead."
        }
      ]
    }
  ],
