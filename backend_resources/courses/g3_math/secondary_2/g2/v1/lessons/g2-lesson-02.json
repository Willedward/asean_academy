  "course_key": "g3-sec2-math",
  "unit_key": "g3-sec2-g2",
  "position": 2,
  "status": "draft",
  "title": "Similar figures",
  "summary": "Recognise similar figures and work with one constant linear scale factor.",
  "outcomes": [
    "2.2"
  ],
  "prerequisite_lessons": [
    "g2-lesson-01"
  ],
  "estimated_minutes": 55,
  "objectives": [
    "Distinguish similarity from congruence.",
    "Determine a linear scale factor.",
    "Use scale factors for sides, perimeters and areas."
  ],
  "mastery_policy_key": "g2-default-v1",
  "sections": [
    {
      "stable_key": "g2-22-method",
      "position": 1,
      "type": "explanation",
      "title": "Core method",
      "blocks": [
        {
          "type": "text",
          "text": "Similar figures have equal corresponding angles and proportional corresponding sides. A scale factor of 1 gives congruent figures; any other positive factor changes size."
        },
        {
          "type": "display_math",
          "latex": "k=\\frac{\\text{image length}}{\\text{original length}},\\qquad\\text{area factor}=k^2"
        }
      ]
    },
    {
      "stable_key": "g2-lesson-02-visual",
      "position": 2,
      "type": "explanation",
      "title": "Read the diagram",
      "blocks": [
        {
          "type": "text",
          "text": "Similar figures have equal corresponding angles and proportional corresponding lengths. The diagram shows two similar triangles: the base of the smaller is 6 cm and the corresponding base of the larger is 15 cm, and the arrow marked × k shows that every length of the smaller triangle is multiplied by the same scale factor k. Perimeters use the same factor k, while areas use k²."
        },
        {
          "type": "asset_ref",
          "asset_key": "g2-lesson-02-diagram"
        }
      ]
    },
    {
      "stable_key": "g2-lesson-02-reasoning",
      "position": 3,
      "type": "explanation",
      "title": "Reasoning method",
      "blocks": [
        {
          "type": "text",
          "text": "Choose one direction for the scale factor and keep it throughout. If the factor from A to B is k, then length_B=k×length_A, perimeter_B=k×perimeter_A and area_B=k²×area_A. A scale factor of 1 gives congruent figures."
        }
      ]
    },
    {
      "stable_key": "g2-22-example",
      "position": 4,
      "type": "worked_example",
      "title": "Worked example: find a scale factor",
      "prompt": [
        {
          "type": "text",
          "text": "In the diagram, a 6 cm side of the smaller triangle corresponds to a 15 cm side of the larger triangle. Find the scale factor from the smaller triangle to the larger one."
        }
      ],
      "steps": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "Divide the image length by the corresponding original length."
            },
            {
              "type": "display_math",
              "latex": "k=\\frac{15}{6}"
            }
          ]
        },
        {
          "position": 2,
          "content": [
            {
              "type": "display_math",
              "latex": "k=\\frac52=2.5"
            }
          ]
        }
      ],
      "verification_note": "6 × 2.5 = 15. The factor is greater than 1 because the image is larger."
    },
    {
      "stable_key": "g2-lesson-02-example-2",
      "position": 5,
      "type": "worked_example",
      "title": "Worked example: from an area factor to a length",
      "prompt": [
        {
          "type": "text",
          "text": "Two similar rectangles have areas 54 cm² and 150 cm². A side of the smaller rectangle is 9 cm. Find the corresponding side of the larger rectangle."
        }
      ],
      "steps": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "The area factor is the ratio of the areas."
            },
            {
              "type": "display_math",
              "latex": "k^2=\\frac{150}{54}=\\frac{25}{9}"
            }
          ]
        },
        {
          "position": 2,
          "content": [
            {
              "type": "text",
              "text": "The length factor is the positive square root."
            },
            {
              "type": "display_math",
              "latex": "k=\\sqrt{\\frac{25}{9}}=\\frac53"
            }
          ]
        },
        {
          "position": 3,
          "content": [
            {
              "type": "display_math",
              "latex": "9\\times\\frac53=15\\text{ cm}"
            }
          ]
        }
      ],
      "verification_note": "The length factor 5/3 squared gives the area factor 25/9, and 54 × 25/9 = 150."
    },
    {
      "stable_key": "g2-lesson-02-pitfalls",
      "position": 6,
      "type": "explanation",
      "title": "Common errors and checks",
      "blocks": [
        {
          "type": "text",
          "text": "Do not apply the area factor directly to a length. Keep original and image in the same order in every ratio. Similar figures need equal corresponding angles as well as proportional sides."
        }
      ]
    },
    {
      "stable_key": "g2-22-recall",
      "position": 7,
      "type": "active_recall",
      "title": "Check your understanding",
      "prompt": [
        {
          "type": "text",
          "text": "A figure with perimeter 14 cm is enlarged by scale factor 4. Find the perimeter of the image, in cm."
        }
      ],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "56",
        "canonical_latex": "56",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": null,
        "unit": null
      },
      "feedback": [
        {
          "type": "text",
          "text": "Perimeter is a length, so it uses the linear factor: 14 × 4 = 56 cm."
        }
      ]
    },
    {
      "stable_key": "g2-lesson-02-summary",
      "position": 8,
      "type": "summary",
      "title": "Lesson checklist",
      "blocks": [
        {
          "type": "text",
          "text": "Similar figures have equal corresponding angles and corresponding lengths in a constant ratio, the scale factor k = image length ÷ original length."
        },
        {
          "type": "text",
          "text": "Lengths and perimeters are multiplied by k and areas by k². To go back from an area factor to a length factor, take the positive square root."
        }
      ]
    }
  ],
