  "stable_key": "n3-lesson-05",
  "course_key": "g3-sec1-math",
  "unit_key": "g3-sec1-n3",
  "position": 5,
  "status": "draft",
  "title": "Reverse percentages",
  "summary": "Recover an original quantity from a known final quantity after one or more percentage changes.",
  "outcomes": [
    "3.5"
  ],
  "prerequisite_lessons": [
    "n3-lesson-04"
  ],
  "estimated_minutes": 35,
  "objectives": [
    "Identify the multiplier that changed the original quantity into the final quantity.",
    "Divide by the multiplier to recover the original quantity.",
    "Reverse multi-stage percentage changes without reversing each percentage informally."
  ],
  "mastery_policy_key": "n3-default-v1",
  "sections": [
    {
      "stable_key": "reverse-percentage-model",
      "position": 1,
      "type": "explanation",
      "title": "Work backwards by division",
      "blocks": [
        {
          "type": "text",
          "text": "A final amount equals the original amount multiplied by a percentage multiplier. Therefore "
        },
        {
          "type": "inline_math",
          "latex": "\\text{original}=\\frac{\\text{final}}{\\text{multiplier}}"
        },
        {
          "type": "text",
          "text": ". After a 20% discount, for example, the final price is 80% or 0.8 of the original."
        }
      ]
    },
    {
      "stable_key": "reverse-compound-change",
      "position": 2,
      "type": "explanation",
      "title": "Combine multiple multipliers before reversing",
      "blocks": [
        {
          "type": "text",
          "text": "For several changes, multiply their multipliers to form one overall multiplier, then divide the final amount by it. Do not simply add or subtract the stated percentages because each change may use a different base."
        }
      ]
    },
    {
      "stable_key": "reverse-discount-example",
      "position": 3,
      "type": "worked_example",
      "title": "Worked example: recover a marked price",
      "prompt": [
        {
          "type": "text",
          "text": "A shirt costs S$68 after a 15% discount. Find its marked price."
        }
      ],
      "steps": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "The sale price is 85% of the marked price."
            },
            {
              "type": "display_math",
              "latex": "68=0.85\\times\\text{marked price}"
            }
          ]
        },
        {
          "position": 2,
          "content": [
            {
              "type": "text",
              "text": "Divide by 0.85."
            },
            {
              "type": "display_math",
              "latex": "\\text{marked price}=\\frac{68}{0.85}=80"
            }
          ]
        },
        {
          "position": 3,
          "content": [
            {
              "type": "text",
              "text": "The marked price is S$80."
            }
          ]
        }
      ],
      "verification_note": "Checking forwards, 15% of S$80 is S$12, and S$80 \u2212 S$12 = S$68."
    },
    {
      "stable_key": "reverse-tax-example",
      "position": 4,
      "type": "worked_example",
      "title": "Worked example: reverse two changes",
      "prompt": [
        {
          "type": "text",
          "text": "An item is discounted by 15%, and then an 8% sales tax (a tax added to the price) is charged. It costs S$229.50. Find the original price."
        }
      ],
      "steps": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "Combine the discount and tax multipliers."
            },
            {
              "type": "display_math",
              "latex": "0.85\\times1.08=0.918"
            }
          ]
        },
        {
          "position": 2,
          "content": [
            {
              "type": "text",
              "text": "Divide the final price by the overall multiplier."
            },
            {
              "type": "display_math",
              "latex": "\\text{original}=\\frac{229.50}{0.918}=250"
            }
          ]
        },
        {
          "position": 3,
          "content": [
            {
              "type": "text",
              "text": "The original price was S$250."
            }
          ]
        }
      ],
      "verification_note": "Checking forwards, S$250 \u00d7 0.85 = S$212.50, and S$212.50 \u00d7 1.08 = S$229.50."
    },
    {
      "stable_key": "reverse-percentage-recall",
      "position": 5,
      "type": "active_recall",
      "title": "Check your understanding",
      "prompt": [
        {
          "type": "text",
          "text": "A quantity becomes 264 after a 10% increase. Find the original quantity."
        }
      ],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "240",
        "canonical_latex": "240",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": null,
        "unit": null
      },
      "feedback": [
        {
          "type": "text",
          "text": "The final amount is 110% of the original. Divide 264 by 1.10 to get 240."
        }
      ]
    },
    {
      "stable_key": "reverse-percentage-summary",
      "position": 6,
      "type": "summary",
      "title": "Method checklist",
      "blocks": [
        {
          "type": "text",
          "text": "Identify what percentage of the original the final amount represents, convert it to a multiplier, and divide the final amount by that multiplier. Verify by applying the change forwards."
        }
      ]
    }
  ],
