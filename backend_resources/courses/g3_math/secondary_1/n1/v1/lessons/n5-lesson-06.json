        "checker_config": {}
      },
      "feedback": [
        {
          "type": "text",
          "text": "Combine the x-terms and constants separately: 4x + 2x + 3 - 5."
        }
      ]
    },
    {
      "stable_key": "n5-lesson-06-summary",
