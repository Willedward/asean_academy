  "mastery_policy_key": "n7-default-v1",
  "sections": [
    {
      "stable_key": "n7-72-method",
      "position": 1,
      "type": "explanation",
      "title": "A reliable solving sequence",
      "blocks": [
        {
          "type": "text",
          "text": "Aim to isolate the variable. Simplify each side first, move variable terms to one side, move constants to the other, and divide by the remaining coefficient. Write each operation on both sides so sign errors are visible."
        },
        {
          "type": "display_math",
          "latex": "a(bx+c)+d=ex+f"
        },
        {
          "type": "text",
          "text": "For bracketed equations, distribute the outside factor to every term. For variables on both sides, choose a subtraction that leaves a positive coefficient when convenient. Check by substituting the final value into the original equation."
        }
      ]
    },
    {
      "stable_key": "n7-72-example",
      "position": 2,
      "type": "worked_example",
      "title": "Solving with brackets and variables on both sides",
      "prompt": [
        {
          "type": "text",
          "text": "Solve 3(2x - 1) = 4x + 11."
        }
      ],
      "steps": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "Expand the bracket."
            },
            {
              "type": "display_math",
              "latex": "6x-3=4x+11"
            }
          ]
        },
        {
          "position": 2,
          "content": [
            {
              "type": "text",
              "text": "Subtract 4x and add 3."
            },
            {
              "type": "display_math",
              "latex": "2x=14"
            }
          ]
        },
        {
          "position": 3,
          "content": [
            {
              "type": "text",
              "text": "Divide by 2."
            },
            {
              "type": "display_math",
              "latex": "x=7"
            }
          ]
        }
      ],
      "verification_note": "Substitution gives 3(14 - 1) = 39 and 28 + 11 = 39."
    },
