  "title": "Using letters to represent numbers",
  "summary": "Represent unknown and changing quantities with letters.",
  "outcomes": [
    "5.1"
  ],
  "prerequisite_lessons": [],
  "estimated_minutes": 35,
  "objectives": [
    "Use a letter to represent an unknown number.",
    "Represent consecutive numbers, place value and repeated quantities algebraically."
  ],
  "mastery_policy_key": "n5-default-v1",
  "sections": [
    {
      "stable_key": "letters-as-quantities",
      "position": 1,
      "type": "explanation",
      "title": "Letters stand for numbers",
      "blocks": [
        {
          "type": "text",
          "text": "A letter may represent an unknown number or a quantity that can change. State what the letter means, then apply the operations in the order described."
        },
        {
          "type": "display_math",
          "latex": "n+1,\\quad 3x,\\quad a^2b"
        },
        {
          "type": "text",
          "text": "The coefficient 3 in 3x means three times x. A power applies only to its base unless brackets show otherwise."
        }
      ]
    },
    {
      "stable_key": "consecutive-number-example",
      "position": 2,
      "type": "worked_example",
      "title": "Represent consecutive numbers",
      "prompt": [
        {
          "type": "text",
          "text": "The first of three consecutive integers is n. Write their sum."
        }
      ],
      "steps": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "List the three integers."
            },
            {
              "type": "display_math",
              "latex": "n,\\quad n+1,\\quad n+2"
            }
          ]
        },
        {
          "position": 2,
          "content": [
            {
              "type": "text",
              "text": "Add them and simplify."
            },
            {
              "type": "display_math",
              "latex": "n+(n+1)+(n+2)=3n+3"
            }
          ]
        }
      ],
      "verification_note": "Substituting n = 4 gives 4 + 5 + 6 = 15 and 3(4) + 3 = 15."
    },
    {
      "stable_key": "letters-recall",
      "position": 3,
      "type": "active_recall",
      "title": "Check your understanding",
      "prompt": [
        {
          "type": "text",
          "text": "Write an expression for the integer immediately before q."
        }
      ],
      "response": {
        "type": "algebraic_expression",
        "comparison_mode": "symbolic_equivalence",
        "canonical_expression": "q-1",
        "canonical_latex": "q-1",
        "variables": [
          "q"
        ],
        "domain_constraints": [],
        "accepted_equivalents": [],
        "checker_config": {}
      },
      "feedback": [
        {
          "type": "text",
          "text": "The integer immediately before q is one less than q."
        }
      ]
    },
    {
      "stable_key": "n5-lesson-01-summary",
