  "title": "Linear functions y = ax + b",
  "summary": "Interpret, evaluate and determine linear functions using their rate of change and constant term.",
  "outcomes": [
    "6.3"
  ],
  "prerequisite_lessons": [
    "n6-lesson-02"
  ],
  "estimated_minutes": 35,
  "objectives": [
    "Interpret a and b in a linear function y = ax + b.",
    "Evaluate a function for a given input and solve for an input from an output.",
    "Determine a linear function from two input-output pairs."
  ],
  "mastery_policy_key": "n6-default-v1",
  "sections": [
    {
      "stable_key": "n6-functions-method",
      "position": 1,
      "type": "explanation",
      "title": "Rate of change and starting value",
      "blocks": [
        {
          "type": "text",
          "text": "In y = ax + b, a is the change in y for each increase of 1 in x, while b is the output when x = 0. Substitute an input carefully, using brackets for negative values."
        },
        {
          "type": "display_math",
          "latex": "a=\\frac{\\text{change in }y}{\\text{change in }x},\\qquad b=y\\text{ when }x=0"
        },
        {
          "type": "text",
          "text": "When two function values are known, find a from their changes and then substitute either pair to find b."
        }
      ]
    },
    {
      "stable_key": "n6-functions-example",
      "position": 2,
      "type": "worked_example",
      "title": "Determine a function from two points",
      "prompt": [
        {
          "type": "text",
          "text": "A linear function has y = 6 when x = 1 and y = 15 when x = 4. Find its rule."
        }
      ],
      "steps": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "Find the rate of change."
            },
            {
              "type": "display_math",
              "latex": "a=\\frac{15-6}{4-1}=3"
            }
          ]
        },
        {
          "position": 2,
          "content": [
            {
              "type": "text",
              "text": "Use the first pair to find b."
            },
            {
              "type": "display_math",
              "latex": "6=3(1)+b\\Rightarrow b=3"
            }
          ]
        },
        {
          "position": 3,
          "content": [
            {
              "type": "text",
              "text": "Write the function."
            },
            {
              "type": "display_math",
              "latex": "y=3x+3"
            }
          ]
        }
      ],
      "verification_note": "The second pair checks the rule because 3(4) + 3 = 15."
    },
    {
      "stable_key": "n6-functions-recall",
      "position": 3,
      "type": "active_recall",
      "title": "Check your understanding",
      "prompt": [
        {
          "type": "text",
          "text": "For y = -2x + 7, find y when x = 4."
        }
      ],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "-1",
        "canonical_latex": "-1",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": null,
        "unit": null
      },
      "feedback": [
        {
          "type": "text",
          "text": "Substitute x = 4: y = -2(4) + 7 = -1."
        }
      ]
    },
    {
      "stable_key": "n6-lesson-03-summary",
