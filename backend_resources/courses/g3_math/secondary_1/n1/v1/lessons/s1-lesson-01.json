      "title": "Core method",
      "blocks": [
        {
          "type": "text",
          "text": "Decide what each observation means before tallying it. Categories must not overlap, and every valid observation should fit exactly one category. Check that all frequencies add to the sample size."
        },
        {
          "type": "display_math",
          "latex": "\\text{sample size}=\\sum \\text{category frequencies}"
        }
      ]
    },
    {
