          "type": "text",
          "text": "The values are 2, 1, 3, 2, 2, 4, 1 and 2. Tabulate the frequency of 2."
        }
      ],
      "steps": [
        {
          "position": 1,
          "content": [
            {
              "type": "display_math",
              "latex": "\\text{Tally the four entries equal to }2."
