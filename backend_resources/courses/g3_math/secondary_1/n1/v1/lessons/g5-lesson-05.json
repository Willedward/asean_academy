  "stable_key": "g5-lesson-05",
  "course_key": "g3-sec1-math",
  "unit_key": "g3-sec1-g5",
  "position": 5,
  "status": "draft",
  "title": "Volume and surface area of composite solids",
  "summary": "Combine component measures and remove overlaps, holes or hidden faces.",
  "outcomes": [
    "5.5"
  ],
  "prerequisite_lessons": [
    "g5-lesson-04"
  ],
  "estimated_minutes": 55,
  "objectives": [
    "Add or subtract component volumes without double-counting.",
    "Remove two copies of each hidden contact face from surface area.",
    "Solve multi-step capacity and material problems involving composite solids."
  ],
  "mastery_policy_key": "g5-default-v1",
  "sections": [
    {
      "stable_key": "g5-55-method",
      "position": 1,
      "type": "explanation",
      "title": "Core method",
      "blocks": [
        {
          "type": "text",
          "text": "Combine component measures and remove overlaps, holes or hidden faces. Keep every measurement in compatible units before substituting."
        },
        {
          "type": "display_math",
          "latex": "V_{composite}=\\sum V_{added}-\\sum V_{removed}"
        }
      ]
    },
    {
      "stable_key": "g5-lesson-05-visual",
      "position": 2,
      "type": "explanation",
      "title": "Read the diagram",
      "blocks": [
        {
          "type": "text",
          "text": "The diagram shows the solid used in both worked examples: a 5 cm by 4 cm by 3 cm block resting on top of a 9 cm by 7 cm by 4 cm cuboid. Volume is additive: the solid holds the space of both pieces. Surface area needs a face audit. Where the block sits, a 5 cm by 4 cm rectangle on top of the cuboid is covered, and the base of the block is hidden as well, so the contact area disappears from the outside surface twice."
        },
        {
          "type": "asset_ref",
          "asset_key": "g5-lesson-05-diagram"
        }
      ]
    },
    {
      "stable_key": "g5-lesson-05-reasoning",
      "position": 3,
      "type": "explanation",
      "title": "Reasoning method",
      "blocks": [
        {
          "type": "text",
          "text": "Sketch an exploded view or table of components. Calculate each component volume using consistent units. For surface area, start with the separate totals and subtract twice the contact area. For a drilled hole, subtract its volume and add any newly exposed inner curved surface if surface area is required."
        }
      ]
    },
    {
      "stable_key": "g5-55-example",
      "position": 4,
      "type": "worked_example",
      "title": "Worked example: volume of joined cuboids",
      "prompt": [
        {
          "type": "text",
          "text": "The solid in the diagram is a 9 cm by 7 cm by 4 cm cuboid with a 5 cm by 4 cm by 3 cm block joined on top. Find its total volume."
        }
      ],
      "steps": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "Find the volume of each piece."
            },
            {
              "type": "display_math",
              "latex": "9\\times7\\times4=252\\text{ cm}^3,\\qquad5\\times4\\times3=60\\text{ cm}^3"
            }
          ]
        },
        {
          "position": 2,
          "content": [
            {
              "type": "text",
              "text": "The pieces are joined without overlapping, so add the volumes."
            },
            {
              "type": "display_math",
              "latex": "V=252+60=312\\text{ cm}^3"
            }
          ]
        }
      ],
      "verification_note": "The total is more than the large cuboid alone, 252 cm³, by exactly the block's 60 cm³."
    },
    {
      "stable_key": "g5-lesson-05-example-2",
      "position": 5,
      "type": "worked_example",
      "title": "Worked example: exposed surface area",
      "prompt": [
        {
          "type": "text",
          "text": "Find the exposed surface area of the same solid."
        }
      ],
      "steps": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "Find the surface area of each piece separately."
            },
            {
              "type": "display_math",
              "latex": "2(9\\times7+9\\times4+7\\times4)=2(63+36+28)=254\\text{ cm}^2"
            },
            {
              "type": "display_math",
              "latex": "2(5\\times4+5\\times3+4\\times3)=2(20+15+12)=94\\text{ cm}^2"
            }
          ]
        },
        {
          "position": 2,
          "content": [
            {
              "type": "text",
              "text": "The contact face is 5 cm by 4 cm, an area of 20 cm². It was counted once on each piece, so subtract it twice."
            },
            {
              "type": "display_math",
              "latex": "254+94-2\\times20=308\\text{ cm}^2"
            }
          ]
        }
      ],
      "verification_note": "The joined solid has less surface than the two separate pieces, 348 cm², by exactly two contact faces, 40 cm²."
    },
    {
      "stable_key": "g5-lesson-05-pitfalls",
      "position": 6,
      "type": "explanation",
      "title": "Common errors and checks",
      "blocks": [
        {
          "type": "text",
          "text": "Do not subtract a contact face only once. Do not subtract contact volume when pieces merely touch. Distinguish a cavity, which creates internal exposed surfaces, from a removed block whose opening and faces must be considered explicitly."
        }
      ]
    },
    {
      "stable_key": "g5-55-recall",
      "position": 7,
      "type": "active_recall",
      "title": "Check your understanding",
      "prompt": [
        {
          "type": "text",
          "text": "A 6 cm by 5 cm by 4 cm cuboid has a 2 cm cube removed. Find the remaining volume in cm³."
        }
      ],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "112",
        "canonical_latex": "112",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": null,
        "unit": null
      },
      "feedback": [
        {
          "type": "text",
          "text": "Subtract 2³ from 6 × 5 × 4: 120 - 8 = 112."
        }
      ]
    },
    {
      "stable_key": "g5-lesson-05-summary",
      "position": 8,
      "type": "summary",
      "title": "Method checklist",
      "blocks": [
        {
          "type": "text",
          "text": "Volume of a composite solid: add the volumes of joined pieces and subtract the volumes of holes or removed parts."
        },
        {
          "type": "text",
          "text": "Surface area: count only exposed faces. Subtract each contact face twice, once from each piece, and add any new inside faces that a hole creates."
        }
      ]
    }
  ],
