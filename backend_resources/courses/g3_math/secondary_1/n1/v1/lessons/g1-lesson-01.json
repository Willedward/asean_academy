      "blocks": [
        {
          "type": "text",
          "text": "Acute angles lie between 0\u00b0 and 90\u00b0, a right angle is 90\u00b0, obtuse angles lie between 90\u00b0 and 180\u00b0, and reflex angles lie between 180\u00b0 and 360\u00b0."
        },
        {
          "type": "display_math",
          "latex": "0^\\circ<\\text{acute}<90^\\circ<\\text{obtuse}<180^\\circ<\\text{reflex}<360^\\circ"
