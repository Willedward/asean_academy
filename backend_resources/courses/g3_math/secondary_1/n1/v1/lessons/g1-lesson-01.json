  "position": 1,
  "status": "draft",
  "title": "Right, acute, obtuse and reflex angles",
  "summary": "Classify and calculate angles using quarter, half and complete turns.",
  "outcomes": [
    "1.1"
  ],
  "prerequisite_lessons": [],
  "estimated_minutes": 55,
  "objectives": [
    "Classify angles as acute, right, obtuse or reflex from their measures.",
    "Use complements, supplements and complete turns to calculate unknown angles.",
    "Solve simple angle problems involving bisectors and related expressions."
  ],
  "mastery_policy_key": "g1-default-v1",
  "sections": [
    {
      "stable_key": "g1-11-method",
      "position": 1,
      "type": "explanation",
      "title": "Angle size and classification",
      "blocks": [
        {
          "type": "text",
          "text": "Acute angles lie between 0° and 90°, a right angle is 90°, obtuse angles lie between 90° and 180°, and reflex angles lie between 180° and 360°. An angle of exactly 180° is a straight angle (half a turn), and 360° is a complete turn."
        },
        {
          "type": "display_math",
          "latex": "0^\\circ<\\text{acute}<90^\\circ<\\text{obtuse}<180^\\circ<\\text{reflex}<360^\\circ"
        }
      ]
    },
    {
      "stable_key": "g1-lesson-01-visual",
      "position": 2,
      "type": "explanation",
      "title": "Read the diagram",
      "blocks": [
        {
          "type": "text",
          "text": "An angle is the amount of turn from one ray to another, measured at the vertex. Read the smaller turn unless a reflex angle is explicitly marked. Acute angles lie between 0° and 90°, a right angle is exactly 90°, obtuse angles lie between 90° and 180°, and reflex angles lie between 180° and 360°."
        },
        {
          "type": "asset_ref",
          "asset_key": "g1-lesson-01-diagram"
        }
      ]
    },
    {
      "stable_key": "g1-lesson-01-reasoning",
      "position": 3,
      "type": "explanation",
      "title": "Reasoning method",
      "blocks": [
        {
          "type": "text",
          "text": "Complementary angles total 90°, supplementary angles total 180°, and angles in a complete turn total 360°. Translate the geometry into one of these totals before forming an equation. An angle bisector divides one angle into two equal angles, so represent both parts by the same expression."
        }
      ]
    },
    {
      "stable_key": "g1-11-example",
      "position": 4,
      "type": "worked_example",
      "title": "Worked example: find a reflex angle",
      "prompt": [
        {
          "type": "text",
          "text": "Two rays from a point make a smaller angle of 128°. Find the reflex angle between the same two rays."
        }
      ],
      "steps": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "The smaller angle and the reflex angle together make a complete turn of 360°. Call the reflex angle r."
            },
            {
              "type": "display_math",
              "latex": "128^\\circ+r=360^\\circ"
            }
          ]
        },
        {
          "position": 2,
          "content": [
            {
              "type": "display_math",
              "latex": "r=360^\\circ-128^\\circ=232^\\circ"
            }
          ]
        }
      ],
      "verification_note": "232° lies between 180° and 360°, so it is reflex, and 128° + 232° = 360°."
    },
    {
      "stable_key": "g1-lesson-01-example-2",
      "position": 5,
      "type": "worked_example",
      "title": "Worked example: angles around a point",
      "prompt": [
        {
          "type": "text",
          "text": "A reflex angle is three times its smaller angle around the same point. Find both angles."
        }
      ],
      "steps": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "Let the smaller angle be x°. The reflex angle is 3x°."
            }
          ]
        },
        {
          "position": 2,
          "content": [
            {
              "type": "text",
              "text": "Angles around a point total 360°."
            },
            {
              "type": "display_math",
              "latex": "x+3x=360"
            }
          ]
        },
        {
          "position": 3,
          "content": [
            {
              "type": "display_math",
              "latex": "4x=360\\quad\\Rightarrow\\quad x=90"
            },
            {
              "type": "text",
              "text": "The two angles are 90° and 270°."
            }
          ]
        }
      ],
      "verification_note": "The two results total 360°, and 270° is between 180° and 360°."
    },
    {
      "stable_key": "g1-lesson-01-pitfalls",
      "position": 6,
      "type": "explanation",
      "title": "Common errors and checks",
      "blocks": [
        {
          "type": "text",
          "text": "Do not classify an angle from the way a sketch looks. Use its stated or calculated measure. Do not call 90° acute or 180° obtuse: boundary values have their own names. For a reflex angle, confirm that the answer exceeds 180°."
        }
      ]
    },
    {
      "stable_key": "g1-11-recall",
      "position": 7,
      "type": "active_recall",
      "title": "Check your understanding",
      "prompt": [
        {
          "type": "text",
          "text": "What is the complement of 34°?"
        }
      ],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "56",
        "canonical_latex": "56",
        "accepted_answers": [],
        "absolute_tolerance": null,
        "rounding_precision": null,
        "unit": null
      },
      "feedback": [
        {
          "type": "text",
          "text": "Complements total 90°, so 90 - 34 = 56."
        }
      ]
    },
    {
      "stable_key": "g1-lesson-01-summary",
      "position": 8,
      "type": "summary",
      "title": "Method checklist",
      "blocks": [
        {
          "type": "text",
          "text": "Classify an angle by its size: acute (less than 90°), right (90°), obtuse (between 90° and 180°), straight (180°), reflex (between 180° and 360°)."
        },
        {
          "type": "text",
          "text": "Use the totals 90° (complementary), 180° (supplementary or a straight line) and 360° (a complete turn) to write an equation, and check that each answer has the right type."
        }
      ]
    }
  ],
