      "title": "Substitute, then calculate",
      "blocks": [
        {
          "type": "text",
          "text": "Replace every occurrence of a letter with its given value. Put a negative substituted value in brackets and complete powers before multiplication, division, addition and subtraction."
        },
        {
          "type": "display_math",
          "latex": "2p^2-3p+1\\text{ at }p=-2:\\quad 2(-2)^2-3(-2)+1"
        }
      ]
    },
    {
