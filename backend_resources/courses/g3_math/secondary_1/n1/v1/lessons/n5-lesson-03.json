      "position": 2,
      "type": "worked_example",
      "title": "Evaluate a formula",
      "prompt": [
        {
          "type": "text",
          "text": "Use s = ut + at²/2 when u = 4, a = 6 and t = 3."
        }
      ],
      "steps": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "Substitute the three values."
            },
            {
              "type": "display_math",
              "latex": "s=4(3)+\\frac{6(3^2)}2"
            }
          ]
        },
        {
          "position": 2,
          "content": [
            {
              "type": "text",
              "text": "Calculate powers and products."
            },
            {
              "type": "display_math",
              "latex": "s=12+27=39"
            }
          ]
        }
      ],
      "verification_note": "Evaluating 3² before multiplying gives 39."
