  "title": "Solving simple fractional equations reducible to linear equations",
  "summary": "Clear denominators with a common multiple, then solve and check the resulting linear equation.",
  "outcomes": [
    "7.3"
  ],
  "prerequisite_lessons": [
    "n7-lesson-02"
  ],
  "estimated_minutes": 35,
  "objectives": [
    "Identify a lowest common multiple for all denominators.",
    "Multiply every term by the same common multiple.",
    "Solve the resulting linear equation and verify it in the original fractional equation."
  ],
  "mastery_policy_key": "n7-default-v1",
  "sections": [
    {
      "stable_key": "n7-73-method",
      "position": 1,
      "type": "explanation",
      "title": "Clearing fractions safely",
      "blocks": [
        {
          "type": "text",
          "text": "A fractional equation can be converted into an equivalent linear equation by multiplying every term on both sides by a common multiple of all denominators. Brackets are essential when a whole numerator has more than one term."
        },
        {
          "type": "display_math",
          "latex": "\\frac{x+1}{3}-\\frac{x-2}{4}=5"
        },
        {
          "type": "text",
          "text": "The lowest common multiple is 12. Multiplying every term by 12 produces 4(x + 1) - 3(x - 2) = 60. Missing one term during this step changes the equation, so mark each denominator as it is cancelled."
        }
      ]
    },
    {
      "stable_key": "n7-73-example",
      "position": 2,
      "type": "worked_example",
      "title": "Using the lowest common multiple",
      "prompt": [
        {
          "type": "text",
          "text": "Solve (x + 2)/3 + (x - 1)/2 = 6."
        }
      ],
      "steps": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "The lowest common multiple of 3 and 2 is 6. Multiply every term by 6."
            },
            {
              "type": "display_math",
              "latex": "2(x+2)+3(x-1)=36"
            }
          ]
        },
        {
          "position": 2,
          "content": [
            {
              "type": "text",
              "text": "Expand and collect like terms."
            },
            {
              "type": "display_math",
              "latex": "2x+4+3x-3=36\\Rightarrow5x+1=36"
            }
          ]
        },
        {
          "position": 3,
          "content": [
            {
              "type": "text",
              "text": "Finish the linear equation."
            },
            {
              "type": "display_math",
              "latex": "5x=35\\Rightarrow x=7"
            }
          ]
        }
      ],
      "verification_note": "Substituting x = 7 gives 3 + 3 = 6."
    },
    {
      "stable_key": "n7-73-recall",
      "position": 3,
      "type": "active_recall",
      "title": "Check your understanding",
      "prompt": [
        {
          "type": "text",
          "text": "Solve (x - 4)/5 = 3."
        }
      ],
      "response": {
        "type": "numeric",
        "comparison_mode": "exact_numeric",
        "canonical_answer": "19",
        "canonical_latex": "19",
