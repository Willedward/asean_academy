  "title": "Use of brackets and extraction of common factors",
  "summary": "Expand brackets and reverse the process by extracting common factors.",
  "outcomes": [
    "5.8"
  ],
  "prerequisite_lessons": [
    "n5-lesson-07"
  ],
  "estimated_minutes": 35,
  "objectives": [
    "Expand brackets term by term.",
    "Factorise by extracting the greatest common numerical and variable factor."
  ],
  "mastery_policy_key": "n5-default-v1",
  "sections": [
    {
      "stable_key": "factorisation-check",
      "position": 1,
      "type": "explanation",
      "title": "Factorisation reverses expansion",
      "blocks": [
        {
          "type": "text",
          "text": "Find the greatest factor shared by every term, place it outside a bracket, and divide each original term by it."
        },
        {
          "type": "display_math",
          "latex": "8m^2+12m=4m(2m+3)"
        },
        {
          "type": "text",
          "text": "Multiply the factor back through the bracket to verify the result."
        }
      ]
    },
    {
      "stable_key": "common-factor-example",
      "position": 2,
      "type": "worked_example",
      "title": "Extract a common factor",
      "prompt": [
        {
          "type": "text",
          "text": "Factorise 14ab + 21a completely."
        }
      ],
      "steps": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "The greatest common factor is 7a."
            },
            {
              "type": "display_math",
              "latex": "14ab\\div7a=2b,\\qquad21a\\div7a=3"
            }
          ]
        },
        {
          "position": 2,
          "content": [
            {
              "type": "text",
              "text": "Place the common factor outside."
            },
            {
              "type": "display_math",
              "latex": "7a(2b+3)"
            }
          ]
        }
      ],
      "verification_note": "Expanding 7a(2b + 3) gives 14ab + 21a."
    },
    {
      "stable_key": "factorisation-recall",
      "position": 3,
      "type": "active_recall",
      "title": "Check your understanding",
      "prompt": [
        {
          "type": "text",
          "text": "Factorise 10x + 15 completely."
        }
      ],
      "response": {
        "type": "algebraic_expression",
        "comparison_mode": "symbolic_equivalence",
        "canonical_expression": "5(2x+3)",
        "canonical_latex": "5(2x+3)",
        "variables": [
          "x"
        ],
        "domain_constraints": [],
        "accepted_equivalents": [],
        "checker_config": {}
      },
      "feedback": [
        {
          "type": "text",
          "text": "The greatest common factor is 5, so divide both terms by 5 inside the bracket."
        }
      ]
    },
