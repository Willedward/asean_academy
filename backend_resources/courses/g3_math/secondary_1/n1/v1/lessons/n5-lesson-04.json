  "position": 4,
  "status": "draft",
  "title": "Translation of simple real-world situations into algebraic expressions",
  "summary": "Translate practical rules and sequential events into algebraic models.",
  "outcomes": [
    "5.4"
  ],
  "prerequisite_lessons": [
    "n5-lesson-03"
  ],
  "estimated_minutes": 35,
  "objectives": [
    "Identify fixed and variable parts of a situation.",
    "Build an expression in the same order as the described events."
  ],
  "mastery_policy_key": "n5-default-v1",
  "sections": [
    {
      "stable_key": "modelling-order",
      "position": 1,
      "type": "explanation",
      "title": "Build a model in stages",
      "blocks": [
        {
          "type": "text",
          "text": "Identify fixed amounts, amounts per item, totals and equal sharing. Follow events in their stated order."
        },
        {
          "type": "display_math",
          "latex": "\\text{fixed charge}+\\text{rate}\\times\\text{quantity}"
        },
        {
          "type": "text",
          "text": "Use brackets before applying a percentage, multiplier or division to a whole total."
        }
      ]
    },
    {
      "stable_key": "shared-cost-example",
      "position": 2,
      "type": "worked_example",
      "title": "Model a shared cost",
      "prompt": [
        {
          "type": "text",
          "text": "A meal costs c dollars before a $12 delivery fee. The total is shared by n people."
        }
      ],
      "steps": [
        {
          "position": 1,
          "content": [
            {
              "type": "text",
              "text": "Add the delivery fee to the meal cost."
            },
            {
              "type": "display_math",
              "latex": "c+12"
            }
          ]
        },
        {
          "position": 2,
          "content": [
            {
              "type": "text",
              "text": "Divide the whole total equally."
            },
            {
              "type": "display_math",
              "latex": "\\frac{c+12}{n}"
            }
          ]
        }
      ],
      "verification_note": "Multiplying the share by n reconstructs the full cost c + 12."
    },
    {
      "stable_key": "modelling-recall",
      "position": 3,
      "type": "active_recall",
      "title": "Check your understanding",
      "prompt": [
        {
          "type": "text",
          "text": "A bus fare is $2.50 plus $0.80 per kilometre. Write the fare for d kilometres."
        }
      ],
      "response": {
        "type": "algebraic_expression",
        "comparison_mode": "symbolic_equivalence",
        "canonical_expression": "2.5+0.8d",
        "canonical_latex": "2.5+0.8d",
        "variables": [
          "d"
        ],
        "domain_constraints": [],
        "accepted_equivalents": [],
        "checker_config": {}
      },
      "feedback": [
        {
          "type": "text",
          "text": "The fixed fare is 2.50 and the distance charge is 0.8d."
        }
      ]
    },
    {
      "stable_key": "n5-lesson-04-summary",
      "position": 4,
      "type": "summary",
      "title": "Method checklist",
      "blocks": [
        {
          "type": "text",
          "text": "Separate fixed and variable quantities, follow events in order, and bracket any total acted on as a whole."
        }
      ]
    }
  ],
