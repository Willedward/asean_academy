# Server-only learning API target used by the authenticated /api/v1 gateway.
LEARNING_API_URL=http://127.0.0.1:8000

# Use only for UI work when the API is not running.
NEXT_PUBLIC_USE_API_FIXTURES=false

# Public URL of this Next.js deployment. Required in hosted environments so
# Google returns to the exact allow-listed callback URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public Supabase Auth configuration. These are safe browser values; never put
# a service-role key or database password in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
